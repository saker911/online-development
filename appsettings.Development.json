{
  "App": {
    "Urls": "http://localhost:5001",
    "Edition": "OnlineDevelopment"
  },
  "Data": {
    "Provider": "Sqlite"
  },
  "DevelopmentUseLocalData": true,
  "Bootstrap": {
    "AllowWebInitialSetup": true
  },
  "OnlineEdition": {
    "PrivacyMinimized": true,
    "CollectNationalId": false,
    "SimplifiedVisits": true,
    "CompletedVisitPersonalDataRetentionDays": 180,
    "ArchivedPermitPersonalDataRetentionDays": 365,
    "InactivePersonPhotoRetentionDays": 30,
    "SecurityIpRetentionDays": 90
  },
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=online-development.db"
  },
  "Security": {
    "CookieSecurePolicy": "SameAsRequest"
  }
}
