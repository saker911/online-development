{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": ""
  },
  "Data": {
    "Provider": "Sqlite"
  },
  "DevelopmentUseLocalData": false,
  "Administration": {
    "OrganizationName": "",
    "DepartmentName": "",
    "Address": "",
    "Phone": "",
    "ManagerName": "",
    "ManagerTitle": "",
    "SignatureText": "",
    "LogoPath": ""
  },
  "Backup": {
    "Enabled": true,
    "RetentionDays": 30,
    "AutoBackupHour": 2
  },
  "Security": {
    "CookieSecurePolicy": "SameAsRequest"
  },
  "UploadSecurity": {
    "Antivirus": {
      "Enabled": false,
      "Required": false,
      "Host": "127.0.0.1",
      "Port": 3310,
      "TimeoutSeconds": 30,
      "MaxScanBytes": 104857600
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "127.0.0.1"
    ]
  },
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=vehicle-permit-system.db",
    "PostgreSqlConnection": "",
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=VehiclePermitSystemWeb;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
