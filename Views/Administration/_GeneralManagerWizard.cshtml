                                                                            <div class="manager-handover-summary-item">
                                                                                <span>إجراء المدير السابق</span>
                                                                                <strong data-general-manager-summary="previousAction">@(hasCurrentGeneralManager ?
                                                                                                                                                                                                                selectedPreviousActionLabel : "لا يوجد مدير عام سابق")</strong>
