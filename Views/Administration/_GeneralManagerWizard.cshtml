                                                                                data-general-manager-summary="candidate">@(string.Equals(Model.GeneralManagerAssignment.SelectionMode,
                                                                                                                                                                                                        GeneralManagerSelectionModes.CreateNew, StringComparison.OrdinalIgnoreCase) ?
                                                                                                                                                                                                        selectedNewCandidateLabel : selectedCandidateLabel)</strong>
