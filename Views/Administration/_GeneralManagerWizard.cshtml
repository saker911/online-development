                                                <script nonce="@(Context.Items["CspScriptNonce"])">
                                                    document.addEventListener("DOMContentLoaded", function () {
                                                        const candidateMap = @Html.Raw(candidateMapJson);
                                                        const openButton = document.getElementById("openGeneralManagerWizardButton");
                                                        const confirmModalElement = document.getElementById("generalManagerReplaceConfirmModal");
                                                        const wizardModalElement = document.getElementById("generalManagerWizardModal");
                                                        const wizardForm = document.getElementById("generalManagerWizardForm");
                                                        const confirmOpenWizardButton = document.getElementById("confirmOpenGeneralManagerWizardButton");
                                                        const selectionModeInput = document.getElementById("GeneralManagerAssignment_SelectionMode");
                                                        const assignmentTypeInput = document.getElementById("GeneralManagerAssignment_AssignmentType");
                                                        const wizardStepInput = document.getElementById("GeneralManagerAssignment_WizardStep");
                                                        const existingUserSelect = document.getElementById("GeneralManagerAssignment_ExistingUserUsername");
                                                        const existingUserPicker = document.getElementById("generalManagerExistingUserPicker");
                                                        const existingUserSearchInput = document.getElementById("GeneralManagerAssignment_ExistingUserUsernameSearch");
                                                        const existingUserPickerToggle = document.getElementById("generalManagerExistingUserPickerToggle");
                                                        const existingUserPickerClear = document.getElementById("generalManagerExistingUserPickerClear");
                                                        const existingUserPickerPanel = document.getElementById("generalManagerExistingUserPickerPanel");
                                                        const existingUserPickerEmpty = document.getElementById("generalManagerExistingUserPickerEmpty");
                                                        const existingUserPickerOptions = Array.from(document.querySelectorAll("[data-general-manager-user-option='true']"));
                                                        const newUserUsernameInput = document.getElementById("GeneralManagerAssignment_NewUserUsername");
                                                        const newUserFullNameInput = document.getElementById("GeneralManagerAssignment_NewUserFullName");
                                                        const newUserPhoneInput = document.getElementById("GeneralManagerAssignment_NewUserPhoneNumber");
                                                        const newUserPasswordInput = document.getElementById("GeneralManagerAssignment_NewUserPassword");
                                                        const newUserConfirmPasswordInput = document.getElementById("GeneralManagerAssignment_NewUserConfirmPassword");
                                                        const newUserJobTitleInput = document.getElementById("GeneralManagerAssignment_NewUserJobTitle");
                                                        const newUserDepartmentSelect = document.getElementById("GeneralManagerAssignment_NewUserDepartmentId");
                                                        const previousActionSelect = document.getElementById("GeneralManagerAssignment_PreviousGeneralManagerAction");
                                                        const previousDepartmentSelect = document.getElementById("GeneralManagerAssignment_PreviousGeneralManagerTargetDepartmentId");
                                                        const existingFields = document.getElementById("generalManagerExistingUserFields");
                                                        const createFields = document.getElementById("generalManagerCreateUserFields");
                                                        const internalTransferFields = document.getElementById("generalManagerInternalTransferFields");
                                                        const previousButton = document.getElementById("generalManagerWizardPreviousButton");
                                                        const nextButton = document.getElementById("generalManagerWizardNextButton");
                                                        const submitButton = document.getElementById("generalManagerWizardSubmitButton");
                                                        const stepPanels = Array.from(document.querySelectorAll("[data-general-manager-step-panel]"));
                                                        const stepIndicators = Array.from(document.querySelectorAll("[data-general-manager-step-indicator]"));
                                                        const selectionButtons = Array.from(document.querySelectorAll("[data-general-manager-selection]"));
                                                        const assignmentButtons = Array.from(document.querySelectorAll("[data-general-manager-assignment-type]"));
                                                        const changesList = document.getElementById("generalManagerWizardChangesList");
                                                        const summaryCandidate = document.querySelector('[data-general-manager-summary="candidate"]');
                                                        const summarySelectionMode = document.querySelector('[data-general-manager-summary="selectionMode"]');
                                                        const summaryAssignmentType = document.querySelector('[data-general-manager-summary="assignmentType"]');
                                                        const summaryPreviousAction = document.querySelector('[data-general-manager-summary="previousAction"]');
                                                        const hasCurrentGeneralManager = @hasCurrentGeneralManager.ToString().ToLowerInvariant();
                                                        const initialWizardStep = @selectedWizardStep;
                                                        const shouldResumeWizardState = @shouldResumeWizardState.ToString().ToLowerInvariant();
                                                        let currentStep = initialWizardStep;
                                                        let existingUserActiveIndex = -1;

                                                        if (!wizardModalElement || !selectionModeInput || !assignmentTypeInput) {
                                                            return;
                                                        }

                                                        if (wizardModalElement.parentElement !== document.body) {
                                                            document.body.appendChild(wizardModalElement);
                                                        }

                                                        if (confirmModalElement && confirmModalElement.parentElement !== document.body) {
                                                            document.body.appendChild(confirmModalElement);
                                                        }

                                                        const wizardModal = window.bootstrap ? bootstrap.Modal.getOrCreateInstance(wizardModalElement) : null;
                                                        const confirmModal = confirmModalElement && window.bootstrap
                                                            ? bootstrap.Modal.getOrCreateInstance(confirmModalElement)
                                                            : null;

                                                        function getVisibleValidationField(field) {
                                                            if (!field) {
                                                                return null;
                                                            }

                                                            if (field.matches && field.matches("select[data-general-manager-picker='true']")) {
                                                                const inputId = field.dataset.generalManagerPickerInputId;
                                                                return inputId ? document.getElementById(inputId) : field;
                                                            }

                                                            if (field.matches && field.matches("select[data-smart-select='true']")) {
                                                                const wrapper = field.closest("[data-smart-select-wrapper='true']");
                                                                return wrapper ? wrapper.querySelector(".smart-select-input") : field;
                                                            }

                                                            return field;
                                                        }

                                                        function getFieldMessageHost(field) {
                                                            if (!field || !field.parentElement) {
                                                                return null;
                                                            }

                                                            return field.parentElement.querySelector(".field-validation-error, .field-validation-valid");
                                                        }

                                                        function clearValidationState(field) {
                                                            const target = getVisibleValidationField(field);
                                                            const messageHost = getFieldMessageHost(field);
                                                            if (!target) {
                                                                return;
                                                            }

                                                            if (typeof target.setCustomValidity === "function") {
                                                                target.setCustomValidity("");
                                                            }

                                                            target.classList.remove("is-invalid");
                                                            target.removeAttribute("aria-invalid");

                                                            if (messageHost) {
                                                                messageHost.textContent = "";
                                                            }
                                                        }

                                                        function showValidationState(field, message) {
                                                            const target = getVisibleValidationField(field);
                                                            const messageHost = getFieldMessageHost(field);
                                                            if (!target) {
                                                                return false;
                                                            }

                                                            if (typeof target.setCustomValidity === "function") {
                                                                target.setCustomValidity(message);
                                                            }

                                                            target.classList.add("is-invalid");
                                                            target.setAttribute("aria-invalid", "true");

                                                            if (messageHost) {
                                                                messageHost.textContent = message;
                                                            }

                                                            if (typeof target.focus === "function") {
                                                                target.focus();
                                                            }

                                                            if (target === field && typeof target.reportValidity === "function") {
                                                                target.reportValidity();
                                                            }

                                                            return false;
                                                        }

                                                        function toggleVisibility(element, isVisible) {
                                                            if (!element) {
                                                                return;
                                                            }

                                                            element.hidden = !isVisible;
                                                        }

                                                        function normalizeExistingUserPickerText(value) {
                                                            return (value || "").trim().replace(/\s+/g, " ").toLowerCase();
                                                        }

                                                        function getExistingUserPickerLabel(option) {
                                                            return (option?.dataset.label || "").trim();
                                                        }

                                                        function getExistingUserPickerVisibleOptions() {
                                                            return existingUserPickerOptions.filter(function (option) {
                                                                return !option.hidden;
                                                            });
                                                        }

                                                        function setExistingUserPickerOpen(isOpen) {
                                                            if (!existingUserPicker || !existingUserPickerPanel || !existingUserSearchInput) {
                                                                return;
                                                            }

                                                            existingUserPicker.classList.toggle("is-open", isOpen);
                                                            existingUserPickerPanel.hidden = !isOpen;
                                                            existingUserSearchInput.setAttribute("aria-expanded", isOpen ? "true" : "false");
                                                        }

                                                        function setExistingUserPickerActiveOption(option) {
                                                            existingUserPickerOptions.forEach(function (item) {
                                                                item.classList.remove("is-active");
                                                            });

                                                            if (!option || option.hidden) {
                                                                existingUserActiveIndex = -1;
                                                                existingUserSearchInput?.removeAttribute("aria-activedescendant");
                                                                return;
                                                            }

                                                            option.classList.add("is-active");
                                                            existingUserActiveIndex = existingUserPickerOptions.indexOf(option);
                                                            if (existingUserSearchInput) {
                                                                if (!option.id) {
                                                                    option.id = `general-manager-user-option-${existingUserActiveIndex}`;
                                                                }
                                                                existingUserSearchInput.setAttribute("aria-activedescendant", option.id);
                                                            }
                                                            option.scrollIntoView({ block: "nearest" });
                                                        }

                                                        function syncExistingUserPickerSelectionState() {
                                                            const selectedValue = existingUserSelect ? existingUserSelect.value : "";
                                                            let selectedOption = null;

                                                            existingUserPickerOptions.forEach(function (option) {
                                                                const isSelected = !!selectedValue && option.dataset.value === selectedValue;
                                                                option.classList.toggle("is-selected", isSelected);
                                                                option.setAttribute("aria-selected", isSelected ? "true" : "false");
                                                                if (isSelected) {
                                                                    selectedOption = option;
                                                                }
                                                            });

                                                            if (existingUserPickerClear) {
                                                                existingUserPickerClear.hidden = !selectedValue && !(existingUserSearchInput && existingUserSearchInput.value.trim());
                                                            }

                                                            return selectedOption;
                                                        }

                                                        function dispatchExistingUserSelectionChange() {
                                                            if (!existingUserSelect) {
                                                                return;
                                                            }

                                                            existingUserSelect.dispatchEvent(new Event("input", { bubbles: true }));
                                                            existingUserSelect.dispatchEvent(new Event("change", { bubbles: true }));
                                                        }

                                                        function commitExistingUserSelection(option) {
                                                            if (!existingUserSelect || !existingUserSearchInput || !option) {
                                                                return;
                                                            }

                                                            existingUserSelect.value = option.dataset.value || "";
                                                            existingUserSearchInput.value = getExistingUserPickerLabel(option);
                                                            clearValidationState(existingUserSelect);
                                                            syncExistingUserPickerSelectionState();
                                                            setExistingUserPickerActiveOption(option);
                                                            dispatchExistingUserSelectionChange();
                                                            setExistingUserPickerOpen(false);
                                                        }

                                                        function clearExistingUserSelection(keepTypedValue) {
                                                            if (!existingUserSelect || !existingUserSearchInput) {
                                                                return;
                                                            }

                                                            const selectionChanged = !!existingUserSelect.value;
                                                            existingUserSelect.value = "";
                                                            if (!keepTypedValue) {
                                                                existingUserSearchInput.value = "";
                                                            }
                                                            syncExistingUserPickerSelectionState();
                                                            setExistingUserPickerActiveOption(null);

                                                            if (selectionChanged) {
                                                                dispatchExistingUserSelectionChange();
                                                            }
                                                        }

                                                        function filterExistingUserPickerOptions(query) {
                                                            const needle = normalizeExistingUserPickerText(query);
                                                            let firstVisibleOption = null;

                                                            existingUserPickerOptions.forEach(function (option) {
                                                                const haystack = normalizeExistingUserPickerText(option.dataset.search || getExistingUserPickerLabel(option));
                                                                const matches = !needle || haystack.includes(needle);
                                                                option.hidden = !matches;
                                                                if (matches && !firstVisibleOption) {
                                                                    firstVisibleOption = option;
                                                                }
                                                            });

                                                            if (existingUserPickerEmpty) {
                                                                existingUserPickerEmpty.hidden = !!firstVisibleOption;
                                                            }

                                                            setExistingUserPickerActiveOption(firstVisibleOption);
                                                        }

                                                        function syncExistingUserPickerFromSelection() {
                                                            const selectedOption = syncExistingUserPickerSelectionState();
                                                            if (existingUserSearchInput && selectedOption) {
                                                                existingUserSearchInput.value = getExistingUserPickerLabel(selectedOption);
                                                            }
                                                        }

                                                        function isStrongPassword(value) {
                                                            return value.length >= 8
                                                                && /[A-Z]/.test(value)
                                                                && /[a-z]/.test(value)
                                                                && /\d/.test(value)
                                                                && /[^A-Za-z0-9]/.test(value);
                                                        }

                                                        function getSelectionModeLabel() {
                                                            return selectionModeInput.value === "@GeneralManagerSelectionModes.CreateNew"
                                                                ? "إنشاء مدير عام جديد"
                                                                : "اختيار مستخدم موجود";
                                                        }

                                                        function getAssignmentTypeLabel() {
                                                            return assignmentTypeInput.value === "@GeneralManagerAssignmentTypes.Acting"
                                                                ? "مكلف"
                                                                : "مثبت";
                                                        }

                                                        function getPreviousActionLabel() {
                                                            if (!hasCurrentGeneralManager) {
                                                                return "لا يوجد مدير عام سابق";
                                                            }

                                                            return previousActionSelect
                                                                ? previousActionSelect.options[previousActionSelect.selectedIndex]?.text || "إنهاء تكليف"
                                                                : "إنهاء تكليف";
                                                        }

                                                        function getSelectedCandidateLabel() {
                                                            if (selectionModeInput.value === "@GeneralManagerSelectionModes.CreateNew") {
                                                                const fullName = newUserFullNameInput ? newUserFullNameInput.value.trim() : "";
                                                                const username = newUserUsernameInput ? newUserUsernameInput.value.trim() : "";
                                                                if (!fullName && !username) {
                                                                    return "لم يحدد بعد";
                                                                }

                                                                return fullName
                                                                    ? (username ? `${fullName} (${username})` : fullName)
                                                                    : username;
                                                            }

                                                            if (!existingUserSelect || !existingUserSelect.value) {
                                                                return "لم يحدد بعد";
                                                            }

                                                            const selectedCandidate = candidateMap[existingUserSelect.value];
                                                            if (!selectedCandidate) {
                                                                return existingUserSelect.value;
                                                            }

                                                            return `${selectedCandidate.fullName} (${selectedCandidate.username})`;
                                                        }

                                                        function renderExistingCandidateDetails() {
                                                            const selectedUsername = existingUserSelect ? existingUserSelect.value : "";
                                                            const candidate = selectedUsername ? candidateMap[selectedUsername] : null;
                                                            const fallback = {
                                                                fullName: "غير محدد",
                                                                username: "غير محدد",
                                                                phoneNumber: "غير محدد",
                                                                jobTitle: "غير محدد",
                                                                department: "بدون قسم",
                                                                status: "غير محدد"
                                                            };

                                                            ["fullName", "username", "phoneNumber", "jobTitle", "department", "status"].forEach(function (key) {
                                                                const target = document.querySelector(`[data-general-manager-existing-detail='${key}']`);
                                                                if (!target) {
                                                                    return;
                                                                }

                                                                target.textContent = candidate ? (candidate[key] || fallback[key]) : fallback[key];
                                                            });
                                                        }

                                                        function syncSelectionModeState() {
                                                            const createNew = selectionModeInput.value === "@GeneralManagerSelectionModes.CreateNew";

                                                            toggleVisibility(existingFields, !createNew);
                                                            toggleVisibility(createFields, createNew);

                                                            if (createNew) {
                                                                setExistingUserPickerOpen(false);
                                                            }

                                                            if (existingUserSelect) {
                                                                existingUserSelect.required = !createNew;
                                                                if (createNew) {
                                                                    clearValidationState(existingUserSelect);
                                                                }
                                                            }

                                                            [newUserUsernameInput, newUserFullNameInput, newUserPhoneInput, newUserPasswordInput, newUserConfirmPasswordInput, newUserJobTitleInput].forEach(function (field) {
                                                                if (!field) {
                                                                    return;
                                                                }

                                                                field.required = createNew;
                                                                if (!createNew) {
                                                                    clearValidationState(field);
                                                                }
                                                            });

                                                            if (newUserDepartmentSelect) {
                                                                newUserDepartmentSelect.required = false;
                                                                newUserDepartmentSelect.value = "0";
                                                                clearValidationState(newUserDepartmentSelect);
                                                            }

                                                            selectionButtons.forEach(function (button) {
                                                                button.classList.toggle("is-active", button.dataset.generalManagerSelection === selectionModeInput.value);
                                                            });

                                                            renderExistingCandidateDetails();
                                                            syncSummary();
                                                        }

                                                        function syncPreviousActionState() {
                                                            const isInternalTransfer = hasCurrentGeneralManager
                                                                && previousActionSelect
                                                                && previousActionSelect.value === "@GeneralManagerPreviousActions.InternalTransfer";

                                                            toggleVisibility(internalTransferFields, isInternalTransfer);
                                                            if (previousDepartmentSelect) {
                                                                previousDepartmentSelect.required = !!isInternalTransfer;
                                                                if (!isInternalTransfer) {
                                                                    clearValidationState(previousDepartmentSelect);
                                                                }
                                                            }

                                                            syncSummary();
                                                        }

                                                        function syncAssignmentTypeState() {
                                                            assignmentButtons.forEach(function (button) {
                                                                button.classList.toggle("is-active", button.dataset.generalManagerAssignmentType === assignmentTypeInput.value);
                                                            });

                                                            syncSummary();
                                                        }

                                                        function syncSummary() {
                                                            if (summaryCandidate) {
                                                                summaryCandidate.textContent = getSelectedCandidateLabel();
                                                            }

                                                            if (summarySelectionMode) {
                                                                summarySelectionMode.textContent = getSelectionModeLabel();
                                                            }

                                                            if (summaryAssignmentType) {
                                                                summaryAssignmentType.textContent = getAssignmentTypeLabel();
                                                            }

                                                            if (summaryPreviousAction) {
                                                                summaryPreviousAction.textContent = getPreviousActionLabel();
                                                            }

                                                            if (changesList) {
                                                                const changes = [];
                                                                if (selectionModeInput.value === "@GeneralManagerSelectionModes.CreateNew") {
                                                                    changes.push("سيتم استكمال حساب مدير عام جديد من هذا المعالج ثم اعتماده مباشرة، مع بقاء شاشة المستخدمين هي المسار الأساسي لإنشاء الحسابات.");
                                                                } else {
                                                                    changes.push("سيُستخدم الحساب المختار ويُعاد تشكيل صلاحياته ليصبح مديرًا عامًا مرتبطًا بالإدارة.");
                                                                }

                                                                changes.push("سيتم ربط الإدارة تلقائيًا بالحساب الجديد مع مزامنة الاسم والمسمى والجوال.");
                                                                changes.push(`سيشغل المنصب بصفة ${getAssignmentTypeLabel()}.`);

                                                                if (hasCurrentGeneralManager) {
                                                                    changes.push(`سيتم تطبيق إجراء المدير العام السابق: ${getPreviousActionLabel()}.`);
                                                                    if (
                                                                        previousActionSelect
                                                                        && previousActionSelect.value === "@GeneralManagerPreviousActions.InternalTransfer"
                                                                        && previousDepartmentSelect
                                                                        && previousDepartmentSelect.value !== "0"
                                                                    ) {
                                                                        const targetDepartmentName = previousDepartmentSelect.options[previousDepartmentSelect.selectedIndex]?.text || "القسم المحدد";
                                                                        changes.push(`سيُنقل المدير العام السابق إلى قسم ${targetDepartmentName}.`);
                                                                    }
                                                                } else {
                                                                    changes.push("لا يوجد مدير عام سابق، لذا لن تُطبق إجراءات سحب أو أرشفة على حساب سابق.");
                                                                }

                                                                changesList.innerHTML = changes.map(change => `<li>${change}</li>`).join("");
                                                            }
                                                        }

                                                        function setStep(step) {
                                                            currentStep = Math.min(5, Math.max(1, step));

                                                            stepPanels.forEach(function (panel) {
                                                                const panelStep = Number(panel.dataset.generalManagerStepPanel || "1");
                                                                panel.hidden = panelStep !== currentStep;
                                                            });

                                                            stepIndicators.forEach(function (indicator) {
                                                                const indicatorStep = Number(indicator.dataset.generalManagerStepIndicator || "1");
                                                                indicator.classList.toggle("is-active", indicatorStep === currentStep);
                                                                indicator.classList.toggle("is-complete", indicatorStep < currentStep);
                                                            });

                                                            if (wizardStepInput) {
                                                                wizardStepInput.value = String(currentStep);
                                                            }

                                                            if (previousButton) {
                                                                previousButton.hidden = currentStep === 1;
                                                            }

                                                            if (nextButton) {
                                                                nextButton.hidden = currentStep >= 5;
                                                            }

                                                            if (submitButton) {
                                                                submitButton.hidden = currentStep !== 5;
                                                            }

                                                            syncSummary();
                                                        }

                                                        function resetWizardProgress() {
                                                            setStep(1);
                                                        }

                                                        function validateStep(step) {
                                                            if (step === 1) {
                                                                return true;
                                                            }

                                                            if (step === 2) {
                                                                if (selectionModeInput.value === "@GeneralManagerSelectionModes.ExistingUser") {
                                                                    if (!existingUserSelect || !existingUserSelect.value.trim()) {
                                                                        return showValidationState(existingUserSelect, "اختر المستخدم المرشح لتولي منصب المدير العام.");
                                                                    }

                                                                    return true;
                                                                }

                                                                if (!newUserUsernameInput || !/^[12]\d{9}$/.test(newUserUsernameInput.value.trim())) {
                                                                    return showValidationState(newUserUsernameInput, "المعرف الداخلي يجب أن يكون 10 أرقام ويبدأ بـ 1 أو 2.");
                                                                }

                                                                if (!newUserFullNameInput || !newUserFullNameInput.value.trim()) {
                                                                    return showValidationState(newUserFullNameInput, "الاسم الكامل مطلوب.");
                                                                }

                                                                if (!newUserPhoneInput || !/^05\d{8}$/.test(newUserPhoneInput.value.trim())) {
                                                                    return showValidationState(newUserPhoneInput, "رقم الجوال يجب أن يكون 10 أرقام ويبدأ بـ 05.");
                                                                }

                                                                if (!newUserPasswordInput || !isStrongPassword(newUserPasswordInput.value)) {
                                                                    return showValidationState(newUserPasswordInput, "كلمة المرور يجب أن تكون 8 أحرف على الأقل وتحتوي على حرف كبير وحرف صغير ورقم ورمز خاص.");
                                                                }

                                                                if (!newUserConfirmPasswordInput || newUserConfirmPasswordInput.value !== newUserPasswordInput.value) {
                                                                    return showValidationState(newUserConfirmPasswordInput, "تأكيد كلمة المرور غير مطابق.");
                                                                }

                                                                if (!newUserJobTitleInput || !newUserJobTitleInput.value.trim()) {
                                                                    return showValidationState(newUserJobTitleInput, "المسمى الوظيفي مطلوب.");
                                                                }

                                                                return true;
                                                            }

                                                            if (step === 3 && hasCurrentGeneralManager) {
                                                                if (
                                                                    previousActionSelect
                                                                    && previousActionSelect.value === "@GeneralManagerPreviousActions.InternalTransfer"
                                                                    && previousDepartmentSelect
                                                                    && previousDepartmentSelect.value === "0"
                                                                ) {
                                                                    return showValidationState(previousDepartmentSelect, "اختر القسم الجديد للمدير العام السابق.");
                                                                }

                                                                return true;
                                                            }

                                                            return true;
                                                        }

                                                        if (openButton) {
                                                            openButton.addEventListener("click", function () {
                                                                if (!wizardModal) {
                                                                    return;
                                                                }

                                                                if (!shouldResumeWizardState) {
                                                                    resetWizardProgress();
                                                                }

                                                                if (hasCurrentGeneralManager && confirmModal) {
                                                                    confirmModal.show();
                                                                    return;
                                                                }

                                                                wizardModal.show();
                                                            });
                                                        }

                                                        if (confirmOpenWizardButton) {
                                                            confirmOpenWizardButton.addEventListener("click", function () {
                                                                if (confirmModal) {
                                                                    confirmModal.hide();
                                                                }

                                                                if (wizardModal) {
                                                                    if (!shouldResumeWizardState) {
                                                                        resetWizardProgress();
                                                                    }
                                                                    wizardModal.show();
                                                                }
                                                            });
                                                        }

                                                        if (wizardModalElement) {
                                                            wizardModalElement.addEventListener("hidden.bs.modal", function () {
                                                                if (!shouldResumeWizardState) {
                                                                    resetWizardProgress();
                                                                }
                                                            });
                                                        }

                                                        if (confirmModalElement) {
                                                            confirmModalElement.addEventListener("hidden.bs.modal", function () {
                                                                if (!wizardModalElement?.classList.contains("show") && !shouldResumeWizardState) {
                                                                    resetWizardProgress();
                                                                }
                                                            });
                                                        }

                                                        selectionButtons.forEach(function (button) {
                                                            button.addEventListener("click", function () {
                                                                selectionModeInput.value = button.dataset.generalManagerSelection || selectionModeInput.value;
                                                                syncSelectionModeState();
                                                            });
                                                        });

                                                        existingUserPickerOptions.forEach(function (option, index) {
                                                            if (!option.id) {
                                                                option.id = `general-manager-existing-user-option-${index}`;
                                                            }

                                                            option.addEventListener("click", function () {
                                                                commitExistingUserSelection(option);
                                                            });
                                                        });

                                                        if (existingUserSearchInput) {
                                                            existingUserSearchInput.addEventListener("focus", function () {
                                                                filterExistingUserPickerOptions(existingUserSearchInput.value);
                                                                setExistingUserPickerOpen(true);
                                                            });

                                                            existingUserSearchInput.addEventListener("click", function () {
                                                                filterExistingUserPickerOptions(existingUserSearchInput.value);
                                                                setExistingUserPickerOpen(true);
                                                            });

                                                            existingUserSearchInput.addEventListener("input", function () {
                                                                clearValidationState(existingUserSelect);
                                                                clearExistingUserSelection(true);
                                                                filterExistingUserPickerOptions(existingUserSearchInput.value);
                                                                setExistingUserPickerOpen(true);
                                                            });

                                                            existingUserSearchInput.addEventListener("keydown", function (event) {
                                                                const visibleOptions = getExistingUserPickerVisibleOptions();

                                                                if (event.key === "ArrowDown" || event.key === "ArrowUp") {
                                                                    event.preventDefault();
                                                                    if (existingUserPickerPanel?.hidden) {
                                                                        filterExistingUserPickerOptions(existingUserSearchInput.value);
                                                                        setExistingUserPickerOpen(true);
                                                                    }

                                                                    if (!visibleOptions.length) {
                                                                        return;
                                                                    }

                                                                    let nextIndex = visibleOptions.findIndex(function (option) {
                                                                        return option.classList.contains("is-active");
                                                                    });

                                                                    if (nextIndex === -1) {
                                                                        nextIndex = 0;
                                                                    } else {
                                                                        nextIndex = event.key === "ArrowDown"
                                                                            ? Math.min(nextIndex + 1, visibleOptions.length - 1)
                                                                            : Math.max(nextIndex - 1, 0);
                                                                    }

                                                                    setExistingUserPickerActiveOption(visibleOptions[nextIndex]);
                                                                    return;
                                                                }

                                                                if (event.key === "Enter") {
                                                                    if (existingUserPickerPanel?.hidden) {
                                                                        return;
                                                                    }

                                                                    event.preventDefault();
                                                                    const activeOption = existingUserPickerOptions[existingUserActiveIndex] || visibleOptions[0];
                                                                    if (activeOption) {
                                                                        commitExistingUserSelection(activeOption);
                                                                    }
                                                                    return;
                                                                }

                                                                if (event.key === "Escape") {
                                                                    if (!existingUserPickerPanel?.hidden) {
                                                                        event.preventDefault();
                                                                        setExistingUserPickerOpen(false);
                                                                    }
                                                                }
                                                            });
                                                        }

                                                        if (existingUserPickerToggle) {
                                                            existingUserPickerToggle.addEventListener("click", function (event) {
                                                                event.preventDefault();
                                                                if (existingUserPickerPanel?.hidden) {
                                                                    filterExistingUserPickerOptions(existingUserSearchInput ? existingUserSearchInput.value : "");
                                                                    setExistingUserPickerOpen(true);
                                                                    existingUserSearchInput?.focus();
                                                                    return;
                                                                }

                                                                setExistingUserPickerOpen(false);
                                                            });
                                                        }

                                                        if (existingUserPickerClear) {
                                                            existingUserPickerClear.addEventListener("click", function (event) {
                                                                event.preventDefault();
                                                                clearValidationState(existingUserSelect);
                                                                clearExistingUserSelection(false);
                                                                filterExistingUserPickerOptions("");
                                                                existingUserSearchInput?.focus();
                                                            });
                                                        }

                                                        document.addEventListener("click", function (event) {
                                                            if (!existingUserPicker || existingUserPicker.contains(event.target)) {
                                                                return;
                                                            }

                                                            setExistingUserPickerOpen(false);
                                                        });

                                                        assignmentButtons.forEach(function (button) {
                                                            button.addEventListener("click", function () {
                                                                assignmentTypeInput.value = button.dataset.generalManagerAssignmentType || assignmentTypeInput.value;
                                                                syncAssignmentTypeState();
                                                            });
                                                        });

                                                        [existingUserSelect, newUserUsernameInput, newUserFullNameInput, newUserPhoneInput, newUserPasswordInput, newUserConfirmPasswordInput, newUserJobTitleInput, newUserDepartmentSelect, previousActionSelect, previousDepartmentSelect].forEach(function (field) {
                                                            if (!field) {
                                                                return;
                                                            }

                                                            field.addEventListener("change", function () {
                                                                clearValidationState(field);
                                                                renderExistingCandidateDetails();
                                                                syncPreviousActionState();
                                                                syncSummary();
                                                            });

                                                            field.addEventListener("input", function () {
                                                                clearValidationState(field);
                                                                syncSummary();
                                                            });
                                                        });

                                                        stepIndicators.forEach(function (indicator) {
                                                            indicator.addEventListener("click", function () {
                                                                const targetStep = Number(indicator.dataset.generalManagerStepIndicator || currentStep);
                                                                if (targetStep <= currentStep || validateStep(currentStep)) {
                                                                    setStep(targetStep);
                                                                }
                                                            });
                                                        });

                                                        if (previousButton) {
                                                            previousButton.addEventListener("click", function () {
                                                                setStep(currentStep - 1);
                                                            });
                                                        }

                                                        if (nextButton) {
                                                            nextButton.addEventListener("click", function () {
                                                                if (!validateStep(currentStep)) {
                                                                    return;
                                                                }

                                                                setStep(currentStep + 1);
                                                            });
                                                        }

                                                        if (wizardForm) {
                                                            wizardForm.addEventListener("submit", function (event) {
                                                                if (!validateStep(4)) {
                                                                    event.preventDefault();
                                                                    return;
                                                                }

                                                                setStep(5);
                                                            });
                                                        }

                                                        syncSelectionModeState();
                                                        syncPreviousActionState();
                                                        syncAssignmentTypeState();
                                                        syncExistingUserPickerFromSelection();
                                                        filterExistingUserPickerOptions(existingUserSearchInput ? existingUserSearchInput.value : "");
                                                        setExistingUserPickerOpen(false);
                                                        renderExistingCandidateDetails();
                                                        setStep(currentStep);

                                                        if (shouldResumeWizardState && wizardModal) {
                                                            wizardModal.show();
                                                        }
                                                    });
                                                </script>
