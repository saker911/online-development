@using System.Text.Json
@using VehiclePermitSystemWeb.Models.DTOs
@using VehiclePermitSystemWeb.Models.Entities
@using VehiclePermitSystemWeb.Models.ViewModels.Account
@using VehiclePermitSystemWeb.Models.ViewModels.Backup
@using VehiclePermitSystemWeb.Models.ViewModels.Delegations
@using VehiclePermitSystemWeb.Models.ViewModels.Departments
@using VehiclePermitSystemWeb.Models.ViewModels.Display
@using VehiclePermitSystemWeb.Models.ViewModels.Permits
@using VehiclePermitSystemWeb.Models.ViewModels.Reports
@using VehiclePermitSystemWeb.Models.ViewModels.Scan
@using VehiclePermitSystemWeb.Models.ViewModels.Users
@using VehiclePermitSystemWeb.Models.ViewModels.Visits
@model VehiclePermitSystemWeb.Models.ViewModels.Departments.DepartmentManagementViewModel

@{
    var openGeneralManagerWizard = (ViewData["OpenGeneralManagerWizard"] as bool?) == true;
    var hasCurrentGeneralManager = !string.IsNullOrWhiteSpace(Model.CurrentGeneralManagerUsername);
    var currentGeneralManagerDisplay = string.IsNullOrWhiteSpace(Model.CurrentGeneralManagerName)
        ? "لا يوجد مدير عام حاليًا"
        : Model.CurrentGeneralManagerName;
    var selectedWizardStep = Model.GeneralManagerAssignment.WizardStep < 1
        ? 1
        : Model.GeneralManagerAssignment.WizardStep > 5
            ? 5
            : Model.GeneralManagerAssignment.WizardStep;
    var shouldResumeWizardState = openGeneralManagerWizard;
    var selectedExistingUser = Model.GeneralManagerCandidateOptions.FirstOrDefault(user =>
        string.Equals(
            user.Username,
            Model.GeneralManagerAssignment.ExistingUserUsername,
            StringComparison.OrdinalIgnoreCase
        )
    );
    var selectedExistingUserDepartment = string.IsNullOrWhiteSpace(selectedExistingUser?.Department)
        ? "بدون قسم"
        : selectedExistingUser!.Department;
    var selectedNewUserDepartmentName = Model.Departments.FirstOrDefault(department =>
        department.Id == Model.GeneralManagerAssignment.NewUserDepartmentId
    )?.Name ?? "غير محدد";
    var selectionModeOptions = new[]
    {
        new
        {
            Value = GeneralManagerSelectionModes.ExistingUser,
            Label = "اختيار مستخدم موجود",
            Description = "استخدم حسابًا موجودًا في النظام ليصبح هو المدير العام الجديد بعد التنفيذ.",
        },
        new
        {
            Value = GeneralManagerSelectionModes.CreateNew,
            Label = "إنشاء مدير عام جديد",
            Description = "يمكن استكمال حساب المدير العام من هنا عند الحاجة، مع بقاء شاشة المستخدمين هي المسار الأساسي لإنشاء الحسابات.",
        },
    };
    var previousActionOptions = new[]
    {
        new { Value = GeneralManagerPreviousActions.EndAssignment, Label = "إنهاء تكليف" },
        new { Value = GeneralManagerPreviousActions.InternalTransfer, Label = "نقل داخلي" },
        new { Value = GeneralManagerPreviousActions.ExternalTransfer, Label = "نقل خارجي" },
        new { Value = GeneralManagerPreviousActions.Retirement, Label = "تقاعد" },
        new { Value = GeneralManagerPreviousActions.Resignation, Label = "استقالة" },
        new { Value = GeneralManagerPreviousActions.Archive, Label = "أرشفة" },
        new { Value = GeneralManagerPreviousActions.ReturnToEmployee, Label = "العودة لوظيفة موظف" },
    };
    var assignmentTypeOptions = new[]
    {
        new
        {
            Value = GeneralManagerAssignmentTypes.Permanent,
            Label = "مثبت",
            Description = "يعتمد كمدير عام رسمي مرتبط بالإدارة بشكل دائم.",
        },
        new
        {
            Value = GeneralManagerAssignmentTypes.Acting,
            Label = "مكلف",
            Description = "يسجل كمدير عام مكلف بصيغة تكليف مع نفس الربط الآلي للإدارة.",
        },
    };
    var selectedSelectionModeLabel = selectionModeOptions
        .FirstOrDefault(option =>
            string.Equals(
                option.Value,
                Model.GeneralManagerAssignment.SelectionMode,
                StringComparison.OrdinalIgnoreCase
            )
        )?.Label ?? "اختيار مستخدم موجود";
    var selectedPreviousActionLabel = previousActionOptions
        .FirstOrDefault(option =>
            string.Equals(
                option.Value,
                Model.GeneralManagerAssignment.PreviousGeneralManagerAction,
                StringComparison.OrdinalIgnoreCase
            )
        )?.Label ?? "إنهاء تكليف";
    var selectedAssignmentTypeLabel = assignmentTypeOptions
        .FirstOrDefault(option =>
            string.Equals(
                option.Value,
                Model.GeneralManagerAssignment.AssignmentType,
                StringComparison.OrdinalIgnoreCase
            )
        )?.Label ?? "مثبت";
    var selectedCandidateLabel = selectedExistingUser == null
        ? "لم يحدد بعد"
        : $"{selectedExistingUser.DisplayName} ({selectedExistingUser.Username})";
    var selectedExistingUserSearchLabel = selectedExistingUser == null
        ? string.Empty
        : $"{selectedExistingUser.DisplayName} ({selectedExistingUser.Username}) - {selectedExistingUserDepartment} - {(selectedExistingUser.IsActive ? "نشط" : "موقوف")}";
    var selectedNewCandidateLabel = string.IsNullOrWhiteSpace(Model.GeneralManagerAssignment.NewUserFullName)
        ? (string.IsNullOrWhiteSpace(Model.GeneralManagerAssignment.NewUserUsername)
            ? "لم يحدد بعد"
            : Model.GeneralManagerAssignment.NewUserUsername)
        : $"{Model.GeneralManagerAssignment.NewUserFullName} ({Model.GeneralManagerAssignment.NewUserUsername})";
    var candidateMapJson = JsonSerializer.Serialize(
        Model.GeneralManagerCandidateOptions.ToDictionary(
            user => user.Username,
            user => new
            {
                username = user.Username,
                fullName = user.DisplayName,
                phoneNumber = user.PhoneNumber,
                jobTitle = string.IsNullOrWhiteSpace(user.JobTitle) ? "غير محدد" : user.JobTitle,
                department = string.IsNullOrWhiteSpace(user.Department) ? "بدون قسم" : user.Department,
                status = user.IsActive ? "نشط" : "موقوف",
                isActive = user.IsActive,
            },
            StringComparer.OrdinalIgnoreCase
        )
    );
}

<style nonce="@(Context.Items["CspStyleNonce"])">
    .general-manager-wizard-modal .modal-dialog {
        max-width: 980px;
    }

    .general-manager-wizard-modal .modal-content {
        border: 0;
        border-radius: 1.15rem;
        font-size: 0.92rem;
        background: var(--t-modal-bg, var(--bs-body-bg, #fff));
        color: var(--t-text, var(--bs-body-color, #212529));
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.16);
    }

    .general-manager-wizard-modal .modal-header,
    .general-manager-wizard-modal .modal-body,
    .general-manager-wizard-modal .modal-footer {
        padding-inline: 1rem;
    }

    .general-manager-wizard-modal .modal-header,
    .general-manager-wizard-modal .modal-footer {
        padding-block: 0.85rem;
    }

    .general-manager-wizard-modal .modal-body {
        padding-block: 0.9rem 1rem;
    }

    .general-manager-wizard-modal .modal-title {
        font-size: 1.02rem;
    }

    .general-manager-wizard-modal .text-muted.small,
    .general-manager-wizard-modal small,
    .general-manager-wizard-modal .small {
        font-size: 0.74rem !important;
    }

    .general-manager-wizard-modal .manager-handover-stepper {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.55rem;
        margin-bottom: 0.8rem;
    }

    .general-manager-wizard-modal .manager-handover-choice-grid.is-two-column {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.6rem;
    }

    .general-manager-wizard-modal .manager-handover-step {
        min-height: auto;
        padding: 0.72rem 0.76rem;
        border-radius: 0.95rem;
    }

    .general-manager-wizard-modal .manager-handover-step .fw-semibold {
        font-size: 0.85rem;
        margin-bottom: 0.12rem;
    }

    .general-manager-wizard-modal .manager-handover-step-number {
        width: 1.55rem;
        height: 1.55rem;
        font-size: 0.76rem;
    }

    .general-manager-wizard-modal .manager-handover-panel-shell {
        padding: 0.88rem 0.92rem;
        border-radius: 0.95rem;
    }

    .general-manager-wizard-modal .manager-handover-choice {
        padding: 0.78rem 0.84rem;
        border-radius: 0.9rem;
    }

    .general-manager-wizard-modal .manager-handover-choice strong {
        font-size: 0.88rem;
    }

    .general-manager-wizard-modal .form-label {
        font-size: 0.77rem;
        margin-bottom: 0.32rem;
    }

    .general-manager-wizard-modal .form-control,
    .general-manager-wizard-modal .form-select {
        min-height: calc(1.5em + 0.76rem + 2px);
        padding: 0.42rem 0.72rem;
        font-size: 0.83rem;
        border-radius: 0.8rem;
    }

    .general-manager-wizard-modal .field-validation-error {
        font-size: 0.72rem;
    }

    .general-manager-wizard-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
        gap: 0.55rem;
    }

    .general-manager-wizard-details-item {
        border: 1px solid var(--t-border-subtle, var(--bs-border-color, #d0d7de));
        border-radius: 0.78rem;
        background: var(--t-surface-alt, rgba(33, 37, 41, 0.03));
        padding: 0.65rem 0.75rem;
    }

    .general-manager-wizard-details-item span {
        display: block;
        color: var(--t-text-muted, var(--bs-secondary-color, #6c757d));
        font-size: 0.72rem;
        margin-bottom: 0.14rem;
    }

    .general-manager-wizard-change-list {
        margin: 0;
        padding-right: 1rem;
        font-size: 0.8rem;
    }

    .general-manager-wizard-change-list li+li {
        margin-top: 0.28rem;
    }

    .general-manager-wizard-modal .manager-handover-summary-item {
        padding: 0.7rem 0.78rem;
        border-radius: 0.78rem;
    }

    .general-manager-wizard-modal .modal-footer .btn {
        padding: 0.42rem 0.9rem;
        font-size: 0.81rem;
        border-radius: 999px;
    }

    .general-manager-user-picker {
        position: relative;
    }

    .general-manager-user-picker-control {
        position: relative;
    }

    .general-manager-user-picker-input {
        padding-inline-start: 2.4rem;
        padding-inline-end: 4.3rem;
        text-align: right;
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--t-surface-alt, var(--bs-body-bg, #fff)) 92%, transparent),
            color-mix(in srgb, var(--t-surface, var(--bs-body-bg, #fff)) 96%, transparent)
        );
        color: var(--t-text, var(--bs-body-color, #212529));
        border-color: var(--t-border-subtle, var(--bs-border-color, #d0d7de));
    }

    .general-manager-user-picker-input::placeholder {
        color: var(--t-text-muted, var(--bs-secondary-color, #64748b));
    }

    .general-manager-user-picker-toggle,
    .general-manager-user-picker-clear {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 1.85rem;
        height: 1.85rem;
        border: 0;
        padding: 0;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: var(--t-text-muted, #64748b);
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .general-manager-user-picker-toggle:hover,
    .general-manager-user-picker-toggle:focus-visible,
    .general-manager-user-picker-clear:hover,
    .general-manager-user-picker-clear:focus-visible {
        background: color-mix(in srgb, var(--t-surface-soft, rgba(148, 163, 184, 0.12)) 78%, transparent);
        color: var(--t-text, var(--bs-body-color, #212529));
        outline: 0;
    }

    .general-manager-user-picker-toggle {
        inset-inline-start: 0.42rem;
    }

    .general-manager-user-picker-clear {
        inset-inline-end: 0.42rem;
        font-size: 1rem;
    }

    .general-manager-user-picker-toggle::before {
        content: "";
        width: 0.48rem;
        height: 0.48rem;
        border-right: 1.7px solid currentColor;
        border-bottom: 1.7px solid currentColor;
        transform: rotate(45deg);
        margin-top: -0.16rem;
        transition: transform 0.18s ease, margin-top 0.18s ease;
    }

    .general-manager-user-picker.is-open .general-manager-user-picker-toggle::before {
        transform: rotate(225deg);
        margin-top: 0.12rem;
    }

    .general-manager-user-picker-panel {
        position: absolute;
        top: calc(100% + 0.3rem);
        inset-inline: 0;
        z-index: 45;
        border-radius: 0.95rem;
        background: color-mix(in srgb, var(--t-modal-bg, var(--bs-body-bg, #fff)) 94%, transparent);
        box-shadow: 0 18px 44px rgba(15, 23, 42, 0.24);
        border: 1px solid var(--t-border-subtle, rgba(148, 163, 184, 0.2));
        padding: 0.34rem;
        backdrop-filter: blur(12px);
    }

    .general-manager-user-picker-options {
        display: grid;
        gap: 0.18rem;
        max-height: 250px;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .general-manager-user-picker-option {
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 0.78rem;
        padding: 0.55rem 0.72rem;
        text-align: right;
        color: var(--t-text, #0f172a);
        transition: background 0.15s ease, color 0.15s ease;
    }

    .general-manager-user-picker-option strong {
        display: block;
        font-size: 0.82rem;
        line-height: 1.4;
        font-weight: 700;
    }

    .general-manager-user-picker-option small {
        display: block;
        margin-top: 0.12rem;
        color: var(--t-text-muted, #64748b);
        font-size: 0.71rem;
        line-height: 1.45;
    }

    .general-manager-user-picker-option:hover,
    .general-manager-user-picker-option.is-active {
        background: color-mix(in srgb, var(--t-blue-soft, rgba(37, 99, 235, 0.14)) 72%, transparent);
        color: var(--t-text, #0f172a);
    }

    .general-manager-user-picker-option.is-selected {
        background: color-mix(in srgb, var(--t-green-soft, rgba(25, 135, 84, 0.16)) 68%, transparent);
        color: var(--t-text, #0f172a);
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--t-green, #198754) 38%, transparent);
    }

    .general-manager-user-picker-empty {
        padding: 0.72rem 0.7rem 0.45rem;
        text-align: center;
        font-size: 0.75rem;
        color: var(--t-text-muted, var(--bs-secondary-color, #64748b));
    }

    @@media (max-width: 991.98px) {
        .general-manager-wizard-modal .manager-handover-stepper {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .general-manager-wizard-modal .manager-handover-stepper {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="modal fade" id="generalManagerReplaceConfirmModal" tabindex="-1"
     aria-labelledby="generalManagerReplaceConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-card-surface border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="generalManagerReplaceConfirmModalLabel">تأكيد تبديل المدير العام</h5>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"
                        aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                يوجد مدير عام حالي قائم، هل تريد تبديله؟
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">لا</button>
                <button type="button" class="btn btn-dark" id="confirmOpenGeneralManagerWizardButton">نعم</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade manager-handover-modal general-manager-wizard-modal" id="generalManagerWizardModal" tabindex="-1"
     aria-labelledby="generalManagerWizardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="AssignGeneralManager" method="post" id="generalManagerWizardForm" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="GeneralManagerAssignment.WizardStep" type="hidden" />

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="generalManagerWizardModalLabel">تعيين / تغيير المدير العام</h5>
                        <div class="text-muted small mt-1">
                            @(hasCurrentGeneralManager
                                ? $"المدير العام الحالي: {currentGeneralManagerDisplay} ({Model.CurrentGeneralManagerUsername})"
                                : "لا يوجد مدير عام حاليًا. سيبدأ المعالج مباشرة بتعيين المدير الجديد.")
                        </div>
                    </div>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"
                            aria-label="إغلاق"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="visually-hidden form-summary-only"></div>

                    <div class="manager-handover-stepper" id="generalManagerWizardStepper">
                        <div class="manager-handover-step" data-general-manager-step-indicator="1">
                            <span class="manager-handover-step-number">1</span>
                            <div class="fw-semibold">نوع التعيين الجديد</div>
                            <div class="text-muted small">اختر هل ستستخدم حسابًا موجودًا أم ستنشئ مديرًا عامًا جديدًا.
                            </div>
                        </div>
                        <div class="manager-handover-step" data-general-manager-step-indicator="2">
                            <span class="manager-handover-step-number">2</span>
                            <div class="fw-semibold">بيانات المرشح</div>
                            <div class="text-muted small">اختر المستخدم أو أدخل بيانات المدير العام الجديد مع التحقق
                                الكامل.</div>
                            </div>
                            <div class="manager-handover-step" data-general-manager-step-indicator="3">
                                <span class="manager-handover-step-number">3</span>
                                <div class="fw-semibold">وضع المدير السابق</div>
                                <div class="text-muted small">حدد ما الذي سيحدث للمدير العام السابق عند وجوده.</div>
                            </div>
                            <div class="manager-handover-step" data-general-manager-step-indicator="4">
                                <span class="manager-handover-step-number">4</span>
                                <div class="fw-semibold">حالة المنصب</div>
                                <div class="text-muted small">حدد هل سيشغل المنصب بصفة مثبتة أم تكليف.</div>
                            </div>
                            <div class="manager-handover-step" data-general-manager-step-indicator="5">
                                <span class="manager-handover-step-number">5</span>
                                <div class="fw-semibold">مراجعة نهائية</div>
                                <div class="text-muted small">راجع كل التغييرات الناتجة قبل التنفيذ النهائي.</div>
                            </div>
                        </div>

                        <div class="manager-handover-step-panel" data-general-manager-step-panel="1">
                            <div class="manager-handover-panel-shell is-muted mb-3">
                                <div class="fw-semibold mb-3">اختر نوع التعيين الجديد</div>
                                <div class="manager-handover-choice-grid is-two-column">
                                    @foreach (var option in selectionModeOptions)
                                    {
                                        <button type="button"
                                                class="manager-handover-choice @(string.Equals(Model.GeneralManagerAssignment.SelectionMode, option.Value, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                                                data-general-manager-selection="@option.Value">
                                            <strong>@option.Label</strong>
                                            <small>@option.Description</small>
                                        </button>
                                    }
                                </div>
                                <select asp-for="GeneralManagerAssignment.SelectionMode" class="form-select d-none"
                                        id="GeneralManagerAssignment_SelectionMode">
                                    @foreach (var option in selectionModeOptions)
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="manager-handover-step-panel" data-general-manager-step-panel="2" hidden>
                            <div class="manager-handover-panel-shell">
                                <div class="fw-semibold mb-2">بيانات المرشح للمنصب</div>
                                <div class="text-muted small mb-3">سيُستخدم الحساب المختار أو المنشأ الجديد كمصدر وحيد لربط
                                    بيانات المدير العام دون أي ربط يدوي.</div>

                                    <div id="generalManagerExistingUserFields">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label asp-for="GeneralManagerAssignment.ExistingUserUsername"
                                                       class="form-label">المستخدم الموجود</label>
                                                <div class="general-manager-user-picker" id="generalManagerExistingUserPicker">
                                                    <div class="general-manager-user-picker-control">
                                                        <input type="text"
                                                               class="form-control general-manager-user-picker-input"
                                                               id="GeneralManagerAssignment_ExistingUserUsernameSearch"
                                                               placeholder="ابحث بالاسم أو المعرف الداخلي أو القسم"
                                                               autocomplete="off"
                                                               role="combobox"
                                                               aria-autocomplete="list"
                                                               aria-expanded="false"
                                                               aria-haspopup="listbox"
                                                               aria-controls="generalManagerExistingUserPickerList"
                                                               value="@selectedExistingUserSearchLabel" />
                                                        <button type="button"
                                                                class="general-manager-user-picker-toggle"
                                                                id="generalManagerExistingUserPickerToggle"
                                                                aria-label="فتح قائمة المستخدمين"></button>
                                                        <button type="button"
                                                                class="general-manager-user-picker-clear"
                                                                id="generalManagerExistingUserPickerClear"
                                                                aria-label="مسح الاختيار"
                                                                @(selectedExistingUser == null ? "hidden" : null)>×</button>
                                                    </div>
                                                    <div class="general-manager-user-picker-panel"
                                                         id="generalManagerExistingUserPickerPanel"
                                                         hidden>
                                                        <div class="general-manager-user-picker-options"
                                                             id="generalManagerExistingUserPickerList"
                                                             role="listbox">
                                                            @foreach (var user in Model.GeneralManagerCandidateOptions)
                                                            {
                                                                var userDepartment = string.IsNullOrWhiteSpace(user.Department) ? "بدون قسم" : user.Department;
                                                                var userStatus = user.IsActive ? "نشط" : "موقوف";
                                                                var userSearchLabel = $"{user.DisplayName} ({user.Username}) - {userDepartment} - {userStatus}";
                                                                var isSelectedUser = string.Equals(user.Username, Model.GeneralManagerAssignment.ExistingUserUsername, StringComparison.OrdinalIgnoreCase);
                                                                <button type="button"
                                                                        class="general-manager-user-picker-option @(isSelectedUser ? "is-selected" : string.Empty)"
                                                                        data-general-manager-user-option="true"
                                                                        data-value="@user.Username"
                                                                        data-label="@userSearchLabel"
                                                                        data-search="@($"{user.DisplayName} {user.Username} {userDepartment} {userStatus}")"
                                                                        role="option"
                                                                        aria-selected="@(isSelectedUser ? "true" : "false")">
                                                                    <strong>@user.DisplayName (@user.Username)</strong>
                                                                    <small>@userDepartment · @userStatus</small>
                                                                </button>
                                                            }
                                                        </div>
                                                        <div class="general-manager-user-picker-empty text-muted"
                                                             id="generalManagerExistingUserPickerEmpty"
