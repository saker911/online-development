@model VehiclePermitSystemWeb.Models.ViewModels.Display.DisplayDeviceManagementViewModel

@{
    ViewData["Title"] = "إدارة شاشات العرض";
}

<div class="card-permit">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1 class="mb-0">إدارة شاشات العرض</h1>
        <a asp-action="DisplaySettings" class="btn btn-outline-secondary">إعدادات شاشات العرض</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="report-stat-card"><span>المعتمدة</span><strong>@Model.ApprovedCount</strong></div></div>
        <div class="col-md-3"><div class="report-stat-card"><span>تعمل الآن</span><strong>@Model.OnlineCount</strong></div></div>
        <div class="col-md-3"><div class="report-stat-card"><span>غير متصلة</span><strong>@Model.OfflineCount</strong></div></div>
        <div class="col-md-3"><div class="report-stat-card"><span>طلبات معلقة</span><strong>@Model.PendingCount</strong></div></div>
    </div>

    @foreach (var group in new[] {
        ("طلبات الشاشات الجديدة", Model.PendingDevices),
        ("الشاشات المعتمدة", Model.ApprovedDevices),
        ("الشاشات المرفوضة", Model.RejectedDevices),
        ("الشاشات المعطلة", Model.DisabledDevices)
    })
    {
        <h2 class="h5 mt-4">@group.Item1</h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>الشاشة</th>
                        <th>الموقع</th>
                        <th>IP</th>
                        <th>User-Agent</th>
                        <th>تاريخ الطلب</th>
                        <th>آخر ظهور</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in group.Item2)
                    {
                        <tr>
                            <td>
                                <strong>@item.ScreenName</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="small text-muted">@item.Description</div>
                                }
                            </td>
                            <td>@item.ScreenLocation</td>
                            <td class="ltr-field">@(!string.IsNullOrWhiteSpace(item.LastIpAddress) ? item.LastIpAddress : item.IpAddress)</td>
                            <td class="small">@item.UserAgentSummary</td>
                            <td>@HijriDateFormatter.Format(item.CreatedAtUtc.ToLocalTime())</td>
                            <td>@(item.LastSeenUtc.HasValue ? HijriDateFormatter.Format(item.LastSeenUtc.Value.ToLocalTime()) : "-")</td>
                            <td><span class="badge bg-secondary">@item.StatusText</span></td>
                            <td>
                                <div class="record-row-actions display-device-row-actions">
                                    @if (item.Status == DisplayDeviceStatuses.Pending)
                                    {
                                        <form asp-action="ApproveDisplayDevice" method="post" class="record-icon-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="record-icon-action record-icon-action-success" data-bs-toggle="tooltip"
                                                    data-bs-title="اعتماد" title="اعتماد" aria-label="اعتماد شاشة @item.ScreenName">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="m5 12 4 4L19 6" fill="none" stroke="currentColor"
                                                          stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </button>
                                        </form>
                                        <form asp-action="RejectDisplayDevice" method="post" class="record-icon-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="record-icon-action record-icon-action-danger" data-bs-toggle="tooltip"
                                                    data-bs-title="رفض" title="رفض" aria-label="رفض شاشة @item.ScreenName">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor"
                                                          stroke-width="1.9" stroke-linecap="round" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    @if (item.Status == DisplayDeviceStatuses.Approved)
                                    {
                                        <form asp-action="DisableDisplayDevice" method="post" class="record-icon-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="record-icon-action record-icon-action-warning" data-bs-toggle="tooltip"
                                                    data-bs-title="تعطيل" title="تعطيل" aria-label="تعطيل شاشة @item.ScreenName">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M12 3v8M7 5.8a8 8 0 1 0 10 0" fill="none"
                                                          stroke="currentColor" stroke-width="1.8"
                                                          stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </button>
                                        </form>
                                        <form asp-action="RotateDisplayDeviceToken" method="post" class="record-icon-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="record-icon-action record-icon-action-primary" data-bs-toggle="tooltip"
                                                    data-bs-title="تدوير الرمز" title="تدوير الرمز"
                                                    aria-label="تدوير رمز شاشة @item.ScreenName">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M21 12a9 9 0 0 1-15.5 6.2M3 12A9 9 0 0 1 18.5 5.8M18 3v4h-4M6 21v-4h4"
                                                          fill="none" stroke="currentColor" stroke-width="1.8"
                                                          stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    @if (item.Status == DisplayDeviceStatuses.Disabled)
                                    {
                                        <form asp-action="ActivateDisplayDevice" method="post" class="record-icon-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="record-icon-action record-icon-action-success" data-bs-toggle="tooltip"
                                                    data-bs-title="تنشيط" title="تنشيط" aria-label="تنشيط شاشة @item.ScreenName">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M8 5v14l11-7-11-7Z" fill="none" stroke="currentColor"
                                                          stroke-width="1.8" stroke-linejoin="round" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="DisplayDeviceDetails" asp-route-id="@item.Id" class="record-icon-action"
                                       data-bs-toggle="tooltip" data-bs-title="التفاصيل" title="التفاصيل"
                                       aria-label="عرض تفاصيل شاشة @item.ScreenName">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M5 4h14v16H5V4Zm3 5h8M8 13h8M8 17h5" fill="none"
                                                  stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        </svg>
                                    </a>
                                    <form asp-action="DeleteDisplayDevice" method="post" class="record-icon-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="record-icon-action record-icon-action-danger" data-bs-toggle="tooltip"
                                                data-bs-title="حذف" title="حذف" aria-label="حذف شاشة @item.ScreenName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7l1-3h4l1 3"
                                                      fill="none" stroke="currentColor" stroke-width="1.8"
                                                      stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!group.Item2.Any())
                    {
                        <tr><td colspan="8" class="text-muted">لا توجد عناصر.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
