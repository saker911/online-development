@model VehiclePermitSystemWeb.Models.ViewModels.Departments.DepartmentManagementViewModel
@using VehiclePermitSystemWeb.Models.DTOs
@using VehiclePermitSystemWeb.Models.Entities
@using VehiclePermitSystemWeb.Models.ViewModels.Account
@using VehiclePermitSystemWeb.Models.ViewModels.Backup
@using VehiclePermitSystemWeb.Models.ViewModels.Delegations
@using VehiclePermitSystemWeb.Models.ViewModels.Departments
@using VehiclePermitSystemWeb.Models.ViewModels.Display
@using VehiclePermitSystemWeb.Models.ViewModels.Permits
@using VehiclePermitSystemWeb.Models.ViewModels.Reports
@using VehiclePermitSystemWeb.Models.ViewModels.Scan
@using VehiclePermitSystemWeb.Models.ViewModels.Users
@using VehiclePermitSystemWeb.Models.ViewModels.Visits
@using VehiclePermitSystemWeb.Security

@{
    ViewData["Title"] = "مركز التعيين والنقل القيادي";
    var isEditing = Model.Department?.Id > 0;
    var isSuperAdmin = User.IsSuperAdmin();
    var openCreatePanel = (ViewData["OpenCreatePanel"] as bool?) == true;
    var openTransferPanel = (ViewData["OpenTransferPanel"] as bool?) == true;
    var openManagerHandoverModal = (ViewData["OpenManagerHandoverModal"] as bool?) == true;
    var transferSourceDepartment = Model.Departments.FirstOrDefault(x => x.Id == Model.TransferSourceDepartmentId);
    var transferSourceManagerUsername = transferSourceDepartment?.ManagerUsername ?? string.Empty;
    var transferSourceManagerName = string.IsNullOrWhiteSpace(transferSourceDepartment?.ManagerDisplayName)
        ? transferSourceManagerUsername
        : transferSourceDepartment!.ManagerDisplayName;
    var selectedTransferReplacementManagerUsername = Model.TransferReplacementManagerUsername ?? string.Empty;
    var regularDepartments = Model.Departments.ToList();
    var selectedHandoverDepartment = regularDepartments.FirstOrDefault(x => x.Id == Model.Handover.DepartmentId);
    var selectedHandoverManagerUsername = selectedHandoverDepartment?.ManagerUsername ?? string.Empty;
    var selectedHandoverManagerName = string.IsNullOrWhiteSpace(selectedHandoverDepartment?.ManagerDisplayName)
        ? selectedHandoverManagerUsername
        : selectedHandoverDepartment!.ManagerDisplayName;
    var selectedHandoverWizardStep = Model.Handover.WizardStep < 1 ? 1 : Model.Handover.WizardStep > 3 ? 3 :
Model.Handover.WizardStep;
    var assignmentTypeOptions = new[]
    {
        new { Value = DepartmentManagerTransitionTypes.Permanent, Label = "مدير أساسي" },
        new { Value = DepartmentManagerTransitionTypes.Acting, Label = "مدير مكلّف مؤقتًا" },
    };
    var exitActionOptions = new[]
    {
        new { Value = DepartmentManagerExitActions.Retirement, Label = "تقاعد" },
        new { Value = DepartmentManagerExitActions.Resignation, Label = "استقالة" },
        new { Value = DepartmentManagerExitActions.EndAssignment, Label = "إنهاء تكليف" },
        new { Value = DepartmentManagerExitActions.ExternalTransfer, Label = "نقل خارجي" },
        new { Value = DepartmentManagerExitActions.InternalTransfer, Label = "نقل داخلي" },
    };
    var selectedHandoverAssignmentTypeLabel = assignmentTypeOptions
        .FirstOrDefault(item => string.Equals(item.Value, Model.Handover.AssignmentType,
StringComparison.OrdinalIgnoreCase))?.Label ?? "تثبيت";
    var selectedHandoverExitActionLabel = exitActionOptions
        .FirstOrDefault(item => string.Equals(item.Value, Model.Handover.ExitAction, StringComparison.OrdinalIgnoreCase))?.Label
?? "إنهاء تكليف";
    var selectedExistingReplacementManager = Model.HandoverManagerOptions.FirstOrDefault(user =>
        string.Equals(user.Username, Model.Handover.ExistingManagerUsername, StringComparison.OrdinalIgnoreCase)
    );
    var selectedHandoverReplacementLabel = Model.Handover.CreateNewManager
        ? string.IsNullOrWhiteSpace(Model.Handover.NewManagerFullName)
            ? (string.IsNullOrWhiteSpace(Model.Handover.NewManagerUsername) ? "لم يحدد بعد" : Model.Handover.NewManagerUsername)
            : $"{Model.Handover.NewManagerFullName} ({Model.Handover.NewManagerUsername})"
        : selectedExistingReplacementManager == null
            ? "لم يحدد بعد"
            : $"{selectedExistingReplacementManager.DisplayName} ({selectedExistingReplacementManager.Username})";
    var selectedHandoverTargetDepartmentName = regularDepartments.FirstOrDefault(department => department.Id ==
Model.Handover.PreviousManagerTargetDepartmentId)?.Name
        ?? "غير مطلوب";
    var activeDepartmentCount = regularDepartments.Count(department => department.IsActive);
    var assignedManagerCount = regularDepartments.Count(department =>
        !string.IsNullOrWhiteSpace(department.ManagerUsername)
    );
    var vacantManagerCount = regularDepartments.Count - assignedManagerCount;
    var departmentEmployeeCount = Model.DepartmentUsersByDepartmentId.Values.Sum(users => users.Count);
}

@section Styles {
    <link rel="stylesheet" href="~/css/leadership.css" asp-append-version="true" />
}

<style nonce="@(Context.Items["CspStyleNonce"])">
    .manager-handover-modal .modal-content {
        background: var(--t-modal-bg, var(--bs-body-bg, #fff));
        color: var(--t-text, var(--bs-body-color, #212529));
        border: 1px solid var(--t-border-subtle, var(--bs-border-color, #d0d7de));
        box-shadow: var(--t-modal-shadow, var(--bs-box-shadow-lg, 0 1rem 3rem rgba(0, 0, 0, 0.175)));
    }

    .manager-handover-modal .modal-header,
    .manager-handover-modal .modal-footer {
        border-color: var(--t-border-subtle, var(--bs-border-color, #d0d7de));
        background: color-mix(in srgb, var(--t-surface, var(--bs-body-bg, #fff)) 88%, transparent);
    }

    .manager-handover-stepper {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .manager-handover-step {
        border: 1px solid var(--t-border-subtle, var(--bs-border-color, #d0d7de));
        border-radius: 1rem;
        background: var(--t-surface-alt, var(--bs-body-bg, #fff));
        padding: 0.9rem 1rem;
        text-align: right;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        color: var(--t-text, var(--bs-body-color, #212529));
        cursor: pointer;
    }

    .manager-handover-step.is-active {
        border-color: var(--t-green, var(--bs-success, #198754));
        box-shadow: 0 0 0 0.15rem color-mix(in srgb, var(--t-green, #198754) 20%, transparent);
        background: color-mix(in srgb, var(--t-green-soft, rgba(25, 135, 84, 0.08)) 70%, var(--t-surface, var(--bs-body-bg, #fff)));
    }

    .manager-handover-step.is-complete {
        border-color: color-mix(in srgb, var(--t-green, #198754) 45%, var(--t-border, #d0d7de));
    }

    .manager-handover-step-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        border: 1px solid var(--t-border, var(--bs-border-color, #d0d7de));
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .manager-handover-step.is-active .manager-handover-step-number,
    .manager-handover-step.is-complete .manager-handover-step-number {
        background: var(--t-green, var(--bs-success, #198754));
        border-color: var(--t-green, var(--bs-success, #198754));
        color: var(--t-text-inverse, #fff);
    }

    .manager-handover-choice-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.75rem;
    }

    .manager-handover-choice {
        width: 100%;
        border: 1px solid var(--t-border-subtle, var(--bs-border-color, #d0d7de));
        border-radius: 1rem;
        background: var(--t-surface, var(--bs-body-bg, #fff));
        padding: 1rem;
        text-align: right;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        color: var(--t-text, var(--bs-body-color, #212529));
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .manager-handover-choice.is-active {
        border-color: var(--t-green, var(--bs-success, #198754));
        box-shadow: 0 0 0 0.15rem color-mix(in srgb, var(--t-green, #198754) 20%, transparent);
        background: color-mix(in srgb, var(--t-green-soft, rgba(25, 135, 84, 0.08)) 70%, var(--t-surface, var(--bs-body-bg, #fff)));
    }

    .manager-handover-choice small {
        color: var(--t-text-muted, var(--bs-secondary-color, #6c757d));
    }

    .manager-handover-panel-shell {
        border: 1px solid var(--t-border-subtle, var(--bs-border-color, #d0d7de));
        border-radius: 1rem;
        padding: 1rem;
        background: var(--t-surface, var(--bs-body-bg, #fff));
    }

    .manager-handover-panel-shell.is-muted {
        background: var(--t-surface-soft, var(--bs-secondary-bg, #f8f9fa));
    }

    .manager-handover-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem;
    }

    .manager-handover-summary-item {
        border: 1px solid var(--t-border-subtle, var(--bs-border-color, #d0d7de));
        border-radius: 0.9rem;
        background: var(--t-surface-alt, rgba(33, 37, 41, 0.03));
        padding: 0.85rem 1rem;
    }

    .manager-handover-summary-item span {
        display: block;
        color: var(--t-text-muted, var(--bs-secondary-color, #6c757d));
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
    }

    .manager-handover-summary-item strong {
        display: block;
        word-break: break-word;
    }
</style>

<div class="card-permit leadership-shell">
    <div class="leadership-hero">
        <div class="leadership-hero-copy">
            <span class="leadership-kicker">الحوكمة التنظيمية</span>
            <div class="leadership-title-row">
                <span class="leadership-title-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 3v5M5 21v-4a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v4M7.5 7.5a4.5 4.5 0 1 0 9 0 4.5 4.5 0 0 0-9 0z" />
                    </svg>
                </span>
                <div>
                    <h1>مركز التعيين والنقل القيادي</h1>
                    <p>مسار موحد لتعيين المدير العام، إسناد مدراء الأقسام، ومعالجة النقل والتقاعد دون فصل الحسابات عن هيكلها التنظيمي.</p>
                </div>
            </div>
        </div>

        <div class="leadership-actions">
            <a asp-action="Edit" class="btn btn-outline-secondary">العودة إلى بيانات الإدارة</a>
            @if (isSuperAdmin)
            {
                <button type="button" class="btn btn-primary" id="openGeneralManagerWizardButton"
                        data-has-current-general-manager="@(!string.IsNullOrWhiteSpace(Model.CurrentGeneralManagerUsername)).ToString().ToLowerInvariant()"
                        data-current-general-manager-name="@Model.CurrentGeneralManagerName">
                    إدارة المدير العام
                </button>
            }
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse"
                    data-bs-target="#createDepartmentPanel" aria-expanded="@(openCreatePanel ? "true" : "false")"
                    aria-controls="createDepartmentPanel">
                تهيئة قسم
            </button>
            @if (Model.TransferSourceDepartmentId > 0)
            {
                <button type="button" class="btn btn-warning" data-bs-toggle="collapse"
                        data-bs-target="#transferDepartmentPanel" aria-expanded="@(openTransferPanel ? "true" : "false")"
                        aria-controls="transferDepartmentPanel">
                    نقل الموظفين
                </button>
                <a asp-action="Leadership" class="btn btn-outline-warning">إلغاء النقل</a>
            }
        </div>
    </div>

    <div class="leadership-metrics">
        <div class="leadership-metric leadership-metric-primary">
            <span>الأقسام النشطة</span>
            <strong>@activeDepartmentCount</strong>
            <small>من أصل @regularDepartments.Count أقسام</small>
        </div>
        <div class="leadership-metric leadership-metric-success">
            <span>المديرون المعينون</span>
            <strong>@assignedManagerCount</strong>
            <small>ارتباطات قيادية فعالة</small>
        </div>
        <div class="leadership-metric leadership-metric-warning">
            <span>أقسام دون مدير</span>
            <strong>@vacantManagerCount</strong>
            <small>تحتاج إسنادًا قياديًا</small>
        </div>
        <div class="leadership-metric leadership-metric-info">
            <span>الموظفون المرتبطون</span>
            <strong>@departmentEmployeeCount</strong>
            <small>ضمن الهيكل التنظيمي</small>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="visually-hidden form-summary-only"></div>

    @if (Model.AdministrationDepartment != null)
    {
        <div class="leadership-administration-card">
            <div>
                <span class="leadership-card-label">الإدارة الرئيسية</span>
                <h2>@Model.AdministrationDepartment.Name</h2>
            </div>
            <div class="leadership-administration-manager">
                <span>المدير العام الحالي</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.AdministrationDepartment.ManagerDisplayName)
                                                                                                    ? Model.AdministrationDepartment.ManagerUsername
                                                                                                    : Model.AdministrationDepartment.ManagerDisplayName)</strong>
                <small class="@(Model.AdministrationDepartment.IsActive ? "is-active" : "is-inactive")">@(Model.AdministrationDepartment.IsActive ? "إدارة نشطة" : "إدارة موقوفة")</small>
            </div>
        </div>
    }

                <div id="createDepartmentPanel" class="collapse @(openCreatePanel ? "show" : string.Empty)">
                    <div class="card card-body mb-4 shadow-sm border-0">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="mb-1">@(isEditing ? "تحديث بيانات القسم" : "تهيئة قسم جديد")</h5>
                            </div>
                            @if (isEditing)
                            {
                                <a asp-action="Leadership" class="btn btn-sm btn-outline-secondary">إلغاء التعديل</a>
                            }
                        </div>

                        <form asp-action="Departments" method="post" id="departmentForm">
                            @Html.AntiForgeryToken()
                            <input asp-for="Department.Id" type="hidden" />
                            <div class="row g-3 align-items-end">
                                <div class="col-md-8">
                                    <label asp-for="Department.Name" class="form-label">اسم القسم</label>
                                    <input asp-for="Department.Name" class="form-control" placeholder="مثال: شؤون الموظفين" />
                                    <span asp-validation-for="Department.Name" class="field-validation-error small"></span>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check mt-4 pt-2">
                                        <input asp-for="Department.IsActive" class="form-check-input" />
                                        <label asp-for="Department.IsActive" class="form-check-label">نشط</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">@(isEditing ? "حفظ التعديلات" : "حفظ التهيئة")</button>
                                <a asp-action="Leadership" class="btn btn-outline-secondary">تفريغ</a>
                            </div>
                        </form>
                    </div>
                </div>

                @if (isSuperAdmin)
                {
                    @await Html.PartialAsync("_GeneralManagerWizard", Model)
                }

                <div id="transferDepartmentPanel" class="collapse @(openTransferPanel ? "show" : string.Empty)">
                    <div class="card card-body mb-4 shadow-sm border-0">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="mb-1">نقل موظفين قبل الحذف</h5>
                                <div class="text-muted small">اختر قسمًا هدفًا وانقل الجميع أو اختر موظفين محددين فقط.</div>
                            </div>
                        </div>

                        <form asp-action="TransferDepartmentUsers" method="post">
                            @Html.AntiForgeryToken()
                            <input asp-for="TransferSourceDepartmentId" type="hidden" />
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <input class="form-control" value="@(transferSourceDepartment?.Name ?? "-- اختر القسم --")"
                                           disabled />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="TransferTargetDepartmentId" class="form-label">القسم الهدف</label>
                                    <select asp-for="TransferTargetDepartmentId" class="form-select" data-smart-select="true"
                                            data-smart-select-placeholder="ابحث عن القسم الهدف أو اختره">
                                        <option value="0">-- اختر القسم الهدف --</option>
                                        @foreach (var department in regularDepartments)
                                        {
                                            if (department.Id != Model.TransferSourceDepartmentId)
                                            {
                                                <option value="@department.Id">@department.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check mt-4 pt-2">
                                        <input asp-for="TransferAllUsers" class="form-check-input" />
                                        <label asp-for="TransferAllUsers" class="form-check-label">نقل الجميع</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="text-muted small mb-2">الموظفون الموجودون حاليًا في هذا القسم:</div>
                                <div class="mb-2">
                                    <input type="text" class="form-control form-control-sm" id="transfer-users-search"
                                           placeholder="ابحث عن موظف بالنص أو رقم المستخدم" autocomplete="off" />
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (Model.TransferSourceUsers.Count == 0)
                                    {
                                        <span class="text-muted">لا يوجد موظفون في هذا القسم.</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small w-100" id="transfer-users-search-empty" hidden>لا
                                            توجد نتائج مطابقة.</span>
                                            @foreach (var user in Model.TransferSourceUsers)
                                            {
                                                var isSelectedTransferUser = Model.SelectedTransferUsernames.Any(selected =>
                                                    string.Equals(selected, user.Username, StringComparison.OrdinalIgnoreCase)
                                                );
                                                <label class="badge text-bg-light border" data-transfer-user-item="true"
                                                       data-transfer-user-name="@($"{user.DisplayName} {user.Username}".ToLowerInvariant())">
                                                    <input type="checkbox" name="SelectedTransferUsernames" value="@user.Username"
                                                           class="form-check-input me-1" @(isSelectedTransferUser ? "checked" : null) />
                                                    <span>@user.DisplayName (@user.Username)</span>
                                                </label>
                                            }
                                        }
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(transferSourceManagerUsername))
                                {
                                    <div class="mt-3 row g-3 align-items-end">
                                        <div class="col-md-6">
                                            <div class="app-inline-note app-inline-note-warning py-2 mb-0">
                                                إذا شمل النقل المدير الحالي للقسم (@transferSourceManagerName)، فيجب اختيار مدير بديل قبل
                                                تنفيذ العملية.
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="TransferReplacementManagerUsername" class="form-label">بديل مدير القسم</label>
                                            <select asp-for="TransferReplacementManagerUsername" class="form-select"
                                                    data-smart-select="true" data-smart-select-placeholder="ابحث عن المدير البديل أو اختره">
                                                <option value="">-- اختر البديل عند نقل المدير الحالي --</option>
                                                @foreach (var manager in Model.TransferReplacementOptions)
                                                {
                                                    var managerDepartmentLabel = string.IsNullOrWhiteSpace(manager.Department) ? "بدون قسم" :
                                            manager.Department;
                                                    <option value="@manager.Username"
                                                            selected="@(string.Equals(selectedTransferReplacementManagerUsername, manager.Username, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                        @manager.DisplayName (@manager.Username) - @managerDepartmentLabel
                                                    </option>
                                                }
                                            </select>
                                            @if (Model.TransferReplacementOptions.Count == 0)
                                            {
                                                <div class="form-text text-danger">لا يوجد مدير مؤهل غير مرتبط بقسم حاليًا. حرر مديرًا أو أنشئ
                                                    مدير قسم جديدًا أولًا.</div>
                                                }
                            else
                                                {
                                                    <div class="form-text">يظهر هنا فقط المديرون النشطون غير المرتبطين حاليًا بقسم آخر حتى لا يُسحب
                                                        مدير من قسم مختلف بالخطأ.</div>
                                                    }
                                                    <span asp-validation-for="TransferReplacementManagerUsername"
                                                          class="field-validation-error small"></span>
                                                </div>
                                            </div>
                                        }

                                        <div class="mt-3 d-flex gap-2 flex-wrap">
                                            <button type="submit" class="btn btn-warning">تنفيذ النقل</button>
                                            <a asp-action="Leadership" class="btn btn-outline-secondary">إلغاء</a>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            @if (isSuperAdmin)
                            {
                                <div class="leadership-section-heading">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                                        <div>
                                            <h5 class="mb-1">نقل المدير الحالي</h5>
                                            <div class="app-inline-note app-inline-note-info mb-0">من كل صف قسم يمكنك فتح نموذج خطوات واضح: تحديد نوع الإسناد، اختيار المدير
                                                الجديد، ثم اعتماد وضع المدير السابق قبل التنفيذ.</div>
                                            </div>
                                            <div class="text-muted small">متاح فقط لمالك النظام</div>
                                        </div>
                                    </div>
                                }

                                <div class="table-responsive leadership-table-wrap">
                                    <table class="table table-striped align-middle permit-list-table app-data-table department-management-table">
                                        <thead>
                                            <tr>
                                                <th>القسم</th>
                                                <th>المدير</th>
                                                <th>الموظفون</th>
                                                <th>الحالة</th>
                                                <th>الإجراءات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var department in regularDepartments)
                                            {
                                                var currentManagerDepartment = Model.UserDepartmentsByUsername.TryGetValue(
                                                    department.ManagerUsername ?? string.Empty,
                                                    out var resolvedManagerDepartment
                                                )
                                                    ? resolvedManagerDepartment
                                                    : string.Empty;
                                                var currentManagerUsername = (department.ManagerUsername ?? string.Empty).Trim();
                                                <tr>
                                                    <td>@department.Name</td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(department.ManagerDisplayName))
                                                        {
                                                            <span>@department.ManagerDisplayName</span>
                                                            <span class="text-muted small">(@(string.IsNullOrWhiteSpace(currentManagerDepartment) ? "بدون قسم" : currentManagerDepartment))</span>
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(department.ManagerUsername))
                                                        {
                                                            <span>@department.ManagerUsername</span>
                                                            <span class="text-muted small">(@(string.IsNullOrWhiteSpace(currentManagerDepartment) ? "بدون قسم" : currentManagerDepartment))</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">بدون تعيين</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (Model.DepartmentUsersByDepartmentId.TryGetValue(department.Id, out var departmentUsers) &&
                                                                                                                                                                                departmentUsers.Count > 0)
                                                        {
                                                            var visibleDepartmentUsers = departmentUsers
                                                                .Where(user => !string.Equals(user.Username, currentManagerUsername,
                                                    StringComparison.OrdinalIgnoreCase))
                                                                .ToList();
                                                            if (visibleDepartmentUsers.Count > 0)
                                                            {
                                                                var remainingUserCount = visibleDepartmentUsers.Count - 2;
                                                                var visibleUserNames = string.Join("، ", visibleDepartmentUsers.Select(user =>
                                                    user.DisplayName));
                                                                <div class="d-flex flex-column gap-1">
                                                                    <span class="text-muted small">@($"{visibleDepartmentUsers.Count} موظف")</span>
                                                                    <div class="d-flex flex-wrap gap-1" title="@visibleUserNames">
                                                                        @foreach (var user in visibleDepartmentUsers.Take(2))
                                                                        {
                                                                            <span class="badge text-bg-light border">@user.DisplayName</span>
                                                                        }
                                                                        @if (remainingUserCount > 0)
                                                                        {
                                                                            <span class="badge text-bg-secondary">@($"+{remainingUserCount}")</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">لا يوجد موظفون إضافيون غير المدير الحالي</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">لا يوجد موظفون</span>
                                                        }
                                                    </td>
                                                    <td>@(department.IsActive ? "نشط" : "موقوف")</td>
                                                    <td>
                                                        <div class="record-row-actions department-row-actions">
                                                                                <a asp-action="Leadership" asp-route-id="@department.Id"
                                                               class="record-icon-action record-icon-action-warning"
                                                               data-bs-toggle="tooltip" data-bs-title="تعديل" title="تعديل"
                                                               aria-label="تعديل القسم @department.Name">
                                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                                    <path d="M4 20h4l10.3-10.3a1.4 1.4 0 0 0 0-2L16.3 5.7a1.4 1.4 0 0 0-2 0L4 16v4zM13.5 6.5l4 4"
                                                                          fill="none" stroke="currentColor" stroke-width="1.8"
                                                                          stroke-linecap="round" stroke-linejoin="round" />
                                                                </svg>
                                                            </a>
                                                                                <a asp-action="Leadership" asp-route-transferFromId="@department.Id"
                                                               class="record-icon-action record-icon-action-primary"
                                                               data-bs-toggle="tooltip" data-bs-title="نقل موظفين" title="نقل موظفين"
                                                               aria-label="نقل موظفي القسم @department.Name">
                                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                                    <path d="M7 7h10M17 7l-3-3M17 7l-3 3M17 17H7M7 17l3-3M7 17l3 3"
                                                                          fill="none" stroke="currentColor" stroke-width="1.8"
                                                                          stroke-linecap="round" stroke-linejoin="round" />
                                                                </svg>
                                                            </a>
                                                            @if (!string.IsNullOrWhiteSpace(currentManagerUsername))
                                                            {
                                                                                     <a asp-action="Leadership" asp-route-handoverDepartmentId="@department.Id"
                                                                   class="record-icon-action"
                                                                   data-bs-toggle="tooltip" data-bs-title="نقل المدير الحالي"
                                                                   title="نقل المدير الحالي"
                                                                   aria-label="نقل المدير الحالي للقسم @department.Name">
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                                                        <path d="M16 11a4 4 0 1 0-8 0M5 21a7 7 0 0 1 14 0M17 4h4m0 0v4m0-4-5 5"
                                                                              fill="none" stroke="currentColor" stroke-width="1.8"
                                                                              stroke-linecap="round" stroke-linejoin="round" />
                                                                    </svg>
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <a asp-controller="Users" asp-action="Create"
                                                                   asp-route-presetRole="@AppRoles.DepartmentManager"
                                                                   asp-route-creationFlow="department-manager"
                                                                   asp-route-department="@department.Name"
                                                                   class="record-icon-action record-icon-action-success"
                                                                   data-bs-toggle="tooltip" data-bs-title="تعيين مدير"
                                                                   title="تعيين مدير"
                                                                   aria-label="تعيين مدير للقسم @department.Name">
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                                                        <path d="M12 5v14M5 12h14" fill="none"
                                                                              stroke="currentColor" stroke-width="1.9"
                                                                              stroke-linecap="round" />
                                                                    </svg>
                                                                </a>
                                                            }
                                                            <form asp-action="DeleteDepartment" method="post" class="record-icon-form"
                                                                  onsubmit="return confirm('هل تريد حذف القسم @department.Name؟');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@department.Id" />
                                                                <button type="submit" class="record-icon-action record-icon-action-danger"
                                                                        data-bs-toggle="tooltip" data-bs-title="حذف" title="حذف"
                                                                        aria-label="حذف القسم @department.Name">
                                                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                                                        <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7l1-3h4l1 3"
                                                                              fill="none" stroke="currentColor" stroke-width="1.8"
                                                                              stroke-linecap="round" stroke-linejoin="round" />
                                                                    </svg>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @if (isSuperAdmin)
                            {
                                <div class="modal fade manager-handover-modal" id="managerHandoverModal" tabindex="-1"
                                     aria-labelledby="managerHandoverModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="HandoverDepartmentManager" method="post" id="managerHandoverForm" novalidate>
                                                @Html.AntiForgeryToken()
                                                <input asp-for="Handover.DepartmentId" type="hidden" />
                                                <input asp-for="Handover.WizardStep" type="hidden" />
                                                <div class="modal-header">
                                                    <div>
                                                        <h5 class="modal-title" id="managerHandoverModalLabel">نقل المدير الحالي</h5>
                                                        <div class="text-muted small mt-1">
                                                            @(selectedHandoverDepartment == null
                                                                ? "اختر القسم من زر الصف لفتح تفاصيل التسليم."
                                                                : $"القسم: {selectedHandoverDepartment.Name} | المدير الحالي:                            {selectedHandoverManagerName}")
                                                        </div>
                                                    </div>
                                                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"
