                                                                    <input asp-for="Handover.CreateNewManager" class="d-none" id="handoverCreateNewManager" />
                                                                </div>
                                                            </div>

                                                            <div class="manager-handover-step-panel" data-handover-step-panel="2" hidden>
                                                                <div class="manager-handover-panel-shell">
                                                                    <div class="fw-semibold mb-2">المدير الجديد</div>
                                                                    <div class="text-muted small mb-3">@(Model.Handover.CreateNewManager ? "أدخل بيانات المدير الجديد كاملة ليُنشأ الحساب ويُربط بالقسم مباشرة." : "اختر من القائمة حسابًا صالحًا غير مرتبط حاليًا بإدارة أخرى.")</div>

                                                                    <div id="handoverExistingManagerFields" class="row g-3">
                                                                        <div class="col-12">
                                                                            <label asp-for="Handover.ExistingManagerUsername" class="form-label">اختر مديرًا
                                                                                موجودًا</label>
                                                                                <select asp-for="Handover.ExistingManagerUsername" class="form-select">
                                                                                    <option value="">-- اختر المدير الجديد --</option>
                                                                                    @foreach (var user in Model.HandoverManagerOptions)
                                                                                    {
                                                                                        var userDepartment = string.IsNullOrWhiteSpace(user.Department) ? "بدون قسم" :
                                                                                user.Department;
                                                                                        <option value="@user.Username">@user.DisplayName (@user.Username) -
                                                                                            @userDepartment</option>
                                                                                        }
                                                                                    </select>
                                                                                    <span asp-validation-for="Handover.ExistingManagerUsername"
                                                                                          class="field-validation-error small"></span>
                                                                                </div>
                                                                            </div>

                                                                            <div id="handoverNewManagerFields" class="row g-3">
                                                                                <div class="col-md-4">
                                                                                    <label asp-for="Handover.NewManagerUsername" class="form-label">المعرف الداخلي</label>
                                                                                    <input asp-for="Handover.NewManagerUsername" class="form-control ltr-field"
                                                                                        inputmode="numeric" maxlength="10" pattern="[12][0-9]{9}"
                                                                                        placeholder="1023456789" title="المعرف الداخلي يجب أن يكون 10 أرقام ويبدأ بـ 1 أو 2" />
                                                                                    <span asp-validation-for="Handover.NewManagerUsername"
                                                                                          class="field-validation-error small"></span>
                                                                                </div>
                                                                                <div class="col-md-4">
                                                                                    <label asp-for="Handover.NewManagerFullName" class="form-label">الاسم الكامل</label>
                                                                                    <input asp-for="Handover.NewManagerFullName" class="form-control" />
                                                                                    <span asp-validation-for="Handover.NewManagerFullName"
                                                                                          class="field-validation-error small"></span>
                                                                                </div>
                                                                                <div class="col-md-4">
                                                                                    <label asp-for="Handover.NewManagerPhoneNumber" class="form-label">الجوال</label>
                                                                                    <input asp-for="Handover.NewManagerPhoneNumber" class="form-control ltr-field"
                                                                                        inputmode="numeric" maxlength="10" pattern="05[0-9]{8}"
                                                                                        placeholder="0501234567" title="رقم الجوال يجب أن يكون 10 أرقام ويبدأ بـ 05" />
                                                                                    <span asp-validation-for="Handover.NewManagerPhoneNumber"
                                                                                          class="field-validation-error small"></span>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="manager-handover-panel-shell is-muted mt-3">
                                                                            <div class="fw-semibold mb-2">صفة إدارة القسم</div>
                                                                            <div class="text-muted small mb-3">هل يصبح المدير مسؤولًا أساسيًا أم يتولى الإدارة مؤقتًا؟</div>
                                                                            <div class="manager-handover-choice-grid mb-3">
                                                                                @foreach (var item in assignmentTypeOptions)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="manager-handover-choice @(string.Equals(Model.Handover.AssignmentType, item.Value, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                                                                                            data-assignment-choice="@item.Value">
                                                                                        <strong>@item.Label</strong>
                                                                                        <small>@(string.Equals(item.Value, DepartmentManagerTransitionTypes.Permanent,
                                                                                                StringComparison.OrdinalIgnoreCase)
                                                                                                    ? "يتولى إدارة القسم دون مدة تكليف مؤقتة."
                                                                                                    : "يتولى إدارة القسم بصفة مؤقتة ويمكن تغييرها لاحقًا.")</small>
                                                                                    </button>
                                                                                }
                                                                            </div>
                                                                            <select asp-for="Handover.AssignmentType" class="form-select d-none"
                                                                                    id="Handover_AssignmentType">
                                                                                @foreach (var item in assignmentTypeOptions)
                                                                                {
                                                                                    <option value="@item.Value">@item.Label</option>
                                                                                }
                                                                            </select>
                                                                            <span asp-validation-for="Handover.AssignmentType"
                                                                                  class="field-validation-error small"></span>
                                                                        </div>
                                                                    </div>

                                                                    <div class="manager-handover-step-panel" data-handover-step-panel="3" hidden>
                                                                        <div class="manager-handover-panel-shell is-muted mb-3">
                                                                            <div class="fw-semibold mb-3">ملخص النقل</div>
                                                                            <div class="manager-handover-summary-grid">
                                                                                <div class="manager-handover-summary-item">
                                                                                    <span>القسم</span>
                                                                                    <strong>@(selectedHandoverDepartment?.Name ?? "غير محدد")</strong>
                                                                                </div>
                                                                                <div class="manager-handover-summary-item">
                                                                                    <span>المدير الحالي</span>
                                                                                    <strong>@(string.IsNullOrWhiteSpace(selectedHandoverManagerName) ? "غير محدد" :
                                                                                                                                                                                                                                                                                                selectedHandoverManagerName)</strong>
                                                                                    </div>
                                                                                    <div class="manager-handover-summary-item">
                                                                                        <span>الإسناد الجديد</span>
                                                                                        <strong
                                                                                        data-handover-summary="assignmentType">@selectedHandoverAssignmentTypeLabel</strong>
                                                                                    </div>
                                                                                    <div class="manager-handover-summary-item">
                                                                                        <span>المدير الجديد</span>
                                                                                        <strong
                                                                                        data-handover-summary="replacementManager">@selectedHandoverReplacementLabel</strong>
                                                                                    </div>
                                                                                    <div class="manager-handover-summary-item">
                                                                                        <span>وضع المدير السابق</span>
                                                                                        <strong data-handover-summary="exitAction">@selectedHandoverExitActionLabel</strong>
                                                                                    </div>
                                                                                    <div class="manager-handover-summary-item">
                                                                                        <span>القسم الهدف للنقل الداخلي</span>
                                                                                        <strong
                                                                                        data-handover-summary="targetDepartment">@selectedHandoverTargetDepartmentName</strong>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <div class="manager-handover-panel-shell">
                                                                                <div class="fw-semibold mb-2">ماذا يحدث للمدير الحالي؟</div>
                                                                                <div class="text-muted small mb-3">اختر حالته بعد تسليم القسم للمدير الجديد.</div>
                                                                                <div class="row g-3">
                                                                                    <div class="col-md-6">
                                                                                        <label for="handoverExitActionSelect" class="form-label">الإجراء على المدير
                                                                                            السابق</label>
                                                                                            <select asp-for="Handover.ExitAction" class="form-select"
                                                                                                    id="handoverExitActionSelect">
                                                                                                @foreach (var item in exitActionOptions)
                                                                                                {
                                                                                                    <option value="@item.Value">@item.Label</option>
                                                                                                }
                                                                                            </select>
                                                                                            <span asp-validation-for="Handover.ExitAction"
                                                                                                  class="field-validation-error small"></span>
                                                                                        </div>
                                                                                        <div class="col-md-6" id="handoverPreviousRoleFields">
                                                                                            <label asp-for="Handover.PreviousManagerNewRole" class="form-label">الدور الجديد
                                                                                                للمدير السابق</label>
                                                                                                <select asp-for="Handover.PreviousManagerNewRole" class="form-select">
                                                                                                    @foreach (var role in Model.PreviousManagerRoleOptions)
                                                                                                    {
                                                                                                        <option value="@role">@AppRoles.GetDisplayName(role)</option>
                                                                                                    }
                                                                                                </select>
                                                                                                <span asp-validation-for="Handover.PreviousManagerNewRole"
                                                                                                      class="field-validation-error small"></span>
                                                                                            </div>
                                                                                            <div class="col-12" id="handoverInternalTransferFields">
                                                                                                <label asp-for="Handover.PreviousManagerTargetDepartmentId" class="form-label">القسم
                                                                                                    الهدف للمدير السابق</label>
                                                                                                    <select asp-for="Handover.PreviousManagerTargetDepartmentId" class="form-select">
                                                                                                        <option value="0">-- اختر القسم الهدف --</option>
                                                                                                        @foreach (var department in regularDepartments)
                                                                                                        {
                                                                                                            if (department.Id != Model.Handover.DepartmentId)
                                                                                                            {
                                                                                                                <option value="@department.Id">@department.Name</option>
                                                                                                            }
                                                                                                        }
                                                                                                    </select>
                                                                                                    <span asp-validation-for="Handover.PreviousManagerTargetDepartmentId"
                                                                                                          class="field-validation-error small"></span>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="handover-automation-note mt-3" aria-live="polite">
                                                                                            <strong>ما الذي سينفذه النظام تلقائيًا؟</strong>
                                                                                            <p id="handoverAutomationExplanation"></p>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="modal-footer justify-content-between">
                                                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                                                    <div class="d-flex gap-2">
                                                                                        <button type="button" class="btn btn-outline-secondary"
                                                                                                id="handoverPreviousStepButton">السابق</button>
                                                                                        <button type="button" class="btn btn-dark" id="handoverNextStepButton">التالي</button>
                                                                                        <button type="submit" class="btn btn-dark" id="handoverSubmitButton" hidden>تنفيذ
                                                                                            نقل المدير</button>
                                                                                        </div>
                                                                                    </div>
                                                                                </form>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                @section Scripts {
                                                                    <script nonce="@(Context.Items["CspScriptNonce"])">
                                                                        document.addEventListener("DOMContentLoaded", function () {
                                                                            const createDepartmentPanel = document.getElementById("createDepartmentPanel");
                                                                            if (createDepartmentPanel && @openCreatePanel.ToString().ToLowerInvariant()) {
                                                                                if (window.bootstrap && bootstrap.Collapse) {
                                                                                    bootstrap.Collapse.getOrCreateInstance(createDepartmentPanel, { toggle: false }).show();
                                                                                }
                                                                            }

                                                                            const transferDepartmentPanel = document.getElementById("transferDepartmentPanel");
                                                                            if (transferDepartmentPanel && @openTransferPanel.ToString().ToLowerInvariant()) {
                                                                                if (window.bootstrap && bootstrap.Collapse) {
                                                                                    bootstrap.Collapse.getOrCreateInstance(transferDepartmentPanel, { toggle: false }).show();
                                                                                }
                                                                            }

                                                                            const transferUsersSearch = document.getElementById("transfer-users-search");
                                                                            const transferUserItems = Array.from(document.querySelectorAll('[data-transfer-user-item="true"]'));
                                                                            const transferUsersSearchEmpty = document.getElementById("transfer-users-search-empty");

                                                                            if (transferUsersSearch && transferUserItems.length > 0) {
                                                                                transferUsersSearch.addEventListener("input", function () {
                                                                                    const query = (transferUsersSearch.value || "").trim().toLowerCase();
                                                                                    let visibleCount = 0;

                                                                                    transferUserItems.forEach(function (item) {
                                                                                        const searchText = item.getAttribute("data-transfer-user-name") || "";
                                                                                        const isVisible = !query || searchText.includes(query);
                                                                                        item.hidden = !isVisible;
                                                                                        if (isVisible) {
                                                                                            visibleCount += 1;
                                                                                        }
                                                                                    });

                                                                                    if (transferUsersSearchEmpty) {
                                                                                        transferUsersSearchEmpty.hidden = visibleCount !== 0;
                                                                                    }
                                                                                });
                                                                            }

                                                                            const handoverModal = document.getElementById("managerHandoverModal");
                                                                            const handoverForm = document.getElementById("managerHandoverForm");
                                                                            const createNewManagerToggle = document.getElementById("handoverCreateNewManager");
                                                                            const existingManagerFields = document.getElementById("handoverExistingManagerFields");
                                                                            const newManagerFields = document.getElementById("handoverNewManagerFields");
                                                                            const exitActionSelect = document.getElementById("handoverExitActionSelect");
                                                                            const previousRoleFields = document.getElementById("handoverPreviousRoleFields");
                                                                            const internalTransferFields = document.getElementById("handoverInternalTransferFields");
                                                                            const assignmentTypeSelect = document.getElementById("Handover_AssignmentType");
                                                                            const handoverWizardStepInput = document.getElementById("Handover_WizardStep");
                                                                            const handoverStepPanels = Array.from(document.querySelectorAll("[data-handover-step-panel]"));
                                                                            const handoverStepIndicators = Array.from(document.querySelectorAll("[data-handover-step-indicator]"));
                                                                            const assignmentChoiceButtons = Array.from(document.querySelectorAll("[data-assignment-choice]"));
                                                                            const managerSourceButtons = Array.from(document.querySelectorAll("[data-manager-source]"));
                                                                            const previousStepButton = document.getElementById("handoverPreviousStepButton");
                                                                            const nextStepButton = document.getElementById("handoverNextStepButton");
                                                                            const submitStepButton = document.getElementById("handoverSubmitButton");
                                                                            const existingManagerSelect = document.getElementById("Handover_ExistingManagerUsername");
                                                                            const newManagerUsernameInput = document.getElementById("Handover_NewManagerUsername");
                                                                            const newManagerFullNameInput = document.getElementById("Handover_NewManagerFullName");
                                                                            const newManagerPhoneInput = document.getElementById("Handover_NewManagerPhoneNumber");
                                                                            const previousRoleSelect = document.getElementById("Handover_PreviousManagerNewRole");
                                                                            const previousManagerTargetDepartmentSelect = document.getElementById("Handover_PreviousManagerTargetDepartmentId");
                                                                            const summaryAssignmentType = document.querySelector('[data-handover-summary="assignmentType"]');
                                                                            const summaryReplacementManager = document.querySelector('[data-handover-summary="replacementManager"]');
                                                                            const summaryExitAction = document.querySelector('[data-handover-summary="exitAction"]');
                                                                            const summaryTargetDepartment = document.querySelector('[data-handover-summary="targetDepartment"]');
                                                                            const automationExplanation = document.getElementById("handoverAutomationExplanation");
                                                                            let handoverCurrentStep = @selectedHandoverWizardStep;

                                                                            if (handoverModal && handoverModal.parentElement !== document.body) {
                                                                                document.body.appendChild(handoverModal);
                                                                            }

                                                                            function getVisibleValidationField(field) {
                                                                                if (!field) {
                                                                                    return null;
                                                                                }

                                                                                if (field.matches && field.matches("select[data-smart-select]")) {
                                                                                    const wrapper = field.closest("[data-smart-select-wrapper='true']");
                                                                                    return wrapper ? wrapper.querySelector(".smart-select-input") : field;
                                                                                }

                                                                                return field;
                                                                            }

                                                                            function getFieldMessageHost(field) {
                                                                                if (!field || !field.parentElement) {
                                                                                    return null;
                                                                                }

                                                                                return field.parentElement.querySelector(".field-validation-error, .field-validation-valid");
                                                                            }

                                                                            function clearValidationState(field) {
                                                                                const target = getVisibleValidationField(field);
                                                                                const messageHost = getFieldMessageHost(field);
                                                                                if (!target) {
                                                                                    return;
                                                                                }

                                                                                if (typeof target.setCustomValidity === "function") {
                                                                                    target.setCustomValidity("");
                                                                                }

                                                                                target.classList.remove("is-invalid");
                                                                                target.removeAttribute("aria-invalid");

                                                                                if (messageHost) {
                                                                                    messageHost.textContent = "";
                                                                                }
                                                                            }

                                                                            function showValidationState(field, message) {
                                                                                const target = getVisibleValidationField(field);
                                                                                const messageHost = getFieldMessageHost(field);
                                                                                if (!target) {
                                                                                    return false;
                                                                                }

                                                                                if (typeof target.setCustomValidity === "function") {
                                                                                    target.setCustomValidity(message);
                                                                                }

                                                                                target.classList.add("is-invalid");
                                                                                target.setAttribute("aria-invalid", "true");

                                                                                if (messageHost) {
                                                                                    messageHost.textContent = message;
                                                                                }

                                                                                if (target === field && typeof target.reportValidity === "function") {
                                                                                    target.reportValidity();
                                                                                }

                                                                                if (typeof target.focus === "function") {
                                                                                    target.focus();
                                                                                }

                                                                                return false;
                                                                            }

                                                                            function toggleVisibility(element, isVisible) {
                                                                                if (!element) {
                                                                                    return;
                                                                                }

                                                                                element.hidden = !isVisible;
                                                                            }

                                                                            function syncHandoverFormState() {
                                                                                const createNewManager = createNewManagerToggle && createNewManagerToggle.checked;
                                                                                const exitAction = exitActionSelect ? exitActionSelect.value : "";
                                                                                const isInternalTransfer = exitAction === "@DepartmentManagerExitActions.InternalTransfer";
                                                                                const isEndAssignment = exitAction === "@DepartmentManagerExitActions.EndAssignment";

                                                                                toggleVisibility(existingManagerFields, !createNewManager);
                                                                                toggleVisibility(newManagerFields, createNewManager);
                                                                                toggleVisibility(internalTransferFields, isInternalTransfer);
                                                                                toggleVisibility(previousRoleFields, isInternalTransfer || isEndAssignment);

                                                                                if (createNewManager) {
                                                                                    clearValidationState(existingManagerSelect);
                                                                                } else {
                                                                                    clearValidationState(newManagerUsernameInput);
                                                                                    clearValidationState(newManagerFullNameInput);
                                                                                    clearValidationState(newManagerPhoneInput);
                                                                                }

                                                                                if (!isInternalTransfer) {
                                                                                    clearValidationState(previousManagerTargetDepartmentSelect);
                                                                                }

                                                                                if (existingManagerSelect) {
                                                                                    existingManagerSelect.required = !createNewManager;
                                                                                }

                                                                                if (newManagerUsernameInput) {
                                                                                    newManagerUsernameInput.required = createNewManager;
                                                                                }

                                                                                if (newManagerFullNameInput) {
                                                                                    newManagerFullNameInput.required = createNewManager;
                                                                                }

                                                                                if (newManagerPhoneInput) {
                                                                                    newManagerPhoneInput.required = createNewManager;
                                                                                }

                                                                                if (previousManagerTargetDepartmentSelect) {
                                                                                    previousManagerTargetDepartmentSelect.required = isInternalTransfer;
                                                                                }

                                                                                assignmentChoiceButtons.forEach(function (button) {
                                                                                    const isActive = assignmentTypeSelect && button.dataset.assignmentChoice === assignmentTypeSelect.value;
                                                                                    button.classList.toggle("is-active", isActive);
                                                                                });

                                                                                managerSourceButtons.forEach(function (button) {
                                                                                    const source = button.dataset.managerSource;
                                                                                    button.classList.toggle("is-active", createNewManager ? source === "new" : source === "existing");
                                                                                });

                                                                                syncAutomationExplanation(exitAction);
                                                                                syncHandoverSummary();
                                                                            }

                                                                            function syncAutomationExplanation(exitAction) {
                                                                                if (!automationExplanation) {
                                                                                    return;
                                                                                }

                                                                                const messages = {
                                                                                    "@DepartmentManagerExitActions.Retirement": "يُسند القسم للمدير الجديد، وتُسحب صلاحيات الإدارة من المدير الحالي، ثم يُعطّل حسابه ويُحفظ في السجل بصفته متقاعدًا.",
                                                                                    "@DepartmentManagerExitActions.Resignation": "يُسند القسم للمدير الجديد، وتُسحب صلاحيات الإدارة من المدير الحالي، ثم يُعطّل حسابه ويُحفظ في السجل بصفته مستقيلًا.",
                                                                                    "@DepartmentManagerExitActions.ExternalTransfer": "يُسند القسم للمدير الجديد، وتُسحب صلاحيات الإدارة من المدير الحالي، ثم يُعطّل حسابه ويُحفظ كمنقول خارج الجهة.",
                                                                                    "@DepartmentManagerExitActions.InternalTransfer": "يُسند القسم للمدير الجديد، وتُسحب صلاحيات القسم الحالي من المدير السابق، ثم يُنقل إلى القسم والدور اللذين ستحددهما أدناه.",
                                                                                    "@DepartmentManagerExitActions.EndAssignment": "يُسند القسم للمدير الجديد، وتُسحب صلاحيات إدارة القسم من المدير السابق، ويبقى حسابه نشطًا داخل القسم بالدور الذي ستحدده."
                                                                                };

                                                                                automationExplanation.textContent = messages[exitAction]
                                                                                    || "لن ينفذ النظام أي تغيير قبل الضغط على زر تنفيذ نقل المدير في الخطوة الأخيرة.";
                                                                            }

                                                                            function syncHandoverSummary() {
                                                                                if (summaryAssignmentType && assignmentTypeSelect) {
                                                                                    summaryAssignmentType.textContent = assignmentTypeSelect.options[assignmentTypeSelect.selectedIndex]?.text || "لم يحدد بعد";
                                                                                }

                                                                                if (summaryReplacementManager) {
                                                                                    if (createNewManagerToggle && createNewManagerToggle.checked) {
                                                                                        const fullName = newManagerFullNameInput ? newManagerFullNameInput.value.trim() : "";
                                                                                        const username = newManagerUsernameInput ? newManagerUsernameInput.value.trim() : "";
                                                                                        summaryReplacementManager.textContent = fullName
                                                                                            ? (username ? `${fullName} (${username})` : fullName)
                                                                                            : (username || "لم يحدد بعد");
                                                                                    } else if (existingManagerSelect && existingManagerSelect.value) {
                                                                                        summaryReplacementManager.textContent = existingManagerSelect.options[existingManagerSelect.selectedIndex]?.text || "لم يحدد بعد";
                                                                                    } else {
                                                                                        summaryReplacementManager.textContent = "لم يحدد بعد";
                                                                                    }
                                                                                }

                                                                                if (summaryExitAction && exitActionSelect) {
                                                                                    summaryExitAction.textContent = exitActionSelect.options[exitActionSelect.selectedIndex]?.text || "لم يحدد بعد";
                                                                                }

                                                                                if (summaryTargetDepartment) {
                                                                                    if (
                                                                                        previousManagerTargetDepartmentSelect
                                                                                        && previousManagerTargetDepartmentSelect.value
                                                                                        && previousManagerTargetDepartmentSelect.value !== "0"
                                                                                    ) {
                                                                                        summaryTargetDepartment.textContent = previousManagerTargetDepartmentSelect.options[previousManagerTargetDepartmentSelect.selectedIndex]?.text || "غير مطلوب";
                                                                                    } else {
                                                                                        summaryTargetDepartment.textContent = "غير مطلوب";
                                                                                    }
                                                                                }
                                                                            }

                                                                            function setHandoverStep(step) {
                                                                                handoverCurrentStep = Math.min(3, Math.max(1, step));

                                                                                handoverStepPanels.forEach(function (panel) {
                                                                                    const panelStep = Number(panel.dataset.handoverStepPanel || "1");
                                                                                    panel.hidden = panelStep !== handoverCurrentStep;
                                                                                });

                                                                                handoverStepIndicators.forEach(function (indicator) {
                                                                                    const indicatorStep = Number(indicator.dataset.handoverStepIndicator || "1");
                                                                                    indicator.classList.toggle("is-active", indicatorStep === handoverCurrentStep);
                                                                                    indicator.classList.toggle("is-complete", indicatorStep < handoverCurrentStep);
                                                                                });

                                                                                if (handoverWizardStepInput) {
                                                                                    handoverWizardStepInput.value = String(handoverCurrentStep);
                                                                                }

                                                                                if (previousStepButton) {
                                                                                    previousStepButton.hidden = handoverCurrentStep === 1;
                                                                                }

                                                                                if (nextStepButton) {
                                                                                    nextStepButton.hidden = handoverCurrentStep >= 3;
                                                                                }

                                                                                if (submitStepButton) {
                                                                                    submitStepButton.hidden = handoverCurrentStep !== 3;
                                                                                }

                                                                                syncHandoverSummary();
                                                                            }

                                                                            function validateHandoverStep(step) {
                                                                                if (step === 1) {
                                                                                    return true;
                                                                                }

                                                                                if (step === 2) {
                                                                                    if (createNewManagerToggle && createNewManagerToggle.checked) {
                                                                                        if (newManagerUsernameInput && !newManagerUsernameInput.value.trim()) {
                                                                                            newManagerUsernameInput.reportValidity();
                                                                                            newManagerUsernameInput.focus();
                                                                                            return false;
                                                                                        }

                                                                                        if (newManagerFullNameInput && !newManagerFullNameInput.value.trim()) {
                                                                                            newManagerFullNameInput.reportValidity();
                                                                                            newManagerFullNameInput.focus();
                                                                                            return false;
                                                                                        }

                                                                                        if (newManagerPhoneInput && !newManagerPhoneInput.value.trim()) {
                                                                                            newManagerPhoneInput.reportValidity();
                                                                                            newManagerPhoneInput.focus();
                                                                                            return false;
                                                                                        }

                                                                                        return true;
                                                                                    }

                                                                                    if (existingManagerSelect && !existingManagerSelect.value.trim()) {
                                                                                        return showValidationState(existingManagerSelect, "اختر المدير الجديد من القائمة.");
                                                                                    }

                                                                                    return true;
                                                                                }

                                                                                if (
                                                                                    step === 3
                                                                                    && exitActionSelect
                                                                                    && exitActionSelect.value === "@DepartmentManagerExitActions.InternalTransfer"
                                                                                    && previousManagerTargetDepartmentSelect
                                                                                    && previousManagerTargetDepartmentSelect.value === "0"
                                                                                ) {
                                                                                    return showValidationState(previousManagerTargetDepartmentSelect, "اختر القسم الهدف للنقل الداخلي.");
                                                                                }

                                                                                return true;
                                                                            }

                                                                            if (createNewManagerToggle) {
                                                                                createNewManagerToggle.addEventListener("change", syncHandoverFormState);
                                                                            }

                                                                            if (exitActionSelect) {
                                                                                exitActionSelect.addEventListener("change", syncHandoverFormState);
                                                                            }

                                                                            if (assignmentTypeSelect) {
                                                                                assignmentTypeSelect.addEventListener("change", syncHandoverFormState);
                                                                            }

                                                                            assignmentChoiceButtons.forEach(function (button) {
                                                                                button.addEventListener("click", function () {
                                                                                    if (!assignmentTypeSelect) {
                                                                                        return;
                                                                                    }

                                                                                    assignmentTypeSelect.value = button.dataset.assignmentChoice || assignmentTypeSelect.value;
                                                                                    assignmentTypeSelect.dispatchEvent(new Event("change", { bubbles: true }));
                                                                                });
                                                                            });

                                                                            managerSourceButtons.forEach(function (button) {
                                                                                button.addEventListener("click", function () {
                                                                                    if (!createNewManagerToggle) {
                                                                                        return;
                                                                                    }

                                                                                    createNewManagerToggle.checked = button.dataset.managerSource === "new";
                                                                                    createNewManagerToggle.dispatchEvent(new Event("change", { bubbles: true }));
                                                                                });
                                                                            });

                                                                            [existingManagerSelect, newManagerUsernameInput, newManagerFullNameInput, newManagerPhoneInput, previousRoleSelect, previousManagerTargetDepartmentSelect].forEach(function (field) {
                                                                                if (!field) {
                                                                                    return;
                                                                                }

                                                                                field.addEventListener("change", function () {
                                                                                    clearValidationState(field);
                                                                                });
                                                                                field.addEventListener("input", function () {
                                                                                    clearValidationState(field);
                                                                                });
                                                                                field.addEventListener("change", syncHandoverSummary);
                                                                                field.addEventListener("input", syncHandoverSummary);
                                                                            });

                                                                            handoverStepIndicators.forEach(function (indicator) {
                                                                                indicator.addEventListener("click", function () {
                                                                                    const nextStep = Number(indicator.dataset.handoverStepIndicator || handoverCurrentStep);
                                                                                    if (nextStep <= handoverCurrentStep || validateHandoverStep(handoverCurrentStep)) {
                                                                                        setHandoverStep(nextStep);
                                                                                    }
                                                                                });
                                                                            });

                                                                            if (previousStepButton) {
                                                                                previousStepButton.addEventListener("click", function () {
                                                                                    setHandoverStep(handoverCurrentStep - 1);
                                                                                });
                                                                            }

                                                                            if (nextStepButton) {
                                                                                nextStepButton.addEventListener("click", function () {
                                                                                    if (validateHandoverStep(handoverCurrentStep)) {
                                                                                        setHandoverStep(handoverCurrentStep + 1);
                                                                                    }
                                                                                });
                                                                            }

                                                                            if (handoverForm) {
                                                                                handoverForm.addEventListener("submit", function (event) {
                                                                                    syncHandoverFormState();

                                                                                    if (!validateHandoverStep(2)) {
                                                                                        event.preventDefault();
                                                                                        setHandoverStep(2);
                                                                                        return;
                                                                                    }

                                                                                    if (!validateHandoverStep(3)) {
                                                                                        event.preventDefault();
                                                                                        setHandoverStep(3);
                                                                                    }
                                                                                });
                                                                            }

                                                                            syncHandoverFormState();
                                                                            setHandoverStep(@selectedHandoverWizardStep);

                                                                            if (handoverModal && @openManagerHandoverModal.ToString().ToLowerInvariant()) {
                                                                                if (window.bootstrap && bootstrap.Modal) {
                                                                                    bootstrap.Modal.getOrCreateInstance(handoverModal).show();
                                                                                }
                                                                            }
                                                                        });
                                                                    </script>
                                                                }
