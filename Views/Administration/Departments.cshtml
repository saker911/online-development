                                                <div class="modal-body">
                                                    <div asp-validation-summary="ModelOnly" class="visually-hidden form-summary-only"></div>

                                                    <div class="manager-handover-stepper" id="managerHandoverStepper">
                                                        <div class="manager-handover-step" data-handover-step-indicator="1">
