                                            var iconClass = item.Category switch
                                            {
                                                NotificationCategories.Security => "notif-ic-red",
                                                NotificationCategories.Visit => "notif-ic-blue",
                                                NotificationCategories.Permit => "notif-ic-green",
                                                _ => "notif-ic-purple",
                                            };
