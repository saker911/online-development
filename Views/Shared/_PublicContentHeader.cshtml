<header class="public-content-header public-landing-nav">
    <a asp-controller="Home" asp-action="Index" class="public-content-brand public-landing-brand" aria-label="العودة إلى @ProductIdentity.DisplayName">
        <img src="~/icons/app-icon-192.png" alt="" />
        <span><strong>@ProductIdentity.DisplayName</strong><small>@ProductIdentity.Description</small></span>
    </a>
    <nav class="public-landing-nav-links" aria-label="صفحات المعلومات">
        <a asp-controller="Home" asp-action="About">المنتج</a>
        <a asp-controller="Home" asp-action="Guide">الدليل</a>
        <a asp-controller="Home" asp-action="Security">الأمان</a>
        <a asp-controller="Home" asp-action="Establishment">المنشأة والتواصل</a>
        <a asp-controller="Subscription" asp-action="Plans">الباقات</a>
    </nav>
    <div class="public-content-actions public-landing-nav-actions">
        @await Html.PartialAsync("~/Views/Shared/_PublicThemeToggle.cshtml")
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">تسجيل الدخول</a>
        <a asp-controller="Subscription" asp-action="Plans" class="btn btn-primary">ابدأ الآن</a>
    </div>
</header>
