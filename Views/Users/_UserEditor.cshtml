@using System.Text.Json
@using VehiclePermitSystemWeb.Security
@model VehiclePermitSystemWeb.Models.ViewModels.Users.UserEditViewModel

@{
    var isCreateRoute = string.Equals(
        ViewContext.RouteData.Values["Action"]?.ToString(),
        "Create",
        StringComparison.OrdinalIgnoreCase
    );
    var isNew = isCreateRoute || string.IsNullOrWhiteSpace(Model.OriginalUsername);
    var isSimplifiedCreate = isNew && !Model.IsSuperAdmin;
    var editedUsername = string.IsNullOrWhiteSpace(Model.OriginalUsername)
        ? Model.Username
        : Model.OriginalUsername;
    var isEditingCurrentUser = !isNew
        && string.Equals(editedUsername, User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
    var canEditAdministrativeFields = isNew || !isEditingCurrentUser;
    var canManageOwnGateSettings = isEditingCurrentUser && Model.CanScanOperations;
    var showGateSettingsSection = canEditAdministrativeFields || canManageOwnGateSettings;
    var usernameLabel = Model.IsSuperAdmin ? "معرف مالك النظام" : "اسم المستخدم";
    var resetTemporaryPasswordUrl = Url.Action("ResetTemporaryPassword", "Users", new { id = Model.Username }) ?? string.Empty;
    var resetTemporaryOperatorPinUrl = Url.Action("ResetTemporaryOperatorPin", "Users", new { id = Model.Username }) ?? string.Empty;
    var currentRoleDisplay = AppRoles.GetDisplayName(Model.Role, Model.IsSuperAdmin);
    var currentDepartmentDisplay = string.IsNullOrWhiteSpace(Model.Department) ? "غير مرتبط" : Model.Department;
    var selectedTenant = Model.TenantOptions.FirstOrDefault(tenant =>
        string.Equals(tenant.TenantId, Model.TenantId, StringComparison.OrdinalIgnoreCase));
    var currentTenantDisplay = selectedTenant?.Name
        ?? (string.IsNullOrWhiteSpace(Model.TenantId) ? "الجهة الحالية" : Model.TenantId);
    var administrativeFieldCount = Model.CanChooseTenant ? "4" : Model.IsSuperAdmin ? "2" : "3";
    var canPrintUserBadge = !isNew && !string.IsNullOrWhiteSpace(Model.Username);
    var canManageOperatorBadge = !isNew && Model.CanScanOperations;
    var createFlowReturnUrl = ViewData["CreateFlowReturnUrl"] as string;
    var cancelUrl = isNew && !string.IsNullOrWhiteSpace(createFlowReturnUrl)
        ? createFlowReturnUrl
        : (Url.Action("Index", "Users") ?? "/Users");
    var permissionGroups = AppPermissions.EditorGroups;
    var totalPermissions = AppPermissions.TotalPermissionCount;
    var grantedPermissionsCount = permissionGroups
        .SelectMany(group => group.Permissions)
        .Count(permission => IsPermissionGranted(Model, permission.UserFlagPropertyName));
    var orderedRoleOptions = AppRoles
        .OrderedRoles
        .Where(role => !isSimplifiedCreate || !new[] { AppRoles.Employee, AppRoles.Manager, AppRoles.GeneralManager }.Contains(role, StringComparer.OrdinalIgnoreCase))
        .Select(role => new { Value = role, Text = AppRoles.GetDisplayName(role) })
        .ToList();
    var rolePermissionDefaults = AppRoles.OrderedRoles.ToDictionary(
        role => role,
        role =>
        {
            var roleUser = new UserAccount { Role = role };
            AppPermissions.ApplyRoleDefaults(roleUser);
            return permissionGroups
                .SelectMany(group => group.Permissions)
                .Where(permission =>
                    typeof(UserAccount).GetProperty(permission.UserFlagPropertyName)?.GetValue(roleUser) is true)
                .Select(permission => permission.UserFlagPropertyName)
                .ToArray();
        }
    );
    var rolePermissionDefaultsJson = JsonSerializer.Serialize(rolePermissionDefaults);
    var wizardSteps = isSimplifiedCreate
        ? new[]
        {
            new { Number = 1, Title = "البيانات", Description = "الاسم وبيانات التواصل" },
            new { Number = 2, Title = "الدور", Description = "مهمة المستخدم وموقعه" },
            new { Number = 3, Title = "الدخول", Description = "الاعتماد والحفظ" },
        }
        : new[]
        {
            new { Number = 1, Title = "الحساب", Description = "الاسم، المعرف، وبيانات التواصل" },
            new { Number = 2, Title = "الإدارة", Description = "الدور، القسم، والربط الإداري" },
            new { Number = 3, Title = "الاعتماد", Description = "كلمة المرور وإعدادات البوابة" },
            new { Number = 4, Title = "الصلاحيات", Description = "الصلاحيات والمراجعة النهائية" },
        };
    var activeWizardStep = Model.WizardStep < 1
        ? 1
        : Model.WizardStep > wizardSteps.Length
            ? wizardSteps.Length
            : Model.WizardStep;
    var generalManagerAdministrationName = ViewData["GeneralManagerAdministrationName"] as string ?? string.Empty;
    var generalManagerAdministrationOrganization = ViewData["GeneralManagerAdministrationOrganization"] as string ?? string.Empty;
    var canAssignGeneralManager = ViewData["CanAssignGeneralManager"] as bool? ?? false;
    var currentGeneralManagerName = ViewData["CurrentGeneralManagerName"] as string ?? string.Empty;
    var currentGeneralManagerUsername = ViewData["CurrentGeneralManagerUsername"] as string ?? string.Empty;
    var currentGeneralManagerActionSummary = ViewData["CurrentGeneralManagerActionSummary"] as string ?? string.Empty;
}

@functions {
    private static bool IsPermissionGranted(VehiclePermitSystemWeb.Models.ViewModels.Users.UserEditViewModel model, string propertyName)
    {
        var property = typeof(VehiclePermitSystemWeb.Models.ViewModels.Users.UserEditViewModel).GetProperty(propertyName);
        return property?.PropertyType == typeof(bool) && property.GetValue(model) is true;
    }
}

<div class="users-editor-shell">
    @if (Model.IsSuperAdmin)
    {
        <div class="ue-inline-note ue-inline-note-info">حساب مالك النظام بصلاحيات سيادية.</div>
    }

    @Html.AntiForgeryToken()
    <input asp-for="OriginalUsername" type="hidden" />
    <input asp-for="WizardStep" type="hidden" id="users-wizard-step" />
    <input asp-for="LookupStatus" type="hidden" id="users-lookup-status" />
    <input asp-for="LookupMessage" type="hidden" id="users-lookup-message" />
    <input asp-for="LookupRedirectUrl" type="hidden" id="users-lookup-redirect-url" />
    <input asp-for="LookupReactivateUrl" type="hidden" id="users-lookup-reactivate-url" />
    <input asp-for="PendingPermitsCount" type="hidden" id="users-pending-permits-count" />
    <input asp-for="IsSuperAdmin" type="hidden" id="users-is-super-admin" />
    @if (!Model.CanChooseTenant)
    {
        <input asp-for="TenantId" type="hidden" />
    }
    <div asp-validation-summary="ModelOnly" class="visually-hidden ue-form-summary"></div>

    <div class="ue-wizard-shell" data-users-wizard-shell>
        <div class="ue-wizard-stepper" role="tablist" aria-label="معالج المستخدم">
            @foreach (var step in wizardSteps)
            {
                <button type="button"
                        class="ue-wizard-step @(activeWizardStep == step.Number ? "is-active" : activeWizardStep > step.Number ? "is-complete" : string.Empty)"
                        data-users-wizard-step-jump="@step.Number">
                    <span class="ue-wizard-step-number">@step.Number</span>
                    <span class="ue-wizard-step-copy">
                        <strong>@step.Title</strong>
                        <small>@step.Description</small>
                    </span>
                </button>
            }
        </div>
    </div>

    @if (!isSimplifiedCreate)
    {
    <div class="ue-wizard-ux-grid">
        <section class="ue-wizard-summary app-card-surface" aria-live="polite">
            <div class="ue-card-title">
                <span class="ue-card-icon ue-icon-account">✨</span>
                <h2>ملخص حي</h2>
            </div>
            <div class="ue-summary-grid">
                <div class="ue-summary-item">
                    <span>الاسم</span>
                    <strong data-users-summary-full-name>غير مُدخل</strong>
                </div>
                <div class="ue-summary-item">
                    <span>المعرف الداخلي</span>
                    <strong class="ltr-field" data-users-summary-username>غير مُدخل</strong>
                </div>
                <div class="ue-summary-item">
                    <span>الدور</span>
                    <strong data-users-summary-role>@currentRoleDisplay</strong>
                </div>
                <div class="ue-summary-item">
                    <span>الجهة</span>
                    <strong data-users-summary-tenant>@currentTenantDisplay</strong>
                </div>
                <div class="ue-summary-item">
                    <span>القسم</span>
                    <strong data-users-summary-department>@currentDepartmentDisplay</strong>
                </div>
                @if (!isSimplifiedCreate)
                {
                    <div class="ue-summary-item">
                        <span>مدير القسم</span>
                        <strong data-users-summary-department-manager>غير مرتبط</strong>
                    </div>
                }
                <div class="ue-summary-item">
                    <span>الصلاحيات</span>
                    <strong data-users-summary-permissions>@grantedPermissionsCount صلاحية</strong>
                </div>
            </div>
        </section>

        <section class="ue-wizard-validation app-card-surface" data-users-wizard-errors hidden aria-live="polite">
            <div class="ue-card-title">
                <span class="ue-card-icon ue-icon-perm">⚠️</span>
                <h2>مطلوب قبل المتابعة</h2>
            </div>
            <div class="ue-wizard-validation-body">
                <p class="ue-wizard-validation-text" data-users-wizard-error-text>أكمل الحقول المطلوبة في هذه الخطوة.</p>
                <ul class="ue-wizard-validation-list" data-users-wizard-error-list></ul>
            </div>
        </section>
    </div>
    }

    <div class="ue-card app-card-surface" data-users-panel-container>
        <div class="ue-card-title">
            <span class="ue-card-icon ue-icon-account">👤</span>
            <h2>بيانات الحساب</h2>
        </div>
        @if (isNew)
            {
                <div class="ue-fields-row ue-fields-4 ue-account-primary-row ue-wizard-panel @(activeWizardStep == 1 ? string.Empty : "is-hidden")" data-users-wizard-panel="1">
                    <div class="ue-field">
                        <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="field-validation-error small"></span>
                    </div>
                    <div class="ue-field ue-field-required">
                        <label asp-for="Username" class="form-label">المعرف الداخلي</label>
                        <input asp-for="Username" class="form-control ltr-field" inputmode="numeric" autocomplete="username" minlength="10"
                               maxlength="10" pattern="[12][0-9]{9}" placeholder="1023456789" title="المعرف الداخلي يجب أن يكون 10 أرقام ويبدأ بـ 1 أو 2" required />
                        <span asp-validation-for="Username" class="field-validation-error small"></span>
                    </div>
                    <div class="ue-field">
                        <label asp-for="PhoneNumber" class="form-label">الجوال</label>
                        <input asp-for="PhoneNumber" class="form-control ltr-field" inputmode="numeric" autocomplete="tel" maxlength="10"
                               pattern="05[0-9]{8}" placeholder="0501234567" title="رقم الجوال يجب أن يكون 10 أرقام ويبدأ بـ 05" required />
                        <span asp-validation-for="PhoneNumber" class="field-validation-error small"></span>
                    </div>
                    <div class="ue-field">
                        <label asp-for="JobTitle" class="form-label">المسمى الوظيفي</label>
                        <input asp-for="JobTitle" class="form-control" />
                        <span asp-validation-for="JobTitle" class="field-validation-error small"></span>
                    </div>
                </div>
                <div class="ue-fields-row ue-fields-2 ue-wizard-panel @(activeWizardStep == 1 ? string.Empty : "is-hidden")" data-users-wizard-panel="1">
                    <div class="ue-field">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="form-control ltr-field" inputmode="email" autocomplete="email" />
                        <span asp-validation-for="Email" class="field-validation-error small"></span>
                    </div>
                    <div class="ue-field">
                        <label asp-for="EmployeeNumber" class="form-label">رقم الموظف</label>
                        <input asp-for="EmployeeNumber" class="form-control ltr-field" autocomplete="off" />
                        <span asp-validation-for="EmployeeNumber" class="field-validation-error small"></span>
                    </div>
                </div>
            }
            else if (isEditingCurrentUser)
            {
                <input asp-for="FullName" type="hidden" />
                <input asp-for="Username" type="hidden" />
                <input asp-for="PhoneNumber" type="hidden" />
                <input asp-for="JobTitle" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <input asp-for="EmployeeNumber" type="hidden" />
                <input asp-for="UserType" type="hidden" />

                <div class="ue-fields-row ue-fields-3 ue-account-primary-row ue-account-readonly-row ue-wizard-panel @(activeWizardStep == 1 ? string.Empty : "is-hidden")" data-users-wizard-panel="1">
                    <div class="ue-field">
                        <label class="form-label">الاسم الكامل</label>
                        <div class="ue-readonly-info-card ue-readonly-identity-card">
                            <span class="ue-readonly-role-kicker">بيانات العرض</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</strong>
                        </div>
                    </div>
                    <div class="ue-field">
                        <label class="form-label">الجوال</label>
                        <div class="ue-readonly-info-card ue-readonly-identity-card">
                            <span class="ue-readonly-role-kicker">بيانات الاتصال</span>
                            <strong class="ltr-field">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</strong>
                        </div>
                    </div>
                    <div class="ue-field">
                        <label class="form-label">المسمى الوظيفي</label>
                        <div class="ue-readonly-info-card ue-readonly-identity-card">
                            <span class="ue-readonly-role-kicker">المسمى الحالي</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.JobTitle) ? "-" : Model.JobTitle)</strong>
                        </div>
                    </div>
                </div>
                <div class="ue-fields-row ue-fields-2 ue-account-secondary-row ue-wizard-panel @(activeWizardStep == 1 ? string.Empty : "is-hidden")" data-users-wizard-panel="1">
                    <div class="ue-field">
                        <label class="form-label">البريد الإلكتروني</label>
                        <div class="ue-readonly-info-card ue-readonly-identity-card">
                            <span class="ue-readonly-role-kicker">بيانات التواصل</span>
                            <strong class="ltr-field">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</strong>
                        </div>
                    </div>
                    <div class="ue-field">
                        <label class="form-label">رقم الموظف</label>
                        <div class="ue-readonly-info-card ue-readonly-identity-card">
                            <span class="ue-readonly-role-kicker">الرقم الداخلي</span>
                            <strong class="ltr-field">@(string.IsNullOrWhiteSpace(Model.EmployeeNumber) ? "-" : Model.EmployeeNumber)</strong>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="ue-fields-row ue-fields-3 ue-account-primary-row ue-wizard-panel @(activeWizardStep == 1 ? string.Empty : "is-hidden")" data-users-wizard-panel="1">
                    <div class="ue-field">
                        <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="field-validation-error small"></span>
                    </div>
                    @if (Model.IsSuperAdmin)
                    {
                        <div class="ue-field ue-field-required">
                            <label asp-for="Username" class="form-label">@usernameLabel</label>
                            <input asp-for="Username" class="form-control ltr-field" inputmode="numeric" autocomplete="username" minlength="10"
                                maxlength="10" pattern="[12][0-9]{9}" placeholder="1023456789" title="المعرف الداخلي يجب أن يكون 10 أرقام ويبدأ بـ 1 أو 2" required />
                            <div class="form-text">يمكن تغييره لهذا الحساب فقط، بشرط أن يكون معرفًا داخليًا من 10 أرقام ويبدأ بـ 1 أو 2 وفريدًا.</div>
                            <span asp-validation-for="Username" class="field-validation-error small"></span>
                        </div>
                    }
                    else
                    {
                        <input asp-for="Username" type="hidden" />
                    }
                    <div class="ue-field">
                        <label asp-for="PhoneNumber" class="form-label">الجوال</label>
                        <input asp-for="PhoneNumber" class="form-control ltr-field" inputmode="numeric" autocomplete="tel" maxlength="10"
                               pattern="05[0-9]{8}" placeholder="0501234567" title="رقم الجوال يجب أن يكون 10 أرقام ويبدأ بـ 05" required />
                        <span asp-validation-for="PhoneNumber" class="field-validation-error small"></span>
                    </div>
                    <div class="ue-field">
                        <label asp-for="JobTitle" class="form-label">المسمى الوظيفي</label>
                        <input asp-for="JobTitle" class="form-control" />
                        <span asp-validation-for="JobTitle" class="field-validation-error small"></span>
                    </div>
                </div>
                <div class="ue-fields-row ue-fields-2 ue-wizard-panel @(activeWizardStep == 1 ? string.Empty : "is-hidden")" data-users-wizard-panel="1">
                    <div class="ue-field">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="form-control ltr-field" inputmode="email" autocomplete="off"
                               data-form-persist-ignore data-server-authoritative-value="@Model.Email" data-browser-autofill-block-value="@Model.Username" />
                        <span asp-validation-for="Email" class="field-validation-error small"></span>
                    </div>
                    <div class="ue-field">
                        <label asp-for="EmployeeNumber" class="form-label">رقم الموظف</label>
                        <input asp-for="EmployeeNumber" class="form-control ltr-field" autocomplete="off" />
                        <span asp-validation-for="EmployeeNumber" class="field-validation-error small"></span>
                    </div>
                </div>
            }

            <div class="ue-identity-lookup-row ue-wizard-panel @(activeWizardStep == 1 ? string.Empty : "is-hidden")" data-users-wizard-panel="1">
                <p class="ue-inline-hint" data-users-lookup-result aria-live="polite" hidden></p>
                @if (isNew)
                {
                    <div class="ue-identity-lookup-actions">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="users-identity-lookup-btn">فحص المعرف</button>
                        <button type="button" class="btn btn-outline-warning btn-sm" id="users-reactivate-btn" hidden>إعادة التفعيل</button>
                    </div>
                }
            </div>

            @if (canEditAdministrativeFields)
            {
                <div class="ue-fields-row ue-account-admin-row ue-fields-@administrativeFieldCount ue-wizard-panel @(activeWizardStep == 2 ? string.Empty : "is-hidden")" data-users-wizard-panel="2">
                    @if (Model.CanChooseTenant)
                    {
                        <div class="ue-field">
                            <label asp-for="TenantId" class="form-label">الجهة</label>
                            <select asp-for="TenantId" class="form-select" id="users-tenant-select" required>
                                @foreach (var tenant in Model.TenantOptions)
                                {
                                    if (tenant.IsActive)
                                    {
                                        <option value="@tenant.TenantId">@tenant.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@tenant.TenantId" disabled>@($"{tenant.Name} - موقوفة")</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="TenantId" class="field-validation-error small"></span>
                        </div>
                    }
                    <div class="ue-field ue-field-status">
                        <label class="form-label">حالة المستخدم</label>
                        @if (Model.IsSuperAdmin)
                        {
                            <input asp-for="IsActive" type="hidden" />
                            <div class="ue-readonly-info-card ue-readonly-info-card-success">
                                <span class="ue-readonly-role-kicker">الحالة السيادية</span>
                                <strong>نشط دائمًا</strong>
                            </div>
                        }
                        else if (isSimplifiedCreate)
                        {
                            <input asp-for="IsActive" type="hidden" />
                            <div class="ue-readonly-info-card ue-readonly-info-card-success">
                                <span class="ue-readonly-role-kicker">حالة الحساب</span>
                                <strong>نشط</strong>
                            </div>
                        }
                        else
                        {
                            <label class="ue-status-switch ue-toggle-card @(Model.IsActive ? "is-active" : "is-inactive")">
                                <input asp-for="IsActive" class="form-check-input" id="users-is-active" />
                                <span class="ue-toggle-card-copy">
                                    <strong>تنشيط / إيقاف</strong>
                                    <small id="users-status-label">@(Model.IsActive ? "الحساب نشط" : "الحساب موقوف")</small>
                                </span>
                            </label>
                        }
                    </div>
                    <div class="ue-field">
                        @if (Model.IsSuperAdmin)
                        {
                            <input asp-for="Role" type="hidden" />
                            <div class="form-label">الدور</div>
                            <div class="ue-readonly-role-card">
                                <span class="ue-readonly-role-kicker">الدور الثابت</span>
                                <strong>مالك النظام</strong>
                                <small>هذا المسمى سيادي وغير قابل للتغيير لهذا الحساب.</small>
                            </div>
                        }
                        else
                        {
                            <label for="users-role-select" class="form-label">الدور</label>
                            <select asp-for="Role" class="form-select" id="users-role-select" required>
                                @foreach (var roleOption in orderedRoleOptions)
                                {
                                    <option value="@roleOption.Value">@roleOption.Text</option>
                                }
                            </select>
                        }
                        <span asp-validation-for="Role" class="field-validation-error small"></span>
                    </div>
                    @if (!Model.IsSuperAdmin)
                    {
                        <div class="ue-field" id="users-department-field">
                            <label for="users-department-select" class="form-label">الموقع أو القسم</label>
                                <select asp-for="Department" class="form-select" id="users-department-select"
                                    data-smart-select="true" data-smart-select-placeholder="ابحث عن القسم أو اختره">
                                <option value="">-- اختر القسم --</option>
                                @foreach (var department in Model.DepartmentOptions)
                                {
                                    var departmentManagerSummary = Model.DepartmentManagerSummaryByName.TryGetValue(department, out var summary)
                                        ? summary
                                        : string.Empty;
                                    <option value="@department"
                                            data-manager-summary="@departmentManagerSummary"
                                            selected="@(string.Equals(Model.Department, department, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                        @department</option>
                                    }
                                </select>
                                <div class="form-text" id="users-department-scope-note" hidden></div>
                                <div class="ue-inline-note ue-inline-note-info" id="users-department-manager-note" hidden></div>
                                <span asp-validation-for="Department" class="field-validation-error small"></span>
                            </div>
                    }
                </div>
            }
            else
            {
                <div class="ue-fields-row ue-account-admin-row ue-admin-snapshot-row ue-wizard-panel @(activeWizardStep == 2 ? string.Empty : "is-hidden")" data-users-wizard-panel="2">
                    <div class="ue-field ue-field-status">
                        <label class="form-label">حالة المستخدم</label>
                        <div class="ue-readonly-info-card ue-readonly-info-card-success">
                            <span class="ue-readonly-role-kicker">الحالة الحالية</span>
                            <strong>@(Model.IsActive ? "نشط" : "موقوف")</strong>
                            <small>تعرض للقراءة فقط داخل حسابك الشخصي.</small>
                        </div>
                    </div>
                    <div class="ue-field">
                        <label class="form-label">الدور</label>
                        <div class="ue-readonly-role-card">
                            <span class="ue-readonly-role-kicker">الدور الحالي</span>
                            <strong>@currentRoleDisplay</strong>
                            <small>لا يمكن تغيير الدور من شاشة حسابك.</small>
                        </div>
                    </div>
                    <div class="ue-field">
                        <label class="form-label">القسم</label>
