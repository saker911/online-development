                                                                                                                            const liveSummaryRole = document.querySelector("[data-users-summary-role]");
                                                                                                                            const liveSummaryTenant = document.querySelector("[data-users-summary-tenant]");
                                                                                                                            const liveSummaryDepartment = document.querySelector("[data-users-summary-department]");
                                                                                                                            const liveSummaryDepartmentManager = document.querySelector("[data-users-summary-department-manager]");
                                                                                                                            const liveSummaryPermissions = document.querySelector("[data-users-summary-permissions]");
                                                                                                                            const wizardValidationBox = document.querySelector("[data-users-wizard-errors]");
                                                                                                                            const wizardValidationText = document.querySelector("[data-users-wizard-error-text]");
                                                                                                                            const wizardValidationList = document.querySelector("[data-users-wizard-error-list]");
                                                                                                                            const departmentManagerNote = document.getElementById("users-department-manager-note");
                                                                                                                            const tenantSelect = document.getElementById("users-tenant-select");
                                                                                                                            const departmentOptions = Array.from(document.querySelectorAll("#users-department-select option"));
                                                                                                                            const validationRequestedSteps = new Set();
                                                                                                                        function updateWizardSaveNote(message) {
                                                                                                                            if (!wizardSaveNote) {
                                                                                                                                return;
                                                                                                                            }

                                                                                                                            wizardSaveNote.textContent = message || "تم حفظ مسودة التسجيل تلقائيًا داخل هذا المتصفح.";
                                                                                                                        }

                                                                                                                        const roleDisplayMap = {
                                                                                                                            "@AppRoles.SystemAdmin": "مشرف نظام",
                                                                                                                            "@AppRoles.SecurityManager": "مدير الأمن",
                                                                                                                            "@AppRoles.PermitReviewer": "مدقق التصاريح",
                                                                                                                            "@AppRoles.GeneralManager": "مدير عام",
                                                                                                                            "@AppRoles.Manager": "مدير",
                                                                                                                            "@AppRoles.Employee": "موظف",
                                                                                                                            "@AppRoles.GateSecurity": "مأمور بوابة",
                                                                                                                            "@AppRoles.Receptionist": "موظف إدخال"
                                                                                                                        };

                                                                                                                        function applyRolePermissionDefaults(roleValue) {
                                                                                                                            const grantedPermissions = new Set(rolePermissionDefaults[roleValue] || []);
                                                                                                                            permInputs.forEach(function (input) {
                                                                                                                                input.checked = grantedPermissions.has(input.name);
                                                                                                                            });
                                                                                                                            refreshCounts();
                                                                                                                            refreshGroupToggles();
                                                                                                                            updateLiveSummary();
                                                                                                                            syncStepperState();
                                                                                                                        }

                                                                                                                        // === Accordion toggle ===
                                                                                                                        document.querySelectorAll("[data-toggle-group]").forEach(function (head) {
                                                                                                                            head.addEventListener("click", function (e) {
                                                                                                                                if (e.target.closest(".ue-group-switch")) return;
                                                                                                                                const groupName = head.getAttribute("data-toggle-group");
                                                                                                                                const body = document.querySelector('[data-group-body="' + groupName + '"]');
                                                                                                                                const arrow = head.querySelector(".ue-perm-arrow");
                                                                                                                                const isOpen = body.classList.toggle("ue-open");
                                                                                                                                arrow.classList.toggle("ue-arrow-open", isOpen);
                                                                                                                            });
                                                                                                                        });

                                                                                                                        // === Group toggle-all ===
                                                                                                                        document.querySelectorAll(".ue-group-toggle").forEach(function (toggle) {
                                                                                                                            toggle.addEventListener("change", function () {
                                                                                                                                const groupName = toggle.getAttribute("data-group-toggle");
                                                                                                                                const members = document.querySelectorAll('[data-group-member="' + groupName + '"]');
                                                                                                                                members.forEach(function (m) { m.checked = toggle.checked; });
                                                                                                                                refreshCounts();
                                                                                                                            });
                                                                                                                        });

                                                                                                                        // === Individual permission change ===
                                                                                                                        permInputs.forEach(function (input) {
                                                                                                                            input.addEventListener("change", function () {
                                                                                                                                refreshCounts();
                                                                                                                                refreshGroupToggles();
                                                                                                                                    updateLiveSummary();
                                                                                                                                    syncStepperState();
                                                                                                                            });
                                                                                                                        });

                                                                                                                        // === Search ===
                                                                                                                        var searchInput = document.getElementById("ue-perm-search");
                                                                                                                        if (searchInput) {
                                                                                                                            searchInput.addEventListener("input", function () {
                                                                                                                                var q = searchInput.value.trim().toLowerCase();
                                                                                                                                document.querySelectorAll(".ue-perm-item").forEach(function (item) {
                                                                                                                                    var name = (item.getAttribute("data-perm-name") || "").toLowerCase();
                                                                                                                                    item.style.display = (!q || name.includes(q)) ? "" : "none";
                                                                                                                                });
                                                                                                                                // Show all groups that have visible items
                                                                                                                                document.querySelectorAll(".ue-perm-group").forEach(function (group) {
                                                                                                                                    var body = group.querySelector("[data-group-body]");
                                                                                                                                    var hasVisible = Array.from(body.querySelectorAll(".ue-perm-item")).some(function (i) { return i.style.display !== "none"; });
                                                                                                                                    group.style.display = hasVisible ? "" : "none";
                                                                                                                                    if (q && hasVisible) {
                                                                                                                                        body.classList.add("ue-open");
                                                                                                                                        group.querySelector(".ue-perm-arrow").classList.add("ue-arrow-open");
                                                                                                                                    }
                                                                                                                                });
                                                                                                                            });
                                                                                                                        }

                                                                                                                        // === Template button (select all / deselect all) ===
                                                                                                                        var templateBtn = document.getElementById("ue-select-template-btn");
                                                                                                                        if (templateBtn) {
                                                                                                                            templateBtn.addEventListener("click", function () {
                                                                                                                                var allChecked = permInputs.every(function (i) { return i.checked; });
                                                                                                                                permInputs.forEach(function (i) { i.checked = !allChecked; });
                                                                                                                                refreshCounts();
                                                                                                                                refreshGroupToggles();
                                                                                                                            });
                                                                                                                        }

                                                                                                                        if (resetRoleDefaultsButton) {
                                                                                                                            resetRoleDefaultsButton.addEventListener("click", function () {
                                                                                                                                applyRolePermissionDefaults(roleSelect ? roleSelect.value : "@Model.Role");
                                                                                                                            });
                                                                                                                        }

                                                                                                                        function refreshCounts() {
                                                                                                                            if (permInputs.length === 0) {
                                                                                                                                return;
                                                                                                                            }
                                                                                                                            var count = permInputs.filter(function (i) { return i.checked; }).length;
                                                                                                                            if (permSelectedEl) permSelectedEl.textContent = count;
                                                                                                                            if (grantedCountEl) grantedCountEl.textContent = count;
                                                                                                                                updateLiveSummary();
                                                                                                                        }

                                                                                                                        function refreshGroupToggles() {
                                                                                                                            document.querySelectorAll(".ue-group-toggle").forEach(function (toggle) {
                                                                                                                                var groupName = toggle.getAttribute("data-group-toggle");
                                                                                                                                var members = Array.from(document.querySelectorAll('[data-group-member="' + groupName + '"]'));
                                                                                                                                var allChecked = members.length > 0 && members.every(function (m) { return m.checked; });
                                                                                                                                toggle.checked = allChecked;
                                                                                                                                // Update count badge
                                                                                                                                var countEl = document.querySelector('[data-group-count="' + groupName + '"]');
                                                                                                                                if (countEl) {
                                                                                                                                    var checkedCount = members.filter(function (m) { return m.checked; }).length;
                                                                                                                                    countEl.textContent = checkedCount + " من " + members.length;
                                                                                                                                    countEl.classList.toggle("ue-badge-active", checkedCount > 0);
                                                                                                                                }
                                                                                                                            });
                                                                                                                        }

                                                                                                                        function refreshRoleState() {
                                                                                                                            var roleValue = roleSelect ? roleSelect.value : "@Model.Role";
                                                                                                                            var isSuperAdmin = isSuperAdminInput?.value === "true";
                                                                                                                            var roleText = isSuperAdmin ? "مالك النظام" : (roleDisplayMap[roleValue] || "مستخدم النظام");
                                                                                                                            var isGeneralManager = roleValue === "@AppRoles.GeneralManager";
                                                                                                                            if (statRoleEl) statRoleEl.textContent = roleText;

                                                                                                                            var hideManagerCard = isSuperAdmin || roleValue === "@AppRoles.GeneralManager" || roleValue === "@AppRoles.SystemAdmin";
                                                                                                                            if (generalManagerCard) generalManagerCard.hidden = !isGeneralManager || isSuperAdmin;
                                                                                                                            if (managerCard) managerCard.hidden = hideManagerCard;
                                                                                                                            if (departmentSelect) {
                                                                                                                                departmentSelect.disabled = isGeneralManager || isSuperAdmin;
                                                                                                                                if (isGeneralManager || isSuperAdmin) {
                                                                                                                                    departmentSelect.value = "";
                                                                                                                                }
                                                                                                                            }
                                                                                                                            if (departmentField) {
                                                                                                                                departmentField.classList.toggle("opacity-75", isGeneralManager || isSuperAdmin);
                                                                                                                            }
                                                                                                                            if (departmentScopeNote) {
                                                                                                                                departmentScopeNote.hidden = !(isGeneralManager || isSuperAdmin);
                                                                                                                                departmentScopeNote.textContent = isGeneralManager ? "المدير العام يرتبط بالإدارة العامة فقط ولا يحتاج اختيار قسم." : "";
                                                                                                                            }
                                                                                                                            if (gateCard) gateCard.hidden = !(scanToggle && scanToggle.checked || roleValue === "@AppRoles.GateSecurity");
                                                                                                                            refreshManagerBindingState();
                                                                                                                        }

                                                                                                                        function refreshStatusState() {
                                                                                                                            if (!statusToggle) {
                                                                                                                                return;
                                                                                                                            }
                                                                                                                            if (statusLabel) statusLabel.textContent = statusToggle.checked ? "نشط" : "موقوف";
                                                                                                                            var statusCard = document.querySelector('.ue-status-switch');
                                                                                                                            if (statusCard) {
                                                                                                                                statusCard.classList.toggle('is-active', statusToggle.checked);
                                                                                                                                statusCard.classList.toggle('is-inactive', !statusToggle.checked);
                                                                                                                            }
                                                                                                                        }

                                                                                                                        function refreshManagerBindingState() {
                                                                                                                            var autoBindEnabled = autoBindManagerToggle?.checked === true;
                                                                                                                            if (managerUsernameField) managerUsernameField.hidden = autoBindEnabled;
                                                                                                                            if (managerAutoNote) managerAutoNote.hidden = !autoBindEnabled;
                                                                                                                        }

                                                                                                                            function getFieldLabel(field) {
                                                                                                                                if (!field) {
                                                                                                                                    return "";
                                                                                                                                }

                                                                                                                                var explicitLabel = document.querySelector('label[for="' + field.id + '"]');
                                                                                                                                if (explicitLabel) {
                                                                                                                                    return explicitLabel.textContent.trim();
                                                                                                                                }

                                                                                                                                var fieldContainer = field.closest(".ue-field");
                                                                                                                                var fallbackLabel = fieldContainer ? fieldContainer.querySelector(".form-label") : null;
                                                                                                                                return fallbackLabel ? fallbackLabel.textContent.trim() : field.name || "";
                                                                                                                            }

                                                                                                                            function getStepPanels(step) {
                                                                                                                                return wizardPanels.filter(function (item) {
                                                                                                                                    return parseInt(item.getAttribute("data-users-wizard-panel") || "0", 10) === step;
                                                                                                                                });
                                                                                                                            }

                                                                                                                            function collectPanelFields(step) {
                                                                                                                                return getStepPanels(step).flatMap(function (panel) {
                                                                                                                                    return Array.from(panel.querySelectorAll("input, select, textarea"));
                                                                                                                                }).filter(function (field) {
                                                                                                                                   if (!field.name || field.disabled) {
                                                                                                                                       return false;
                                                                                                                                   }

                                                                                                                                    var type = (field.getAttribute("type") || field.type || "").toLowerCase();
                                                                                                                                    return type !== "hidden" && type !== "button" && type !== "submit" && type !== "reset" && type !== "image";
                                                                                                                                });
                                                                                                                            }

                                                                                                                            function isPanelValid(step) {
                                                                                                                                return collectPanelFields(step).every(function (field) {
                                                                                                                                    return field.checkValidity();
                                                                                                                                });
                                                                                                                            }

                                                                                                                            function getFirstInvalidField(step) {
                                                                                                                                return collectPanelFields(step).find(function (field) {
                                                                                                                                    return !field.checkValidity();
                                                                                                                                }) || null;
                                                                                                                            }

                                                                                                                            function stepHasServerValidationErrors(step) {
                                                                                                                                return getStepPanels(step).some(function (panel) {
                                                                                                                                    var hasFieldMessage = Array.from(panel.querySelectorAll(".field-validation-error")).some(function (message) {
                                                                                                                                        return ((message.textContent || "").trim().length > 0);
                                                                                                                                    });
                                                                                                                                    if (hasFieldMessage) {
                                                                                                                                        return true;
                                                                                                                                    }

                                                                                                                                    return panel.querySelector(".input-validation-error, .is-invalid") !== null;
                                                                                                                                });
                                                                                                                            }

                                                                                                                            function shouldShowStepValidation(step) {
                                                                                                                                return validationRequestedSteps.has(step) || stepHasServerValidationErrors(step);
                                                                                                                            }

                                                                                                                            function setFieldErrorState(field, hasError) {
                                                                                                                                var fieldBox = field ? field.closest(".ue-field") : null;
                                                                                                                                if (!fieldBox) {
                                                                                                                                    return;
                                                                                                                                }

                                                                                                                                fieldBox.classList.toggle("has-error", hasError);
                                                                                                                            }

                                                                                                                             function updateDepartmentManagerNote() {
                                                                                                                                if (!departmentSelect || !departmentManagerNote) {
                                                                                                                                    return;
                                                                                                                                }

                                                                                                                                var selectedOption = departmentSelect.selectedOptions && departmentSelect.selectedOptions.length > 0
                                                                                                                                    ? departmentSelect.selectedOptions[0]
                                                                                                                                    : null;
                                                                                                                                 var summary = cleanDepartmentManagerSummary(selectedOption?.getAttribute("data-manager-summary") || "");
                                                                                                                                var selectedRole = roleSelect ? roleSelect.value : "";
                                                                                                                                var isManagerRole = selectedRole === "@AppRoles.DepartmentManager";

                                                                                                                                if (!isManagerRole || !summary) {
                                                                                                                                    departmentManagerNote.hidden = true;
                                                                                                                                    departmentManagerNote.textContent = "";
                                                                                                                                    return;
                                                                                                                                }

                                                                                                                                 departmentManagerNote.hidden = false;
                                                                                                                                 departmentManagerNote.textContent = summary;
                                                                                                                             }

                                                                                                                             function cleanDepartmentManagerSummary(summary) {
                                                                                                                                 var value = (summary || "").trim();
                                                                                                                                 if (!value) {
                                                                                                                                     return "";
                                                                                                                                 }

                                                                                                                                 return value
                                                                                                                                     .replace(/^المدير\s+الحالي\s*[:：-]?\s*/i, "")
                                                                                                                                     .replace(/^مدير\s+القسم\s+الحالي\s*[:：-]?\s*/i, "")
                                                                                                                                     .replace(/^مدير\s+القسم\s*[:：-]?\s*/i, "")
                                                                                                                                     .split(" - ")[0]
                                                                                                                                     .split(" — ")[0]
                                                                                                                                     .trim();
                                                                                                                             }

                                                                                                                             function updateLiveSummary() {
                                                                                                                                if (liveSummaryFullName) liveSummaryFullName.textContent = (document.getElementById("FullName")?.value || "").trim() || "غير مُدخل";
                                                                                                                                if (liveSummaryUsername) liveSummaryUsername.textContent = (document.getElementById("Username")?.value || "").trim() || "غير مُدخل";

                                                                                                                                var roleValue = roleSelect ? roleSelect.value : "@Model.Role";
                                                                                                                                var isSuperAdmin = isSuperAdminInput?.value === "true";
                                                                                                                                var roleText = isSuperAdmin ? "مالك النظام" : (roleDisplayMap[roleValue] || "مستخدم النظام");
                                                                                                                        if (liveSummaryRole) liveSummaryRole.textContent = roleText;

                                                                                                                        var tenantText = tenantSelect && tenantSelect.selectedOptions && tenantSelect.selectedOptions.length > 0
                                                                                                                            ? tenantSelect.selectedOptions[0].textContent.trim()
                                                                                                                            : "@currentTenantDisplay";
                                                                                                                        if (liveSummaryTenant) liveSummaryTenant.textContent = tenantText || "الجهة الحالية";

                                                                                                                        var departmentText = departmentSelect && departmentSelect.selectedOptions && departmentSelect.selectedOptions.length > 0
                                                                                                                                    ? departmentSelect.selectedOptions[0].textContent.trim()
                                                                                                                                    : "";
                                                                                                                                if (liveSummaryDepartment) liveSummaryDepartment.textContent = departmentText || "غير مرتبط";

                                                                                                                                var selectedOption = departmentSelect && departmentSelect.selectedOptions && departmentSelect.selectedOptions.length > 0
                                                                                                                                    ? departmentSelect.selectedOptions[0]
                                                                                                                                    : null;
                                                                                                                                 var managerSummary = cleanDepartmentManagerSummary(selectedOption?.getAttribute("data-manager-summary") || "");
                                                                                                                                 if (liveSummaryDepartmentManager) {
                                                                                                                                     liveSummaryDepartmentManager.textContent = managerSummary || "غير مرتبط";
                                                                                                                                 }

                                                                                                                                if (liveSummaryPermissions) {
                                                                                                                                    liveSummaryPermissions.textContent = grantedCountEl ? grantedCountEl.textContent + " صلاحية" : "0 صلاحية";
                                                                                                                                }
                                                                                                                            }

                                                                                                                            function updateValidationSummary(step) {
                                                                                                                                if (!wizardValidationBox || !wizardValidationList || !wizardValidationText) {
                                                                                                                                    return;
                                                                                                                                }

                                                                                                                                var invalidField = getFirstInvalidField(step);
                                                                                                                                if (!invalidField || !shouldShowStepValidation(step)) {
                                                                                                                                    wizardValidationBox.hidden = true;
                                                                                                                                    wizardValidationList.innerHTML = "";
                                                                                                                                    wizardValidationText.textContent = "أكمل الحقول المطلوبة في هذه الخطوة.";
                                                                                                                                    return;
                                                                                                                                }

                                                                                                                                var fieldItems = collectPanelFields(step)
                                                                                                                                    .filter(function (field) { return !field.checkValidity(); })
                                                                                                                                    .map(function (field) {
                                                                                                                                        return "<li>" + getFieldLabel(field) + "</li>";
                                                                                                                                    })
                                                                                                                                    .join("");

                                                                                                                                wizardValidationList.innerHTML = fieldItems;
                                                                                                                                wizardValidationText.textContent = "أكمل الحقول التالية للانتقال بأمان.";
                                                                                                                                wizardValidationBox.hidden = false;
                                                                                                                            }

                                                                                                                            function setHiddenPanelControls(panel, hidden) {
                                                                                                                                panel.toggleAttribute("inert", hidden);
                                                                                                                                panel.setAttribute("aria-hidden", hidden ? "true" : "false");
                                                                                                                            }

                                                                                                                            function validateAndStay(step) {
                                                                                                                                var isValid = isPanelValid(step);
                                                                                                                                validationRequestedSteps.add(step);
                                                                                                                                form?.classList.add("was-validated");
                                                                                                                                markFieldErrorsFromStep(step);
                                                                                                                                updateValidationSummary(step);
                                                                                                                                syncStepperState();

                                                                                                                                if (!isValid) {
                                                                                                                                    var invalidField = getFirstInvalidField(step);
                                                                                                                                    if (invalidField && typeof invalidField.focus === "function") {
                                                                                                                                        invalidField.focus({ preventScroll: true });
                                                                                                                                    }
                                                                                                                                }

                                                                                                                                return isValid;
                                                                                                                            }

                                                                                                                            function validateAllWizardSteps() {
                                                                                                                                for (var step = 1; step <= wizardMaxStep; step += 1) {
                                                                                                                                    if (!isPanelValid(step)) {
                                                                                                                                        setWizardStep(step, false);
                                                                                                                                        validateAndStay(step);
                                                                                                                                        return false;
                                                                                                                                    }
                                                                                                                                }

                                                                                                                                if (wizardValidationBox) {
                                                                                                                                    wizardValidationBox.hidden = true;
                                                                                                                                }
                                                                                                                                return true;
                                                                                                                            }

                                                                                                                            function syncStepperState() {
                                                                                                                                var currentStep = getWizardStep();
                                                                                                                                var stepValidity = {};

                                                                                                                                for (var step = 1; step <= wizardMaxStep; step += 1) {
                                                                                                                                    stepValidity[step] = isPanelValid(step);
                                                                                                                                }

                                                                                                                                var highestUnlockedStep = 1;
                                                                                                                                for (var stepIndex = 1; stepIndex < currentStep; stepIndex += 1) {
                                                                                                                                    if (!stepValidity[stepIndex]) {
                                                                                                                                        highestUnlockedStep = stepIndex;
                                                                                                                                        break;
                                                                                                                                    }
                                                                                                                                    highestUnlockedStep = Math.min(stepIndex + 1, wizardMaxStep);
                                                                                                                                }

                                                                                                                                wizardStepTabs.forEach(function (tab) {
                                                                                                                                    var tabStep = parseInt(tab.getAttribute("data-users-wizard-step-jump") || "0", 10);
                                                                                                                                    var isCurrent = tabStep === currentStep;
                                                                                                                                    var isComplete = tabStep < currentStep && stepValidity[tabStep];
                                                                                                                                    var isLocked = tabStep > highestUnlockedStep;
                                                                                                                                    var isError = tabStep === currentStep && !stepValidity[currentStep] && shouldShowStepValidation(currentStep);

                                                                                                                                    tab.classList.toggle("is-active", isCurrent);
                                                                                                                                    tab.classList.toggle("is-complete", isComplete);
                                                                                                                                    tab.classList.toggle("is-locked", isLocked);
                                                                                                                                    tab.classList.toggle("is-error", isError);
                                                                                                                                    tab.disabled = isLocked;
                                                                                                                                    tab.setAttribute("aria-disabled", isLocked ? "true" : "false");
                                                                                                                                });

                                                                                                                                wizardPrevButtons.forEach(function (button) {
                                                                                                                                    button.disabled = currentStep <= 1;
                                                                                                                                });

                                                                                                                                wizardNextButtons.forEach(function (button) {
                                                                                                                                    var currentValid = stepValidity[currentStep];
                                                                                                                                    button.hidden = currentStep >= wizardMaxStep;
                                                                                                                                    button.disabled = false;
                                                                                                                                   button.textContent = currentStep === wizardMaxStep - 1 ? "المراجعة" : "التالي";
                                                                                                                                });

                                                                                                                                updateValidationSummary(currentStep);
                                                                                                                                updateLiveSummary();
                                                                                                                            }

                                                                                                                        function getWizardStep() {
                                                                                                                            var value = parseInt(wizardStepInput?.value || "1", 10);
                                                                                                                            if (Number.isNaN(value) || value < 1) {
                                                                                                                                return 1;
                                                                                                                            }
                                                                                                                            return Math.min(value, wizardMaxStep);
                                                                                                                        }

                                                                                                                       function setWizardStep(nextStep, focusPanel) {
                                                                                                                           if (!wizardStepInput) {
                                                                                                                               return;
                                                                                                                           }
                                                                                                                           var step = Math.max(1, Math.min(nextStep, wizardMaxStep));
                                                                                                                           wizardStepInput.value = String(step);
                                                                                                                            updateWizardSaveNote("تم حفظ بيانات الخطوة السابقة كمسودة محلية. يمكنك الرجوع لها ما دمت على نفس المتصفح.");
                                                                                                                           syncWizardState(focusPanel !== false);
                                                                                                                       }

                                                                                                                        function syncWizardState(shouldFocus) {
                                                                                                                            if (!wizardShell || !wizardStepInput) {
                                                                                                                                return;
                                                                                                                            }

                                                                                                                            var step = getWizardStep();
                                                                                                                                 wizardPanels.forEach(function (panel) {
                                                                                                                                var panelStep = parseInt(panel.getAttribute("data-users-wizard-panel") || "0", 10);
                                                                                                                                    var hidden = panelStep !== step;
                                                                                                                                    panel.classList.toggle("is-hidden", hidden);
                                                                                                                                     setHiddenPanelControls(panel, hidden);
                                                                                                                             });
                                                                                                                             wizardPanelContainers.forEach(function (container) {
                                                                                                                                 var hasVisiblePanel = Array.from(container.querySelectorAll("[data-users-wizard-panel]")).some(function (panel) {
                                                                                                                                     return !panel.classList.contains("is-hidden");
                                                                                                                                 });
                                                                                                                                 container.classList.toggle("is-hidden", !hasVisiblePanel);
                                                                                                                             });
                                                                                                                                 syncStepperState();

                                                                                                                            if (shouldFocus) {
                                                                                                                                var activePanel = wizardPanels.find(function (panel) {
                                                                                                                                    return parseInt(panel.getAttribute("data-users-wizard-panel") || "0", 10) === step;
                                                                                                                                });
                                                                                                                                var focusable = activePanel ? activePanel.querySelector("input:not([type='hidden']):not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([type='button']):not([disabled])") : null;
                                                                                                                                if (focusable && typeof focusable.focus === "function") {
                                                                                                                                    focusable.focus({ preventScroll: true });
                                                                }
                                                                                                                            }
                                                                                                                        }

                                                                                                                        function setLookupResult(status, message, data) {
                                                                                                                            if (lookupStatusInput) lookupStatusInput.value = status || "";
                                                                                                                            if (lookupMessageInput) lookupMessageInput.value = message || "";
                                                                                                                            if (lookupRedirectUrlInput) lookupRedirectUrlInput.value = data?.editUrl || "";
                                                                                                                            if (lookupReactivateUrlInput) lookupReactivateUrlInput.value = data?.reactivateUrl || "";
                                                                                                                            if (pendingPermitsInput && typeof data?.pendingPermitsCount === "number") {
                                                                                                                                pendingPermitsInput.value = String(data.pendingPermitsCount);
                                                                                                                            }
                                                                                                                            if (!identityLookupResult) {
                                                                                                                                return;
                                                                                                                            }

                                                                                                                            var details = [];
                                                                                                                            if (data?.displayName) details.push(data.displayName);
                                                                                                                            if (data?.role) details.push(data.role);
                                                                                                                            if (data?.department) details.push(data.department);
                                                                                                                            if (typeof data?.pendingPermitsCount === "number") {
                                                                                                                                details.push(data.pendingPermitsCount + " طلبًا معلقًا");
                                                                                                                            }
                                                                                                                            identityLookupResult.hidden = !message;
                                                                                                                            identityLookupResult.textContent = details.length > 0 ? message + " — " + details.join(" · ") : message;
                                                                                                                            if (reactivateButton) {
                                                                                                                                reactivateButton.hidden = status !== "inactive";
                                                                                                                            }
                                                                                                                        }

                                                                                                                        async function performIdentityLookup() {
                                                                                                                            if (!form) {
                                                                                                                                return;
                                                                                                                            }

                                                                                                                            var usernameInput = form.querySelector("#Username");
                                                                                                                            var username = usernameInput ? usernameInput.value.trim() : "";
                                                                                                                            if (!/^[12]\d{9}$/.test(username)) {
                                                                                                                                setLookupResult("invalid", "المعرف الداخلي يجب أن يكون 10 أرقام ويبدأ بـ 1 أو 2.");
                                                                                                                                if (usernameInput) {
                                                                                                                                    usernameInput.focus();
                                                                                                                                }
                                                                                                                                return;
                                                                                                                            }

                                                                                                                            setLookupResult("loading", "جاري فحص المعرف...");
                                                                                                                            var lookupUrl = "@Url.Action("WizardIdentityLookup", "Users")" + "?username=" + encodeURIComponent(username);
                                                                                                                            var response = await fetch(lookupUrl, {
                                                                                                                                headers: { "Accept": "application/json" },
                                                                                                                                credentials: "same-origin"
                                                                                                                            });
                                                                                                                            var data = await response.json();
                                                                                                                            setLookupResult(data.status || "", data.message || "", data);

                                                                                                                            if (data.status === "active" && data.editUrl) {
                                                                                                                                window.location.assign(data.editUrl);
                                                                                                                                return;
                                                                                                                            }
                                                                                                                        }

                                                                                                                        async function reactivateLookupUser() {
                                                                                                                            if (!form || !lookupReactivateUrlInput || !lookupReactivateUrlInput.value) {
                                                                                                                                return;
                                                                                                                            }

                                                                                                                            var usernameInput = form.querySelector("#Username");
                                                                                                                            var username = usernameInput ? usernameInput.value.trim() : "";
                                                                                                                            var token = requestVerificationToken ? requestVerificationToken.value : "";
                                                                                                                            if (!username || !token) {
                                                                                                                                return;
                                                                                                                            }

                                                                                                                            var response = await fetch(lookupReactivateUrlInput.value, {
                                                                                                                                method: "POST",
                                                                                                                                headers: {
                                                                                                                                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                                                                                                                                },
                                                                                                                                credentials: "same-origin",
                                                                                                                                body: new URLSearchParams({
                                                                                                                                    __RequestVerificationToken: token,
                                                                                                                                    username: username
                                                                                                                                }).toString()
                                                                                                                            });
                                                                                                                            var data = await response.json();
                                                                                                                            setLookupResult(data.status || "", data.message || "", data);

                                                                                                                            if (data.status === "reactivated" && data.editUrl) {
                                                                                                                                window.location.assign(data.editUrl);
                                                                                                                            }
                                                                                                                        }

                                                                                                                        wizardStepTabs.forEach(function (tab) {
                                                                                                                            tab.addEventListener("click", function () {
                                                                                                                                    var targetStep = parseInt(tab.getAttribute("data-users-wizard-step-jump") || "1", 10);
                                                                                                                                    if (targetStep > getWizardStep() + 1) {
                                                                                                                                        syncStepperState();
                                                                                                                                        return;
                                                                                                                                    }

                                                                                                                                    var currentStep = getWizardStep();
                                                                                                                                    if (targetStep > currentStep && !isPanelValid(currentStep)) {
                                                                                                                                        validateAndStay(currentStep);
                                                                                                                                        return;
                                                                                                                                    }

                                                                                                                                    setWizardStep(targetStep);
                                                                                                                            });
                                                                                                                        });

                                                                                                                        wizardPrevButtons.forEach(function (button) {
                                                                                                                            button.addEventListener("click", function () {
                                                                                                                                setWizardStep(getWizardStep() - 1);
                                                                                                                            });
                                                                                                                        });

                                                                                                                        wizardNextButtons.forEach(function (button) {
                                                                                                                            button.addEventListener("click", function () {
                                                                                                                                var currentStep = getWizardStep();
                                                                                                                                if (!validateAndStay(currentStep)) {
                                                                                                                                    return;
                                                                                                                                }
                                                                                                                                setWizardStep(currentStep + 1);
                                                                                                                            });
                                                                                                                        });

                                                                                                                        if (identityLookupButton) {
                                                                                                                            identityLookupButton.addEventListener("click", function () {
                                                                                                                                performIdentityLookup();
                                                                                                                            });
                                                                                                                        }

                                                                                                                        if (reactivateButton) {
                                                                                                                            reactivateButton.addEventListener("click", function () {
                                                                                                                                reactivateLookupUser();
                                                                                                                            });
                                                                                                                        }

                                                                                                                            [document.getElementById("FullName"), document.getElementById("Username"), document.getElementById("PhoneNumber"), document.getElementById("JobTitle")].forEach(function (field) {
                                                                                                                                if (field) {
                                                                                                                                    field.addEventListener("input", function () {
                                                                                                                                        updateLiveSummary();
                                                                                                                                            syncStepperState();
                                                                                                                                    });
                                                                                                                                }
                                                                                                                            });

                                                                                                                            [tenantSelect, departmentSelect, autoBindManagerToggle, statusToggle, scanToggle, manageUsersToggle, manageDepartmentsToggle, manageAdministrationToggle].forEach(function (field) {
                                                                                                                                if (field) {
                                                                                                                                    field.addEventListener("change", function () {
                                                                                                                                        updateLiveSummary();
                                                                                                                                        updateDepartmentManagerNote();
                                                                                                                                            syncStepperState();
                                                                                                                                    });
                                                                                                                                }
                                                                                                                            });

                                                                                                                            function markFieldErrorsFromStep(step) {
                                                                                                                                wizardPanels.forEach(function (panel) {
                                                                                                                                    var panelStep = parseInt(panel.getAttribute("data-users-wizard-panel") || "0", 10);
                                                                                                                                    Array.from(panel.querySelectorAll(".ue-field")).forEach(function (fieldBox) {
                                                                                                                                        fieldBox.classList.remove("has-error");
                                                                                                                                    });
                                                                                                                                    if (panelStep === step) {
                                                                                                                                        collectPanelFields(step).forEach(function (field) {
                                                                                                                                            setFieldErrorState(field, !field.checkValidity());
                                                                                                                                        });
                                                                                                                                    }
                                                                                                                                });
                                                                                                                            }

                                                                                                                       if (form) {
                                                                                                                            form.addEventListener("input", function (event) {
                                                                                                                                if (event.target && event.target.matches && event.target.matches("input, textarea, select")) {
                                                                                                                                    updateWizardSaveNote("تم تحديث المسودة تلقائيًا.");
                                                                                                                                }
                                                                                                                            });

                                                                                                                            form.addEventListener("change", function (event) {
                                                                                                                                if (event.target && event.target.matches && event.target.matches("input, textarea, select")) {
                                                                                                                                    updateWizardSaveNote("تم تحديث المسودة تلقائيًا.");
                                                                                                                                }
                                                                                                                            });

                                                                                                                            form.addEventListener("submit", function (event) {
                                                                                                                                const submitter = event.submitter;
                                                                                                                                const requiresEditConfirmation = submitter?.dataset.editSubmit === "true";
                                                                                                                                const skipValidation = submitter?.formNoValidate || submitter?.dataset.skipValidation === "true";
                                                                                                                                const confirmMessage = submitter?.dataset.editScope === "self"
                                                                                                                                    ? "سيتم تحديث بيانات حسابك الشخصية فقط. هل تريد المتابعة؟"
                                                                                                                                    : "سيتم تحديث بيانات المستخدم وصلاحياته. هل تريد المتابعة؟";

                                                                                                                                    if (!skipValidation && getWizardStep() < wizardMaxStep) {
                                                                                                                                    event.preventDefault();
                                                                                                                                    event.stopPropagation();
                                                                                                                                        if (!isPanelValid(getWizardStep())) {
                                                                                                                                            form.classList.add("was-validated");
                                                                                                                                            markFieldErrorsFromStep(getWizardStep());
                                                                                                                                            syncStepperState();
                                                                                                                                        return;
                                                                                                                                    }

                                                                                                                                    setWizardStep(getWizardStep() + 1);
                                                                                                                                    return;
                                                                                                                                }

                                                                                                                                if (!skipValidation && !validateAllWizardSteps()) {
                                                                                                                                   event.preventDefault();
                                                                                                                                   event.stopPropagation();
                                                                                                                                   return;
                                                                                                                               }

                                                                                                                                if (requiresEditConfirmation && !window.confirm(confirmMessage)) {
                                                                                                                                    event.preventDefault();
                                                                                                                                    event.stopPropagation();
                                                                                                                                    return;
                                                                                                                                }

                                                                                                                                if (!skipValidation) {
                                                                                                                                    form.classList.add("was-validated");
                                                                                                                                }
                                                                                                                            });
                                                                                                                        }

                                                                                                                        if (roleSelect) {
                                                                                                                            roleSelect.addEventListener("change", function () {
                                                                                                                                applyRolePermissionDefaults(roleSelect.value);
                                                                                                                                refreshRoleState();
                                                                                                                                refreshStatusState();
                                                                                                                                updateDepartmentManagerNote();
                                                                                                                                updateLiveSummary();
                                                                                                                                syncStepperState();
                                                                                                                            });
                                                                                                                        }

                                                                                                                        [statusToggle, scanToggle, manageUsersToggle, manageDepartmentsToggle, manageAdministrationToggle, autoBindManagerToggle].forEach(function (el) {
                                                                                                                            if (el) el.addEventListener("change", function () {
                                                                                                                                refreshCounts();
                                                                                                                                refreshRoleState();
                                                                                                                                refreshStatusState();
                                                                                                                                refreshGroupToggles();
                                                                                                                                    updateDepartmentManagerNote();
                                                                                                                                    updateLiveSummary();
                                                                                                                                    syncStepperState();
                                                                                                                            });
                                                                                                                        });

                                                                                                                        refreshCounts();
                                                                                                                        refreshGroupToggles();
                                                                                                                        refreshRoleState();
                                                                                                                        refreshStatusState();
                                                                                                                        refreshManagerBindingState();
                                                                                                                            updateDepartmentManagerNote();
                                                                                                                            updateLiveSummary();
                                                                                                                            syncStepperState();
                                                                                                                            syncWizardState(false);
                                                                                                                    });
                                                                                                                </script>
