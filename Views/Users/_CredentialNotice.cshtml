@{
    var title = ViewData["CredentialNoticeTitle"] as string;
    var username = ViewData["CredentialNoticeUsername"] as string;
    var temporaryPassword = ViewData["CredentialNoticeTemporaryPassword"] as string;
    var badgeCode = ViewData["CredentialNoticeBadgeCode"] as string;
    var temporaryPin = ViewData["CredentialNoticeTemporaryPin"] as string;
    var note = ViewData["CredentialNoticeNote"] as string;
}

@if (!string.IsNullOrWhiteSpace(title))
{
    <section class="card-permit app-card-surface mb-3 border border-success-subtle">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <span class="users-section-kicker">بيانات مؤقتة لمرة واحدة</span>
                <h2 class="h5 mb-1">@title</h2>
                <p class="text-muted-ar mb-0">@(string.IsNullOrWhiteSpace(note) ? "أرسل هذه البيانات للمستخدم ثم لا تعتمد عليها بعد أول دخول ناجح." : note)</p>
            </div>
        </div>

        <div class="row g-3">
            @if (!string.IsNullOrWhiteSpace(username))
            {
                <div class="col-md-6">
                    <label class="form-label">اسم المستخدم</label>
                    <input class="form-control ltr-field" readonly value="@username" />
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(temporaryPassword))
            {
                <div class="col-md-6">
                    <label class="form-label">كلمة المرور المؤقتة</label>
                    <input class="form-control ltr-field" readonly value="@temporaryPassword" />
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(badgeCode))
            {
                <div class="col-md-6">
                    <label class="form-label">رمز مشغل البوابة</label>
                    <input class="form-control ltr-field" readonly value="@badgeCode" />
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(temporaryPin))
            {
                <div class="col-md-6">
                    <label class="form-label">PIN المؤقت</label>
                    <input class="form-control ltr-field" readonly value="@temporaryPin" />
                </div>
            }
        </div>
    </section>
}
