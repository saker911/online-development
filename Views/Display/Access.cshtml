@{
    ViewData["Title"] = "شاشات العرض";
}

<div class="card-permit">
    <h1 class="mb-3">مركز تشغيل البوابة</h1>
    <p class="text-muted-ar">واجهة واحدة للتصاريح والزيارات، وتعمل على الجوال والكمبيوتر وجهاز البوابة.</p>

    <div class="row g-3">
        <div class="col-12">
            <a href="@ViewBag.GateUrl" target="_blank" class="btn btn-primary w-100 py-3">فتح مركز البوابة</a>
        </div>
    </div>

    <hr class="my-4" />

    <div class="border rounded p-3">
        <div class="fw-bold mb-2">رابط مركز البوابة</div>
        <a href="@ViewBag.GateUrl" target="_blank" class="text-break ltr-field">@ViewBag.GateUrl</a>
    </div>
</div>
