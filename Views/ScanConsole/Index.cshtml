@using System.Text.Json
@using VehiclePermitSystemWeb.Utilities
@model VehiclePermitSystemWeb.Models.ViewModels.Scan.ScanTestViewModel

@{
    ViewData["Title"] = "مركز البوابة";
    var isUnifiedDisplayMode = ViewBag.IsUnifiedDisplayMode as bool? ?? false;
    var requiresOperator = ViewBag.RequiresOperator as bool? ?? false;
    var scannerDisplayName = (ViewBag.ScannerDisplayName as string ?? Model.ScannerUserName).Trim();
    var permitNotFoundMessage = Model.ScannedPermit != null
        ? "هذا التصريح موجود لكنه غير نشط حاليًا أو منتهي."
        : "رقم التصريح غير موجود.";
    Func<string?, string> maskValue = value =>
    {
        var normalized = (value ?? string.Empty).Trim();
        if (normalized.Length <= 4)
        {
            return normalized;
        }

        return new string('*', normalized.Length - 4) + normalized[^4..];
    };
    var initialPermitJson = Model.ScannedPermit == null
        ? "null"
        : JsonSerializer.Serialize(
            new
            {
                Model.ScannedPermit.PermitNumber,
                Model.ScannedPermit.PublicPermitCode,
                Model.ScannedPermit.DriverName,
                Model.ScannedPermit.ApprovalStatusDisplay,
                Model.ScannedPermit.PermitTypeDisplay,
                Model.ScannedPermit.DepartmentName,
                Model.ScannedPermit.LocationDisplay,
                NationalId = maskValue(Model.ScannedPermit.NationalId),
                Model.ScannedPermit.PlateNumberDisplay,
                Model.ScannedPermit.VehicleType,
                EmployeePhone = maskValue(Model.ScannedPermit.EmployeePhone),
                Model.ScannedPermit.Subject,
            },
            new JsonSerializerOptions(JsonSerializerDefaults.Web)
        );
}

@section Styles {
    <link rel="stylesheet" href="~/css/scan-console.css" asp-append-version="true" />
}

<div class="gate-mobile-page @(isUnifiedDisplayMode ? "is-unified-display" : string.Empty)"
     id="unifiedGateRoot"
     data-unified-display="@isUnifiedDisplayMode.ToString().ToLowerInvariant()"
     data-requires-operator="@requiresOperator.ToString().ToLowerInvariant()"
     data-heartbeat-endpoint="@(ViewBag.HeartbeatEndpoint ?? string.Empty)"
     data-operator-status-endpoint="@(ViewBag.OperatorStatusEndpoint ?? string.Empty)"
     data-switch-operator-endpoint="@(ViewBag.SwitchOperatorEndpoint ?? string.Empty)"
     data-signout-operator-endpoint="@(ViewBag.SignOutOperatorEndpoint ?? string.Empty)"
     data-change-pin-endpoint="@(ViewBag.ChangeOperatorPinEndpoint ?? string.Empty)">
    <header class="gate-mobile-header">
        <div>
            <span class="gate-mobile-eyebrow">تشغيل البوابة</span>
            <h1>مركز البوابة</h1>
            <p>اقرأ تصريح الموظف أو الزائر وسجّل الحركة مباشرة.</p>
        </div>
        <div class="gate-mobile-header-status">
            <span class="gate-mobile-network is-online" id="scanNetworkStatus" role="status">
                <span aria-hidden="true"></span>
                متصل
            </span>
            <span class="gate-mobile-operator" id="activeOperatorName">@(requiresOperator ? "لا يوجد مشغل نشط" : scannerDisplayName)</span>
            @if (isUnifiedDisplayMode)
            {
                <button type="button" class="gate-mobile-header-button" id="unifiedGateFullscreenButton" title="ملء الشاشة">ملء الشاشة</button>
                @if (requiresOperator)
                {
                    <button type="button" class="gate-mobile-header-button" id="openOperatorModalButton">دخول المشغل</button>
                    <button type="button" class="gate-mobile-header-button is-danger" id="signOutOperatorButton" disabled>خروج المشغل</button>
                }
            }
        </div>
    </header>

    <div class="gate-mobile-layout">
        <main class="gate-mobile-main">
            <section class="gate-mobile-decision state-idle" id="scanDecisionCard" aria-live="assertive">
                <div class="gate-mobile-decision-mark" id="scanDecisionMark" aria-hidden="true">جاهز</div>
                <div class="gate-mobile-decision-copy">
                    <span id="scanDecisionKicker">بانتظار القراءة</span>
                    <h2 id="scanDecisionTitle">جاهز للمسح</h2>
                    <p id="scanDecisionMessage">شغّل الكاميرا أو استخدم جهاز الباركود.</p>
                    <strong class="ltr-field" id="scanDecisionCode"></strong>
                </div>
            </section>

            <section class="gate-mobile-capture">
                <form method="post"
                      novalidate
                      id="scanConsoleForm"
                      data-scan-endpoint="@Url.Content("~/api/scan/auto")"
                      data-scanner-user="@Model.ScannerUserName"
                      data-scanner-display-name="@scannerDisplayName"
                      data-requires-operator="@requiresOperator.ToString().ToLowerInvariant()"
                      data-permit-not-found-message="@permitNotFoundMessage">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="visually-hidden form-summary-only"></div>

                    <div class="gate-mobile-input-row">
                        <div class="gate-mobile-input-wrap">
                            <label asp-for="Identifier">رمز التصريح أو الزيارة</label>
                            <input asp-for="Identifier"
                                   class="form-control ltr-field scan-input"
                                   autocomplete="off"
                                   autocapitalize="off"
                                   spellcheck="false"
                                   autofocus
                                   required
                                   placeholder="امسح الرمز أو أدخله" />
                            <span asp-validation-for="Identifier" class="field-validation-error small"></span>
                        </div>
                        <button type="submit" class="gate-mobile-manual-button" id="scanConsoleSubmitButton">تحقق</button>
                    </div>

                    <div class="gate-mobile-mode" id="detectedScanModeText" aria-live="polite">يكتشف النظام نوع الرمز تلقائياً.</div>

                    <button type="button" class="gate-mobile-camera-button" id="scanConsoleCameraButton">
                        تشغيل كاميرا الجوال
                    </button>

                    <div class="mobile-camera-panel" id="scanConsoleCameraPanel" hidden>
                        <div class="mobile-camera-stage">
                            <video class="mobile-camera-preview" id="scanConsoleCameraPreview" playsinline muted></video>
                            <div class="mobile-camera-reticle" aria-hidden="true"></div>
                        </div>
                        <div class="mobile-camera-status" id="scanConsoleCameraStatus">وجّه الكاميرا نحو QR أو الباركود.</div>
                        <div class="mobile-camera-actions">
                            <button type="button" class="gate-mobile-icon-button" id="scanConsoleFullscreenButton" title="ملء الشاشة" aria-label="ملء الشاشة">ملء الشاشة</button>
                            <button type="button" class="gate-mobile-stop-button" id="scanConsoleStopCameraButton">إيقاف الكاميرا</button>
                        </div>
                    </div>
                </form>
            </section>

            <section id="scannedPermitCard" class="gate-mobile-details @(Model.ScannedPermit == null ? "d-none" : string.Empty)">
                <div class="gate-mobile-section-head">
                    <div>
                        <span>آخر قراءة</span>
                        <h2 id="scannedSubjectTitle">بيانات التصريح</h2>
                    </div>
                    <strong class="ltr-field" id="scannedPermitPublicCode">@(Model.ScannedPermit?.PublicPermitCode ?? string.Empty)</strong>
                </div>
                <div class="gate-mobile-detail-grid @(Model.ScannedPermit == null ? "d-none" : string.Empty)" id="scannedPermitDetails"></div>
            </section>
        </main>

        <aside class="gate-mobile-sidebar">
            <section class="gate-mobile-shift">
                <div class="gate-mobile-section-head">
                    <div>
                        <span>الجلسة الحالية</span>
                        <h2>ملخص الوردية</h2>
                    </div>
                    <button type="button" class="gate-mobile-reset" id="resetShiftSummaryButton">تصفير</button>
                </div>
                <div class="gate-mobile-stats">
                    <div><strong id="shiftScanCount">0</strong><span>قراءة</span></div>
                    <div><strong id="shiftAllowedCount">0</strong><span>سماح</span></div>
                    <div><strong id="shiftDeniedCount">0</strong><span>رفض</span></div>
                </div>
            </section>

            <section class="gate-mobile-recent">
                <div class="gate-mobile-section-head">
                    <div>
                        <span>سجل المشغل</span>
                        <h2>آخر العمليات</h2>
                    </div>
                </div>
                <div class="gate-mobile-activity-list" id="scanRecentActivityList">
                    @if (Model.RecentActivities.Count == 0)
                    {
                        <p class="gate-mobile-empty" id="scanRecentEmptyState">لا توجد عمليات مسجلة لهذا المشغل بعد.</p>
                    }
                    else
                    {
                        foreach (var activity in Model.RecentActivities)
                        {
                            var isAllowed = activity.ActionType.Contains("Entry", StringComparison.OrdinalIgnoreCase)
                                || activity.ActionType.Contains("Return", StringComparison.OrdinalIgnoreCase)
                                || activity.ActionType.Contains("Exit", StringComparison.OrdinalIgnoreCase)
                                   && !activity.ActionType.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase);
                            <article class="gate-mobile-activity @(isAllowed ? "is-allowed" : "is-denied")">
                                <div>
                                    <strong>@(string.IsNullOrWhiteSpace(activity.DriverName) ? activity.PermitNumber : activity.DriverName)</strong>
                                    <span>@activity.ActionLabel</span>
                                </div>
                                <time>@HijriDateFormatter.Format(activity.OccurredAt)</time>
                            </article>
                        }
                    }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(Model.SamplePermitNumber))
            {
                <section class="gate-mobile-linked-permit">
                    <div class="gate-mobile-section-head">
                        <div>
                            <span>تصريح محدد</span>
                            <h2>باركود التصريح المعتمد</h2>
                        </div>
                    </div>
                    <p>@Model.SamplePermitDisplayName</p>
                    <img src="@Url.Action("Barcode", "Permits", new { id = Model.SamplePermitNumber })"
                         alt="رمز التصريح @Model.SamplePermitNumber"
                         class="barcode-preview-img" />
                    <strong class="ltr-field">@Model.SamplePermitNumber</strong>
                    <strong class="ltr-field">@Model.SamplePermitPublicCode</strong>
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SamplePermitNotice))
            {
                <div class="gate-mobile-warning">@Model.SamplePermitNotice</div>
            }
        </aside>
    </div>
</div>

@if (requiresOperator)
{
    <div class="gate-unified-modal is-hidden" id="operatorModal" aria-hidden="true">
        <div class="gate-unified-dialog" role="dialog" aria-modal="true" aria-labelledby="operatorModalTitle">
            <div class="gate-mobile-section-head">
                <div>
                    <span>تشغيل آمن</span>
                    <h2 id="operatorModalTitle">دخول مأمور البوابة</h2>
                </div>
                <button type="button" class="gate-mobile-reset" id="closeOperatorModalButton">إغلاق</button>
            </div>

            <p class="gate-unified-operator-copy" id="operatorModalHint">امسح بطاقة المشغل أو أدخل الرمز والرقم السري.</p>

            <div class="gate-unified-operator-fields" id="operatorLoginSection">
                <label for="operatorBadgeInput">رمز المشغل</label>
                <input id="operatorBadgeInput" class="form-control ltr-field" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="GATE-000000" />
                <label for="operatorPinInput">الرقم السري</label>
                <input id="operatorPinInput" class="form-control ltr-field" type="password" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="6 أرقام" />
            </div>

            <div class="gate-unified-operator-fields" id="operatorPinChangeSection" hidden>
                <label for="operatorCurrentPinInput">الرقم الحالي</label>
                <input id="operatorCurrentPinInput" class="form-control ltr-field" type="password" inputmode="numeric" maxlength="6" autocomplete="off" />
                <label for="operatorNewPinInput">الرقم الجديد</label>
                <input id="operatorNewPinInput" class="form-control ltr-field" type="password" inputmode="numeric" maxlength="6" autocomplete="new-password" />
                <label for="operatorConfirmPinInput">تأكيد الرقم الجديد</label>
                <input id="operatorConfirmPinInput" class="form-control ltr-field" type="password" inputmode="numeric" maxlength="6" autocomplete="new-password" />
            </div>

            <div class="gate-unified-operator-message" id="operatorModalMessage" role="status"></div>
            <div class="gate-unified-dialog-actions">
                <button type="button" class="gate-mobile-camera-button" id="submitOperatorLoginButton">تسجيل الدخول</button>
                <button type="button" class="gate-mobile-camera-button" id="submitOperatorPinChangeButton" hidden>حفظ الرقم الجديد</button>
                <button type="button" class="gate-mobile-header-button" id="cancelOperatorModalButton">إلغاء</button>
            </div>
        </div>
    </div>
}

<script type="application/json" id="scanConsoleInitialPermit" nonce="@(Context.Items["CspScriptNonce"])">@Html.Raw(initialPermitJson)</script>

@section Scripts {
    <script src="~/js/scan-console.js" asp-append-version="true"></script>
}
