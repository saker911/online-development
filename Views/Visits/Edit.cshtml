@model VehiclePermitSystemWeb.Models.Entities.Visit

@{
    ViewData["Title"] = "تعديل الزيارة";
}

<div class="compact-form-shell">
    <form asp-action="Edit" method="post"
          class="card-permit app-card-surface app-form-surface compact-form-card permit-form needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="VisitId" type="hidden" />
        <input asp-for="Status" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="visually-hidden form-summary-only"></div>
        <partial name="_VisitFormFields" model="Model" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_VisitFormScripts" />
}