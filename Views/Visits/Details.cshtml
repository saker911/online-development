@using VehiclePermitSystemWeb.Security
@model VehiclePermitSystemWeb.Models.Entities.Visit
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = $"تفاصيل الزيارة {Model.VisitId}";
    var hideSensitiveIdentityFields = OnlineEditionSettings.HideSensitiveIdentityFields(Configuration);
    var canEdit = User.HasPermission(AppPermissions.EditVisit);
    var canApproveVisit = ViewData["CanApproveVisit"] as bool? == true;
    var canPrint = string.Equals(Model.ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase);
    var isSuspended = string.Equals(Model.Status, "Suspended", StringComparison.OrdinalIgnoreCase);
    var isCompleted = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase);
}

<div class="compact-form-shell">
    <div class="card-permit app-card-surface app-dashboard-surface compact-form-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
            <div>
                <h1 class="h5 mb-1">تفاصيل الزيارة @Model.VisitId</h1>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <span
                class="badge @(isCompleted ? "bg-secondary" : isSuspended ? "bg-dark" : "bg-success")">@Model.StatusDisplay</span>
                <span
                class="badge @(Model.ApprovalStatus == "Approved" ? "bg-success" : Model.ApprovalStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@Model.ApprovalStatusDisplay</span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <strong>الزائر الرئيسي</strong>
                <div>@Model.VisitorName</div>
            </div>
            <div class="col-md-6">
                <strong>الشخص المُزار</strong>
                <div>@Model.SubjectDisplay</div>
            </div>
            <div class="col-md-6">
                <strong>صفة الشخص المُزار</strong>
                <div>@Model.VisitedPersonTypeDisplay</div>
            </div>
            <div class="col-md-6">
                <strong>مكان الزيارة</strong>
                <div>@Model.VisitLocation</div>
            </div>
            @if (!hideSensitiveIdentityFields)
            {
                <div class="col-md-6">
                    <strong>المعرف الداخلي</strong>
                    <div class="national-id-field">@Model.NationalId</div>
                </div>
            }
            <div class="col-md-6">
                <strong>رقم الجوال</strong>
                <div class="national-id-field">@Model.PhoneNumber</div>
            </div>
            <div class="col-md-6">
                <strong>الغرض</strong>
                <div>@Model.Purpose</div>
            </div>
            <div class="col-md-6">
                <strong>عدد المرافقين</strong>
                <div>@Model.CompanionCount</div>
            </div>
            <div class="col-md-6">
                <strong>موعد الزيارة</strong>
                <div class="date-text">@HijriDateFormatter.Format(Model.VisitDate)</div>
            </div>
            <div class="col-md-6">
                <strong>تاريخ الانتهاء</strong>
                <div class="date-text">@(Model.ExpiresAt.HasValue? HijriDateFormatter.Format(Model.ExpiresAt) : "غير محدد")</div>
            </div>
            <div class="col-md-6">
                <strong>الدخول</strong>
                <div class="date-text">@(Model.EntryTime.HasValue? HijriDateFormatter.Format(Model.EntryTime) : "لم يسجل")</div>
            </div>
            <div class="col-md-6">
                <strong>الخروج</strong>
                <div class="date-text">@(Model.ExitTime.HasValue? HijriDateFormatter.Format(Model.ExitTime) : "لم يسجل")
                </div>
            </div>
            <div class="col-md-6">
                <strong>الاعتماد</strong>
                <div>@Model.ApprovalStatusDisplay</div>
            </div>
            <div class="col-md-6">
                <strong>الحالة</strong>
                <div>@Model.StatusDisplay</div>
            </div>
        </div>

        <div class="mt-4 p-3 rounded-3 border bg-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h2 class="h6 mb-0">المرافقون</h2>
                <span class="badge text-bg-light border">إجمالي المجموعة: @Model.GroupSize</span>
            </div>
            @if (Model.ActiveCompanions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>الاسم</th>
                                @if (!hideSensitiveIdentityFields)
                                {
                                    <th>المعرف الداخلي</th>
                                }
                                <th>الجوال</th>
                                <th>العلاقة</th>
                                <th>الدخول</th>
                                <th>الخروج</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var companion in Model.ActiveCompanions)
                            {
                                <tr>
                                    <td>@companion.FullName</td>
                                    @if (!hideSensitiveIdentityFields)
                                    {
                                        <td class="national-id-field">@companion.NationalId</td>
                                    }
                                    <td class="ltr-field">@companion.PhoneNumber</td>
                                    <td>@companion.Relationship</td>
                                    <td class="date-text">@(companion.EntryTime.HasValue ?
                                                                                                                                                                                HijriDateFormatter.Format(companion.EntryTime) : "-")</td>
                                        <td class="date-text">@(companion.ExitTime.HasValue ?
                                                                                                                                                                                                HijriDateFormatter.Format(companion.ExitTime) : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
            else
                    {
                        <div class="text-muted-ar small">لا يوجد مرافقون مرتبطون بهذه الزيارة.</div>
                    }
                </div>

                            <div class="mt-4 d-flex gap-2 flex-wrap">
                                <a asp-action="Index" class="btn btn-secondary">رجوع</a>
                                @if (canPrint)
                                {
                                    <a asp-action="Print" asp-route-id="@Model.VisitId" class="btn btn-info" target="_blank">طباعة PDF</a>
                                }
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.VisitId" class="btn btn-warning">تعديل</a>
                                }
                                @if (canApproveVisit)
                                {
                                    <form asp-action="ApproveDetained" asp-route-id="@Model.VisitId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success">اعتماد</button>
                                    </form>
                                    <form asp-action="RejectDetained" asp-route-id="@Model.VisitId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">رفض</button>
                                    </form>
                                }
                                @if (canEdit && !isSuspended)
                                {
                                    <form asp-action="Suspend" asp-route-id="@Model.VisitId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-dark">توقيف</button>
                                    </form>
                                }
                                @if (canEdit && isSuspended)
                                {
                                    <form asp-action="Resume" asp-route-id="@Model.VisitId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success">استئناف</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
