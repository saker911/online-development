@model VehiclePermitSystemWeb.Models.Entities.Visit

@{
    ViewData["Title"] = "إنشاء زيارة جديدة";
    var currentVisit = Model ?? new VehiclePermitSystemWeb.Models.Entities.Visit();
}

<div class="compact-form-shell">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h1 class="mb-0">إنشاء زيارة جديدة</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">العودة إلى القائمة</a>
    </div>
    <form asp-action="Create" method="post"
          class="card-permit app-card-surface app-form-surface compact-form-card permit-form needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Status" />
        <div asp-validation-summary="ModelOnly" class="visually-hidden form-summary-only"></div>
        <partial name="_VisitFormFields" model="Model" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_VisitFormScripts" />
}
