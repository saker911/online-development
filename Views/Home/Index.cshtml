@using System.Globalization
@using VehiclePermitSystemWeb.Security
@using VehiclePermitSystemWeb.Services.Tenants
@inject ITenantFeatureService TenantFeatureService
@{
    ViewData["Title"] = "مساحة العمل";
    ViewData["BodyClass"] = "dashboard-page-body portal-launcher-body";

    var pendingPermitCount = ViewBag.PendingPermitCount as int? ?? 0;
    var totalPermits = ViewBag.TotalPermits as int? ?? 0;
    var activePermits = ViewBag.ActivePermits as int? ?? 0;
    var totalVisits = ViewBag.TotalVisits as int? ?? 0;
    var suspendedVisits = ViewBag.SuspendedVisits as int? ?? 0;
    var currentUserName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "المستخدم";
    var tenantServices = TenantFeatureService.GetCurrent();

    var canViewPermits = tenantServices.Permits && User.HasPermission(AppPermissions.ViewPermits);
    var canViewVisits = tenantServices.Visits && User.HasPermission(AppPermissions.ViewVisits);
    var canViewPeople = User.HasPermission(AppPermissions.ViewDashboard)
        || canViewPermits
        || canViewVisits
        || User.HasPermission(AppPermissions.ManageUsers);
    var canViewAttendance = tenantServices.Gate
        && (User.HasPermission(AppPermissions.ViewDashboard)
            || User.HasPermission(AppPermissions.ScanOperations)
            || canViewPermits
            || canViewVisits);
    var canOperateGate = tenantServices.Gate && User.HasPermission(AppPermissions.ScanOperations);
    var canViewDisplays = tenantServices.Gate && User.HasPermission(AppPermissions.ViewDisplays);
    var canManageQueue = tenantServices.Queue
        && (User.HasPermission(AppPermissions.ApproveVisits) || User.HasPermission(AppPermissions.ScanOperations));
    var canManageUsers = User.HasPermission(AppPermissions.ManageUsers);
    var canManageAdministration = User.HasPermission(AppPermissions.ManageAdministration);
}

@section Styles {
    <link rel="stylesheet" href="~/css/workplace.css" asp-append-version="true" />
}

<div class="portal-launcher" aria-labelledby="portal-launcher-heading">
    <header class="portal-launcher-heading">
        <div>
            <span class="portal-launcher-eyebrow">مساحة العمل</span>
            <h1 id="portal-launcher-heading">مرحباً، @currentUserName</h1>
            <time datetime="@AppClock.LocalNow.ToString("yyyy-MM-dd")">
                @AppClock.LocalNow.ToString("dddd، dd MMMM", new CultureInfo("ar-SA"))
            </time>
        </div>
        <span class="portal-launcher-state"><i aria-hidden="true"></i> النظام يعمل</span>
    </header>

    <section class="portal-launcher-metrics" aria-label="ملخص اليوم">
        @if (tenantServices.Permits)
        {
            <article><strong>@totalPermits</strong><span>التصاريح</span></article>
            <article class="is-live"><strong>@activePermits</strong><span>الفعالة</span></article>
            <article><strong>@pendingPermitCount</strong><span>بانتظار الاعتماد</span></article>
        }
        @if (tenantServices.Visits)
        {
            <article><strong>@totalVisits</strong><span>الزيارات</span></article>
            <article><strong>@suspendedVisits</strong><span>الموقوفة</span></article>
        }
    </section>

    <section class="portal-feature-group" aria-labelledby="daily-tools-heading">
        <header>
            <h2 id="daily-tools-heading">التشغيل اليومي</h2>
            <span>ابدأ من الخدمة المطلوبة</span>
        </header>
        <div class="portal-feature-grid portal-feature-grid-primary">
            @if (canViewPermits)
            {
                <a class="portal-feature-card is-featured" asp-controller="Permits" asp-action="Index">
                    <span class="portal-feature-icon" aria-hidden="true">
                        <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#permit")"></use></svg>
                    </span>
                    <span class="portal-feature-copy">
                        <strong>التصاريح</strong>
                        <small>إنشاء الطلبات ومراجعتها واعتمادها</small>
                    </span>
                    @if (pendingPermitCount > 0)
                    {
                        <b class="portal-feature-badge">@pendingPermitCount</b>
                    }
                    <i class="portal-feature-arrow" aria-hidden="true">←</i>
                </a>
            }
            @if (canViewVisits)
            {
                <a class="portal-feature-card is-featured" asp-controller="Visits" asp-action="Index">
                    <span class="portal-feature-icon" aria-hidden="true">
                        <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#visit")"></use></svg>
                    </span>
                    <span class="portal-feature-copy">
                        <strong>الزيارات</strong>
                        <small>إدارة الزوار وروابط الطلب والمتابعة</small>
                    </span>
                    <i class="portal-feature-arrow" aria-hidden="true">←</i>
                </a>
            }
            @if (canOperateGate)
            {
                <a class="portal-feature-card is-featured" asp-controller="Display" asp-action="Gate">
                    <span class="portal-feature-icon" aria-hidden="true">
                        <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#scan")"></use></svg>
                    </span>
                    <span class="portal-feature-copy">
                        <strong>مركز البوابة</strong>
                        <small>قراءة الباركود وتسجيل الدخول والخروج</small>
                    </span>
                    <i class="portal-feature-arrow" aria-hidden="true">←</i>
                </a>
            }
        </div>
    </section>

    <section class="portal-feature-group" aria-labelledby="people-tools-heading">
        <header>
            <h2 id="people-tools-heading">الأفراد والمتابعة</h2>
        </header>
        <div class="portal-feature-grid portal-feature-grid-secondary">
            @if (canViewPeople)
            {
                <a class="portal-feature-card" asp-controller="People" asp-action="Index">
                    <span class="portal-feature-icon" aria-hidden="true">
                        <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#users")"></use></svg>
                    </span>
                    <span class="portal-feature-copy"><strong>الأشخاص</strong><small>ملفات الموظفين والزوار</small></span>
                    <i class="portal-feature-arrow" aria-hidden="true">←</i>
                </a>
            }
            @if (canViewAttendance)
            {
                <a class="portal-feature-card" asp-controller="Attendance" asp-action="Index">
                    <span class="portal-feature-icon" aria-hidden="true">
                        <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#attendance")"></use></svg>
                    </span>
                    <span class="portal-feature-copy"><strong>الحضور</strong><small>الحركة الحالية وسجل الدخول</small></span>
                    <i class="portal-feature-arrow" aria-hidden="true">←</i>
                </a>
            }
            @if (canManageQueue)
            {
                <a class="portal-feature-card" asp-controller="Queue" asp-action="Index">
                    <span class="portal-feature-icon" aria-hidden="true">
                        <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#queue")"></use></svg>
                    </span>
                    <span class="portal-feature-copy"><strong>تنظيم الطابور</strong><small>الأرقام والانتظار والاستدعاء</small></span>
                    <i class="portal-feature-arrow" aria-hidden="true">←</i>
                </a>
            }
            @if (canViewPermits || canViewVisits)
            {
                <a class="portal-feature-card" asp-controller="Reports" asp-action="Index">
                    <span class="portal-feature-icon" aria-hidden="true">
                        <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#reports")"></use></svg>
                    </span>
                    <span class="portal-feature-copy"><strong>التقارير</strong><small>السجلات والمؤشرات والتصدير</small></span>
                    <i class="portal-feature-arrow" aria-hidden="true">←</i>
                </a>
            }
        </div>
    </section>

    @if (canViewDisplays || canManageUsers || canManageAdministration)
    {
        <section class="portal-feature-group" aria-labelledby="manage-tools-heading">
            <header>
                <h2 id="manage-tools-heading">الإدارة</h2>
            </header>
            <div class="portal-feature-grid portal-feature-grid-secondary">
                @if (canViewDisplays || canManageAdministration)
                {
                    var displayController = canManageAdministration ? "Administration" : "Display";
                    var displayAction = canManageAdministration ? "DisplaySettings" : "Access";
                    <a class="portal-feature-card" asp-controller="@displayController" asp-action="@displayAction">
                        <span class="portal-feature-icon" aria-hidden="true">
                            <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#display")"></use></svg>
                        </span>
                        <span class="portal-feature-copy"><strong>شاشات العرض</strong><small>الأجهزة والإعدادات المعتمدة</small></span>
                        <i class="portal-feature-arrow" aria-hidden="true">←</i>
                    </a>
                }
                @if (canManageUsers)
                {
                    <a class="portal-feature-card" asp-controller="Users" asp-action="Index">
                        <span class="portal-feature-icon" aria-hidden="true">
                            <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#users")"></use></svg>
                        </span>
                        <span class="portal-feature-copy"><strong>فريق التشغيل</strong><small>الحسابات والأدوار والصلاحيات</small></span>
                        <i class="portal-feature-arrow" aria-hidden="true">←</i>
                    </a>
                }
                @if (canManageAdministration)
                {
                    <a class="portal-feature-card" asp-controller="Sites" asp-action="Index">
                        <span class="portal-feature-icon" aria-hidden="true">
                            <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#sites")"></use></svg>
                        </span>
                        <span class="portal-feature-copy"><strong>المواقع</strong><small>الفروع والبوابات ونطاقات العمل</small></span>
                        <i class="portal-feature-arrow" aria-hidden="true">←</i>
                    </a>
                    <a class="portal-feature-card" asp-controller="Administration" asp-action="Edit">
                        <span class="portal-feature-icon" aria-hidden="true">
                            <svg><use href="@Url.Content("~/icons/sidebar-actions.svg?v=20260812#administration")"></use></svg>
                        </span>
                        <span class="portal-feature-copy"><strong>إعدادات الجهة</strong><small>الهوية والخدمات وسياسات التشغيل</small></span>
                        <i class="portal-feature-arrow" aria-hidden="true">←</i>
                    </a>
                }
            </div>
        </section>
    }
</div>
