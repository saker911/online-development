@{
    ViewData["Title"] = "سياسة الخصوصية";
    ViewData["Description"] = $"سياسة خصوصية {ProductIdentity.DisplayName} وبيان جمع البيانات واستخدامها وحمايتها وحقوق أصحابها.";
    ViewData["CanonicalPath"] = "/privacy";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "public-content-body";
}
<main class="public-content-shell legal-page">
    @await Html.PartialAsync("~/Views/Shared/_PublicContentHeader.cshtml")
    <section class="public-content-hero compact"><span class="public-content-eyebrow">آخر تحديث: 1 أغسطس 2026</span><h1>سياسة الخصوصية</h1><p>توضح هذه السياسة كيف تعالج @ProductIdentity.DisplayName البيانات عند زيارة الموقع أو استخدام حساب جهة.</p></section>
    <div class="legal-layout">
        <aside class="legal-summary"><strong>الخلاصة</strong><p>نجمع ما يلزم لتشغيل الحساب وحمايته. بيانات الموظفين والزوار تدخلها الجهة المشتركة وتتحكم في أغراضها، بينما تعالجها المنصة تقنيًا لتقديم الخدمة.</p></aside>
        <article class="legal-document">
            <h2>1. الأدوار والمسؤوليات</h2><p>بالنسبة لبيانات فريق الجهة وموظفيها وزوارها، تكون الجهة المشتركة عادةً جهة التحكم، وتعمل @ProductIdentity.DisplayName بصفة معالج تقني وفق العقد وتعليمات الجهة. أما بيانات إنشاء الحساب والفوترة والدعم وأمن المنصة، فيعالجها مقدم الخدمة لإدارة العلاقة وتشغيل المنتج.</p>
            <h2>2. البيانات التي نعالجها</h2><ul><li>بيانات الحساب: الاسم، اسم المستخدم، البريد، الجوال، الجهة والدور.</li><li>بيانات التشغيل: التصاريح، المركبات، الزيارات، المرافقون، الموافقات وحركة الدخول والخروج.</li><li>بيانات أمنية وتقنية: الجلسات، عنوان IP، الجهاز، سجلات التدقيق ومحاولات الدخول.</li><li>بيانات الاشتراك: الباقة، المدة، حالة السداد والمرجع المالي. لا تخزن المنصة بيانات البطاقة البنكية ما لم يوضح مزود دفع معتمد خلاف ذلك.</li></ul>
            <h2>3. الأغراض والمسوغ</h2><p>نستخدم البيانات لتنفيذ الاشتراك، تشغيل الوظائف المطلوبة، حماية الحسابات، منع إساءة الاستخدام، تقديم الدعم، الوفاء بالالتزامات النظامية، وتحسين الاعتمادية. تحدد الجهة المشتركة مسوغ معالجة بيانات موظفيها وزوارها وتلتزم بإشعارهم.</p>
            <h2>4. الإفصاح ومقدمو الخدمة</h2><p>لا نبيع البيانات الشخصية. قد نعتمد على مزودي استضافة وبريد وهوية ودفع ودعم بالقدر اللازم، بعقود وضوابط مناسبة. لا نفصح لجهة عامة إلا عند وجود طلب نظامي ملزم.</p>
            <h2>5. مكان المعالجة والنقل</h2><p>قد تتم الاستضافة أو بعض الخدمات التقنية داخل المملكة أو خارجها بحسب البنية المتعاقد عليها. قبل التوسع التجاري يجب تحديد موقع كل مزود وتقييم متطلبات نقل البيانات عبر الحدود وتوثيقها في العقد وسجل المعالجة.</p>
            <h2>6. الاحتفاظ والإتلاف</h2><p>تُحفظ بيانات الحساب والتشغيل طوال مدة الاشتراك أو حسب سياسة الجهة والتزامات العقد والنظام. لا يدعي المنتج حاليًا حذفًا آليًا موحدًا لكل السجلات. عند الإنهاء تُتبع مدة التصدير والحذف المتفق عليها، ثم تزال النسخ القابلة للاستخدام وتخرج النسخ الاحتياطية وفق دورة الاستبدال الفنية.</p>
            <h2>7. حقوق أصحاب البيانات</h2><p>يحق لصاحب البيانات طلب العلم والوصول والتصحيح والحصول على نسخة أو الإتلاف وسحب الموافقة متى انطبق ذلك. طلبات الموظفين والزوار تبدأ لدى الجهة التي أدخلت بياناتهم، وتساعدها المنصة فنيًا في التنفيذ.</p>
            <h2>8. الحماية</h2><p>نطبق اتصال HTTPS، عزل الجهات، صلاحيات حسب الدور، حماية الجلسات وCSRF، تشفير كلمات المرور، سجلات تدقيق، نسخًا احتياطية، وفحصًا دوريًا للتبعيات. لا يوجد نظام خالٍ تمامًا من المخاطر، وتُدار الحوادث وفق أثرها والتزامات الإبلاغ المعمول بها.</p>
            <h2>9. ملفات الارتباط</h2><p>نستخدم ملفات ارتباط ضرورية فقط للجلسة والحماية وتفضيل المظهر وربط أجهزة العرض. لا نستخدم إعلانات سلوكية في النسخة الحالية.</p>
            <h2>10. التحديث والشكاوى</h2><p>قد تتغير السياسة عند تغير المنتج أو الموردين أو المتطلبات النظامية. ينشر تاريخ التحديث هنا. تبدأ الاستفسارات والشكاوى عبر قناة الدعم المثبتة في العقد أو بيانات مقدم الخدمة أدناه، ويظل لصاحب البيانات حق الرجوع إلى الجهة المختصة وفق الأنظمة.</p>
        </article>
    </div>
    @await Html.PartialAsync("~/Views/Shared/_ProviderIdentity.cshtml")
    @await Html.PartialAsync("~/Views/Shared/_PublicContentFooter.cshtml")
</main>
