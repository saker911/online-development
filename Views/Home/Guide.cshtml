@{
    ViewData["Title"] = "دليل استخدام منصة التصاريح";
    ViewData["Description"] = "دليل عربي لتجهيز الجهة وإدارة الفريق والتصاريح والزيارات والبوابات والتقارير بأمان.";
    ViewData["CanonicalPath"] = "/guide";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "public-content-body";
}
<main class="public-content-shell guide-page">
    @await Html.PartialAsync("~/Views/Shared/_PublicContentHeader.cshtml")
    <section class="public-content-hero compact"><span class="public-content-eyebrow">دليل المنتج</span><h1>من إنشاء الجهة إلى أول عبور ناجح</h1><p>مرجع مختصر لمالك الحساب والمدقق ومدير الأمن والاستقبال ومشغل البوابة.</p></section>
    <div class="guide-layout">
        <nav class="guide-toc" aria-label="فهرس الدليل"><strong>المحتويات</strong><a href="#start">البدء</a><a href="#team">الفريق والصلاحيات</a><a href="#permits">التصاريح</a><a href="#visits">الزيارات</a><a href="#gate">البوابة وQR</a><a href="#reports">التقارير</a><a href="#security-checklist">قائمة الإطلاق</a><a href="#support">حل المشكلات</a></nav>
        <article class="guide-document">
            <section id="start"><span>01</span><h2>تهيئة الجهة</h2><ol><li>أنشئ الحساب بالبريد المؤكد أو ابدأ تجربة Google.</li><li>راجع اسم الجهة والمسؤول وإعدادات الدوام.</li><li>أنشئ الأقسام والمواقع كمسميات تشغيلية.</li><li>أضف المستخدمين ثم امنح كل مستخدم أقل صلاحيات يحتاجها.</li></ol><p class="guide-note">لكل جهة رابط داخل المنصة بالشكل <code>/o/اسم-الجهة</code>. لا تحتاج الجهة إلى شراء دومين مستقل.</p></section>
            <section id="team"><span>02</span><h2>الفريق والصلاحيات</h2><div class="guide-role-grid"><div><strong>مالك الحساب / المدير العام</strong><p>الإعدادات والمستخدمون والاشتراك والإشراف.</p></div><div><strong>مدخل البيانات</strong><p>إنشاء الطلبات دون اعتمادها.</p></div><div><strong>المدقق</strong><p>مراجعة الطلبات وتحويلها لمسار الاعتماد.</p></div><div><strong>مدير الأمن</strong><p>الاعتماد والإيقاف والاستثناءات الأمنية.</p></div><div><strong>الاستقبال</strong><p>الزيارات والوصول والمغادرة.</p></div><div><strong>أمن البوابة</strong><p>المسح والحركة دون إدارة الحسابات.</p></div></div></section>
            <section id="permits"><span>03</span><h2>دورة التصريح</h2><ol><li>أدخل بيانات حامل التصريح والمركبة والمدة.</li><li>احفظ الطلب وراجعه قبل الرفع.</li><li>ينتقل الطلب للاعتماد حسب صلاحية المستخدم.</li><li>بعد الاعتماد تصدر بطاقة رقمية ورمز QR.</li><li>كل قراءة تسجل دخولًا أو خروجًا وفق الحالة والسياسة.</li><li>يمكن إيقاف التصريح أو إعادة تفعيله مع حفظ الأثر.</li></ol></section>
            <section id="visits"><span>04</span><h2>دورة الزيارة</h2><ol><li>سجل الزائر والمضيف والموعد والمرافقين عند الحاجة.</li><li>راجع الحالة واعتمد الزيارة الموقوفة من صاحب الصلاحية.</li><li>أرسل رابط البطاقة للزائر عبر قناة موثوقة.</li><li>يسجل الاستقبال أو البوابة الوصول ثم المغادرة.</li></ol></section>
            <section id="gate"><span>05</span><h2>تهيئة البوابة والمسح</h2><ol><li>افتح شاشة العرض على جهاز البوابة وأدخل مفتاح الإعداد.</li><li>اعتمد الجهاز من إعدادات الإدارة.</li><li>يدخل مشغل البوابة بحسابه وPIN الخاص به.</li><li>اختر الكاميرا أو جهاز الباركود أو الإدخال اليدوي المصرح.</li><li>اقرأ القرار الظاهر ولا تعتمد على لون البطاقة وحده.</li></ol><p class="guide-note">رابط QR العام يعرض بطاقة تحقق محدودة دون تسجيل دخول. يعامل كرابط حامل ولا يرسل في قناة عامة.</p></section>
            <section id="reports"><span>06</span><h2>التقارير والمتابعة</h2><p>استخدم التقارير لمتابعة حالة التصاريح والزيارات والحركة والمخالفات وسجل المستخدمين. راجع الفلاتر والتاريخ قبل الطباعة، واحتفظ بالتصدير وفق سياسة الجهة لا كنسخة شخصية غير محمية.</p></section>
            <section id="security-checklist"><span>07</span><h2>قائمة الإطلاق</h2><ul class="check-list"><li>حساب مالك النظام لا يستخدم يوميًا للتشغيل.</li><li>كل مستخدم يملك حسابًا مستقلًا وكلمة مرور قوية.</li><li>اختبار صلاحيات كل دور بحساب فعلي.</li><li>اعتماد أجهزة البوابة المعروفة فقط.</li><li>تجربة مسح تصريح صالح وموقوف ومنتهي.</li><li>تجربة انقطاع الشبكة وخطة العمل البديلة.</li><li>مراجعة سياسة الخصوصية وإشعار الموظفين والزوار.</li><li>تحديد مسؤول الدعم والحوادث داخل الجهة.</li></ul></section>
            <section id="support"><span>08</span><h2>حل المشكلات</h2><dl class="guide-faq"><div><dt>لا يظهر النظام بعد تسجيل الدخول</dt><dd>تحقق من حالة الاشتراك وصلاحيات الحساب ورابط الجهة الصحيح.</dd></div><div><dt>الكاميرا لا تعمل</dt><dd>استخدم HTTPS، اسمح بإذن الكاميرا، وأغلق التطبيقات التي تستخدمها.</dd></div><div><dt>QR لا يقبل</dt><dd>تحقق من الاعتماد والمدة وعدم الإيقاف، ثم اقرأ الرسالة التفصيلية.</dd></div><div><dt>المستخدم فقد الوصول</dt><dd>راجع نشاط الحساب والصلاحية والجلسة وحالة الجهة، ولا تشارك كلمة مرور بديلة.</dd></div></dl></section>
        </article>
    </div>
    @await Html.PartialAsync("~/Views/Shared/_PublicContentFooter.cshtml")
</main>
