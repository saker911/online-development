@{
    ViewData["Title"] = "شروط الاستخدام";
    ViewData["Description"] = "شروط استخدام منصة التصاريح والحسابات والاشتراكات وبيانات العملاء والاستخدام المقبول.";
    ViewData["CanonicalPath"] = "/terms";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "public-content-body";
}
<main class="public-content-shell legal-page">
    @await Html.PartialAsync("~/Views/Shared/_PublicContentHeader.cshtml")
    <section class="public-content-hero compact"><span class="public-content-eyebrow">آخر تحديث: 1 أغسطس 2026</span><h1>شروط الاستخدام</h1><p>تحكم هذه الشروط استخدام الموقع وحسابات تجربة منصة التصاريح، وتكملها شروط عرض السعر والعقد عند الاشتراك المدفوع.</p></section>
    <article class="legal-document standalone">
        <h2>1. أهلية الاستخدام</h2><p>المنتج موجه للجهات والأعمال. يؤكد منشئ الحساب أن لديه صلاحية تمثيل الجهة وإدخال بياناتها وقبول هذه الشروط.</p>
        <h2>2. الحساب والمسؤولية</h2><p>تلتزم الجهة بصحة بياناتها، حماية الحسابات وPIN، مراجعة الصلاحيات والأجهزة المعتمدة، وتعطيل المستخدم الذي تنتهي علاقته. لا يجوز مشاركة حساب فردي أو التحايل على ضوابط الوصول.</p>
        <h2>3. الاستخدام المقبول</h2><p>يمنع استخدام المنتج في نشاط غير مشروع، إدخال بيانات دون مسوغ، اختبار الاختراق دون تصريح مكتوب، إغراق الخدمة، نسخ المنتج أو تفكيكه، أو محاولة الوصول إلى بيانات جهة أخرى.</p>
        <h2>4. بيانات الجهة</h2><p>تحتفظ الجهة بحقوقها في بياناتها وتمنح مقدم الخدمة صلاحية معالجتها بالقدر اللازم لتشغيل المنصة وحمايتها ودعمها. الجهة مسؤولة عن إشعار موظفيها وزوارها وتحديد الصلاحيات ومدد الاحتفاظ المناسبة.</p>
        <h2>5. الخدمة والتغييرات</h2><p>يعمل مقدم الخدمة على توفير منتج موثوق، وقد يجري تحديثات أمنية أو تشغيلية أو صيانة. لا تعد عبارات الموقع اتفاقية مستوى خدمة ما لم تعتمد نسبة توافر وزمن استجابة صراحةً في عقد مستقل.</p>
        <h2>6. التجربة</h2><p>التجربة محدودة المدة ومخصصة للتقييم، وقد تكون وظائف الدعم أو الاستمرارية فيها مختلفة عن الاشتراك المدفوع. يجوز إنهاء التجارب المتكررة أو المسيئة.</p>
        <h2>7. الرسوم والضرائب</h2><p>يظهر السعر والمدة قبل التأكيد. تحدد الفاتورة ما إذا كان السعر شاملًا للضريبة، وتطبق الضرائب النظامية عند انطباقها. لا يتم تفعيل اشتراك يدوي السداد قبل تأكيد التحصيل.</p>
        <h2>8. التعليق والإنهاء</h2><p>يجوز تعليق الحساب عند انتهاء المدة أو فشل السداد أو وجود خطر أمني أو مخالفة جوهرية. يوضح العقد مهلة معالجة المخالفة، تصدير البيانات، وموعد الإزالة بعد الإنهاء.</p>
        <h2>9. الملكية الفكرية</h2><p>البرنامج والتصميم والعلامة والوثائق مملوكة لمقدم الخدمة أو مرخصيه. الاشتراك يمنح حق استخدام محدودًا وغير قابل للنقل طوال مدة الاشتراك.</p>
        <h2>10. الضمان والمسؤولية</h2><p>المنصة أداة تشغيل مساعدة وليست بديلًا عن القرار الأمني البشري أو خطة الطوارئ. تُحدد الضمانات وحدود المسؤولية والتعويضات في العقد وبما لا يخالف الحقوق التي لا يجوز استبعادها نظامًا.</p>
        <h2>11. النظام الحاكم</h2><p>تخضع العلاقة للأنظمة السارية في المملكة العربية السعودية، وتُحل النزاعات وفق الجهة المختصة أو الآلية المتفق عليها في العقد.</p>
    </article>
    @await Html.PartialAsync("~/Views/Shared/_ProviderIdentity.cshtml")
    @await Html.PartialAsync("~/Views/Shared/_PublicContentFooter.cshtml")
</main>
