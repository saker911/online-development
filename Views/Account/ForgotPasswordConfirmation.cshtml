@using VehiclePermitSystemWeb.Services.Administration
@{
    ViewData["Title"] = "تحقق من بريدك";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "login-page-body";
    var tenant = ViewData["Tenant"] as string ?? string.Empty;
}

<div class="login-page-shell login-page-shell-light">
    <header class="login-page-topbar">
        <a asp-controller="Home" asp-action="Index" class="login-page-topbar-brand">
            <img src="~/@ProductIdentity.MarkPath" asp-append-version="true" alt="" data-product-mark />
            <span><strong>@ProductIdentity.DisplayName</strong><small>استعادة الحساب</small></span>
        </a>
        @await Html.PartialAsync("~/Views/Shared/_PublicThemeToggle.cshtml")
    </header>

    <section class="login-page-card login-page-card-light login-status-card">
        <span class="login-status-icon" aria-hidden="true">✓</span>
        <h1 class="login-page-title">تحقق من بريدك</h1>
        <p class="login-page-subtitle">راجع بريدك الإلكتروني لإكمال استعادة الحساب.</p>
        <a asp-controller="Account" asp-action="Login" asp-route-tenant="@tenant" class="btn btn-primary login-submit-button">العودة إلى تسجيل الدخول</a>
    </section>
</div>
