@model VehiclePermitSystemWeb.Models.ViewModels.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغيير الرقم السري";
    var forcePasswordChange = ViewData["ForcePasswordChange"] as bool? ?? false;
}

<div class="account-password-shell compact-form-shell">
    <section class="account-password-hero card-permit app-card-surface app-form-surface compact-form-card">
        <div>
            <span class="account-profile-kicker account-profile-kicker-warm">الحماية الشخصية</span>
            <h1>تغيير الرقم السري</h1>
            <p>واجهة مستقلة وحديثة لتحديث كلمة المرور مع إبقاء بقية بيانات الحساب والصلاحيات خارج نطاق التعديل.</p>
        </div>

        <div class="account-password-rules">
            <strong>قواعد كلمة المرور</strong>
            <span>8 أحرف على الأقل</span>
            <span>حرف كبير وحرف صغير</span>
            <span>رقم ورمز خاص</span>
        </div>
    </section>

    <section class="account-password-panel card-permit app-card-surface app-form-surface compact-form-card">
        @if (forcePasswordChange)
        {
            <div class="app-inline-note app-inline-note-warning mb-3">
                يجب تغيير كلمة المرور الافتراضية قبل متابعة استخدام النظام.
            </div>
        }

        <form asp-action="ChangePassword" method="post" class="account-password-form needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="visually-hidden form-summary-only"></div>

            <div class="account-password-grid">
                <div class="account-password-field">
                    <label asp-for="CurrentPassword" class="form-label">كلمة المرور الحالية</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" />
                </div>
                <div class="account-password-field">
                    <label asp-for="NewPassword" class="form-label">كلمة المرور الجديدة</label>
                    <input asp-for="NewPassword" type="password" class="form-control" />
                    <span asp-validation-for="NewPassword" class="field-validation-error small"></span>
                </div>
                <div class="account-password-field">
                    <label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                </div>
            </div>

            <div class="account-password-note">
                سيتم تحديث الرقم السري فقط، ولن يتم تغيير أي دور أو صلاحية أو بيانات حساب أخرى من هذه الشاشة.
            </div>

            <div class="account-password-actions">
                <button type="submit" class="btn btn-primary">حفظ كلمة المرور</button>
                @if (!forcePasswordChange)
                {
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">العودة إلى
                        بياناتي</a>
                    }
                </div>
            </form>
        </section>
    </div>