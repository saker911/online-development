@using VehiclePermitSystemWeb.Services.Administration
@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "استعادة كلمة المرور";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "login-page-body";
}

<div class="login-page-shell login-page-shell-light">
    <header class="login-page-topbar">
        <a asp-controller="Home" asp-action="Index" class="login-page-topbar-brand">
            <img src="~/@ProductIdentity.MarkPath" asp-append-version="true" alt="" data-product-mark />
            <span><strong>@ProductIdentity.DisplayName</strong><small>استعادة الحساب</small></span>
        </a>
        <div class="login-page-topbar-actions">
            @await Html.PartialAsync("~/Views/Shared/_PublicThemeToggle.cshtml")
            <a asp-controller="Account" asp-action="Login" asp-route-tenant="@Model.Tenant" class="login-back-link">تسجيل الدخول</a>
        </div>
    </header>

    <section class="login-page-card login-page-card-light">
        <span class="login-page-kicker">استعادة الحساب</span>
        <h1 class="login-page-title">نسيت كلمة المرور؟</h1>
        <p class="login-page-subtitle">أدخل اسم المستخدم أو البريد الإلكتروني.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="login-form-grid">
            <input asp-for="Tenant" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="login-validation-summary"></div>
            <div class="login-field">
                <label asp-for="AccountIdentifier" class="form-label"></label>
                <input asp-for="AccountIdentifier" class="form-control" autocomplete="username" dir="auto"
                       placeholder="اسم المستخدم أو البريد الإلكتروني" />
                <span asp-validation-for="AccountIdentifier" class="field-validation-error"></span>
            </div>
            <button class="btn btn-primary login-submit-button" type="submit">متابعة</button>
            <div class="login-secondary-action">
                <a asp-controller="Account" asp-action="Login" asp-route-tenant="@Model.Tenant">العودة إلى تسجيل الدخول</a>
            </div>
        </form>
    </section>
</div>
