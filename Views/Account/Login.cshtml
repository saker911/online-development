@using VehiclePermitSystemWeb.Services.Administration
@inject VehiclePermitSystemWeb.Services.Users.IUserAdminService UserAdminService

@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "login-page-body";
    var submittedUsername = ViewData["SubmittedUsername"] as string ?? string.Empty;
    var tenant = ViewData["Tenant"] as string ?? Context.Request.Query["tenant"].FirstOrDefault() ?? string.Empty;
    var tenantName = ViewData["TenantName"] as string ?? string.Empty;
    var administrationSettings = string.IsNullOrWhiteSpace(tenant)
        ? UserAdminService.GetAdministrationSettings()
        : UserAdminService.GetAdministrationSettings(tenant, ignoreTenantFilters: true);
    var organizationName = OrganizationBranding.GetOrganizationName(administrationSettings);
}

<div class="login-page-shell login-page-shell-light">
    <header class="login-page-topbar">
        <a asp-controller="Home" asp-action="Index" class="login-page-topbar-brand">
            <img src="~/@ProductIdentity.MarkPath" asp-append-version="true" alt="" data-product-mark />
            <span>
                <strong>@ProductIdentity.DisplayName</strong>
                <small>@organizationName</small>
            </span>
        </a>
        <div class="login-page-topbar-actions">
            @await Html.PartialAsync("~/Views/Shared/_PublicThemeToggle.cshtml")
            <a asp-controller="Home" asp-action="Index" class="login-back-link">العودة للرئيسية</a>
        </div>
    </header>

    <section class="login-page-card login-page-card-light">
        <h1 class="login-page-title">@(string.IsNullOrWhiteSpace(tenantName) ? "تسجيل الدخول" : $"الدخول إلى {tenantName}")</h1>
        <p class="login-page-subtitle">ادخل إلى حساب جهتك وتابع التصاريح والزيارات والبوابات.</p>

        @await Html.PartialAsync(
            "~/Views/Subscription/_SocialSignupActions.cshtml",
            new ExternalAuthActionsViewModel { Mode = "Login", Tenant = tenant }
        )

        <form method="post" asp-controller="Account" asp-action="Login" class="login-form-grid">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tenant" value="@tenant" />
            <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] as string ?? string.Empty)" />
            <div class="login-field">
                <label for="login-username" class="form-label">اسم المستخدم</label>
                <input id="login-username" name="username" class="form-control" autocomplete="username" inputmode="numeric"
                       pattern="[12][0-9]{9}" minlength="10" maxlength="10"
                       title="المعرف الداخلي يجب أن يكون 10 أرقام ويبدأ بـ 1 أو 2" value="@submittedUsername" />
            </div>
            <div class="login-field">
                <label for="login-password" class="form-label">كلمة المرور</label>
                <div class="login-password-control">
                    <input id="login-password" name="password" type="password" class="form-control"
                           autocomplete="current-password" />
                    <button type="button" class="login-password-toggle" aria-controls="login-password"
                            aria-pressed="false">إظهار</button>
                </div>
                <a asp-controller="Account" asp-action="ForgotPassword" asp-route-tenant="@tenant"
                   class="login-recovery-link">نسيت كلمة المرور؟</a>
            </div>
            <button class="btn btn-primary login-submit-button" type="submit">تسجيل الدخول</button>
            <div class="login-secondary-action">
                <span>ليس لديك حساب؟</span>
                <a asp-controller="Subscription" asp-action="Plans">إنشاء حساب واختيار باقة</a>
            </div>
        </form>
    </section>
</div>

@{
    var cspScriptNonce = Context.Items["CspScriptNonce"] as string;
}
<script nonce="@cspScriptNonce">
    (() => {
        const usernameInput = document.getElementById('login-username');
        const passwordInput = document.getElementById('login-password');
        const passwordToggle = document.querySelector('.login-password-toggle');

        usernameInput?.addEventListener('input', () => {
            usernameInput.value = usernameInput.value.replace(/\D/g, '').slice(0, 10);
        });

        passwordToggle?.addEventListener('click', () => {
            const showPassword = passwordInput.type === 'password';
            passwordInput.type = showPassword ? 'text' : 'password';
            passwordToggle.textContent = showPassword ? 'إخفاء' : 'إظهار';
            passwordToggle.setAttribute('aria-pressed', showPassword ? 'true' : 'false');
        });
    })();
</script>
