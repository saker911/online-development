@using VehiclePermitSystemWeb.Services.Administration
@inject VehiclePermitSystemWeb.Services.Users.IUserAdminService UserAdminService

@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "login-page-body";
    var submittedUsername = ViewData["SubmittedUsername"] as string ?? string.Empty;
    var administrationSettings = UserAdminService.GetAdministrationSettings();
    var organizationName = OrganizationBranding.GetOrganizationName(administrationSettings);
    var organizationLogoPath = OrganizationBranding.GetLogoPath(administrationSettings);
}

<div class="login-page-shell">
    <div class="login-page-overlay"></div>

    <section class="login-page-card">
        <img src="~/@organizationLogoPath" alt="" class="login-page-watermark" />
        <div class="login-page-brand-row">
            <img src="~/@organizationLogoPath" alt="شعار @organizationName" class="login-page-logo" />
            <div>
                <div class="login-page-kicker">نظام التصاريح</div>
                <div class="login-page-brand-name">@organizationName</div>
            </div>
        </div>
        <h1 class="login-page-title">تسجيل الدخول</h1>
        <p class="login-page-subtitle">الدخول إلى نظام إدارة تصاريح المركبات والزيارات من بوابة آمنة بتصميم موحّد مع
            بيئة النظام.</p>

            <form method="post" asp-controller="Account" asp-action="Login" class="login-form-grid">
                @Html.AntiForgeryToken()
                <div class="login-field">
                    <label for="login-username" class="form-label">اسم المستخدم</label>
                      <input id="login-username" name="username" class="form-control" autocomplete="username" inputmode="numeric"
                          pattern="[12][0-9]{9}" minlength="10" maxlength="10" title="رقم الهوية أو الإقامة يجب أن يكون 10 أرقام ويبدأ بـ 1 للسعودي أو 2 للمقيم"
                          value="@submittedUsername" />
                </div>
                <div class="login-field">
                    <label for="login-password" class="form-label">كلمة المرور</label>
                    <input id="login-password" name="password" type="password" class="form-control" autocomplete="current-password" />
                </div>
                <button class="btn btn-primary login-submit-button" type="submit">دخول</button>
            </form>
        </section>
    </div>

@{
    var cspScriptNonce = Context.Items["CspScriptNonce"] as string;
}
<script nonce="@cspScriptNonce">
    (() => {
        const usernameInput = document.getElementById('login-username');
        if (!usernameInput) {
            return;
        }

        usernameInput.addEventListener('input', () => {
            usernameInput.value = usernameInput.value.replace(/\D/g, '').slice(0, 10);
        });
    })();
</script>
