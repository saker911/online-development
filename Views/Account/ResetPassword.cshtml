@using VehiclePermitSystemWeb.Services.Administration
@model ResetPasswordViewModel

@{
    ViewData["Title"] = "تعيين كلمة مرور جديدة";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "login-page-body";
    var resetError = ViewData["ResetError"] as string;
    var tenant = ViewData["Tenant"] as string ?? string.Empty;
}

<div class="login-page-shell login-page-shell-light">
    <header class="login-page-topbar">
        <a asp-controller="Home" asp-action="Index" class="login-page-topbar-brand">
            <img src="~/@ProductIdentity.MarkPath" asp-append-version="true" alt="" data-product-mark />
            <span><strong>@ProductIdentity.DisplayName</strong><small>حماية الحساب</small></span>
        </a>
        @await Html.PartialAsync("~/Views/Shared/_PublicThemeToggle.cshtml")
    </header>

    <section class="login-page-card login-page-card-light">
        @if (!string.IsNullOrWhiteSpace(resetError))
        {
            <div class="login-status-card">
                <span class="login-status-icon is-error" aria-hidden="true">!</span>
                <h1 class="login-page-title">تعذر استخدام الرابط</h1>
                <p class="login-page-subtitle">@resetError</p>
                <a asp-controller="Account" asp-action="ForgotPassword" asp-route-tenant="@tenant" class="btn btn-primary login-submit-button">طلب رابط جديد</a>
            </div>
        }
        else
        {
            <span class="login-page-kicker">حماية الحساب</span>
            <h1 class="login-page-title">كلمة مرور جديدة</h1>
            <p class="login-page-subtitle">استخدم 8 أحرف على الأقل مع حرف كبير وصغير ورقم ورمز خاص.</p>

            <form asp-controller="Account" asp-action="ResetPassword" method="post" class="login-form-grid">
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="login-validation-summary"></div>
                <div class="login-field">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>
                <div class="login-field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
                <button class="btn btn-primary login-submit-button" type="submit">حفظ كلمة المرور</button>
            </form>
        }
    </section>
</div>
