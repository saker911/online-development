@model TenantCheckoutViewModel

@{
    ViewData["Title"] = "إتمام الدفع";
    ViewData["HideShell"] = true;
    ViewData["BodyClass"] = "subscription-page-body";
    ViewData["PublicHeaderActionLabel"] = "تسجيل الدخول";
    ViewData["PublicHeaderActionController"] = "Account";
    ViewData["PublicHeaderActionName"] = "Login";
}

<main class="subscription-page-shell">
    @await Html.PartialAsync("~/Views/Shared/_SubscriptionTopbar.cshtml")
    <section class="subscription-shell subscription-checkout-shell">
        <div class="subscription-heading">
            <div>
                <div class="login-page-kicker">بانتظار الدفع</div>
                <h1 class="login-page-title">تم إنشاء حساب @Model.CompanyName</h1>
                <p class="login-page-subtitle">يمكنك الدخول الآن ومراجعة حسابك، وتظهر خدمات التشغيل تلقائياً بعد تأكيد الدفع.</p>
            </div>
            <div class="subscription-heading-actions">
                <span class="badge bg-warning text-dark">@Model.SubscriptionStatusDisplayName</span>
            </div>
        </div>

        <div class="subscription-checkout-grid">
            <div class="subscription-checkout-summary">
                <h2>ملخص الاشتراك</h2>
                <div><span>الجهة</span><strong>@Model.CompanyName</strong></div>
                <div><span>المعرف</span><strong dir="ltr">@Model.TenantId</strong></div>
                <div><span>الباقة</span><strong>@Model.PlanName</strong></div>
                <div><span>مدة الاشتراك</span><strong>@(Model.DurationMonths <= 0 ? "حسب الاتفاق" : $"{Model.DurationMonths} شهر")</strong></div>
                <div><span>قيمة الاشتراك</span><strong>@(Model.TotalPrice <= 0 ? "حسب الاتفاق" : $"{Model.TotalPrice:0} ر.س")</strong></div>
                <div><span>مرجع الدفع</span><strong dir="ltr">@Model.PaymentReference</strong></div>
            </div>

            <div class="subscription-payment-box">
                <h2>سياسة التفعيل</h2>
                <p>في الربط الحقيقي سيتم تحويل العميل إلى بوابة الدفع، ثم يستقبل النظام تأكيد السداد عبر Webhook ويحوّل الاشتراك إلى نشط تلقائيًا.</p>
                <p>حاليًا يستطيع مالك المنصة تفعيل الاشتراك يدويًا من لوحة الجهات بعد استلام السداد.</p>
                @if (!string.IsNullOrWhiteSpace(Model.ExternalProvider))
                {
                    <a asp-controller="Account" asp-action="ExternalLogin"
                       asp-route-provider="@Model.ExternalProvider"
                       asp-route-tenant="@Model.TenantId"
                       class="btn btn-primary w-100">الدخول الآن عبر حسابي</a>
                }
                else
                {
                    <a href="@Model.LoginUrl" class="btn btn-primary w-100">الدخول إلى الحساب</a>
                }
                <small class="d-block mt-3 text-muted">قبل التفعيل يقتصر الحساب على الملف الشخصي وحالة الاشتراك، دون صلاحيات تشغيل.</small>
            </div>
        </div>
    </section>
</main>
