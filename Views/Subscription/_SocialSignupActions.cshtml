@model ExternalAuthActionsViewModel
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment

@{
    var isLogin = string.Equals(Model.Mode, "Login", StringComparison.OrdinalIgnoreCase);
    var googleConfigured = !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"])
        && !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
    var showProviderSetupState = HostEnvironment.IsDevelopment();
}

@if (googleConfigured || showProviderSetupState)
{
    <section class="external-auth-panel @(isLogin ? "external-auth-panel-login" : "external-auth-panel-register")"
             aria-label="الدخول السريع عبر Google">
        <div class="external-auth-copy">
            <strong>@(isLogin ? "الدخول بحساب Google" : "جرّب النظام فوراً")</strong>
            <span>@(isLogin
                ? "ادخل بحسابك المرتبط دون كلمة مرور إضافية."
                : "ينشئ Google مساحة تجربة كاملة لمدة يومين ويدخلك مباشرة.")</span>
        </div>
        <a asp-controller="Account"
           asp-action="ExternalLogin"
           asp-route-provider="Google"
           asp-route-tenant="@Model.Tenant"
           class="external-auth-google-button @(googleConfigured ? "" : "is-unavailable")"
           aria-label="المتابعة باستخدام Google"
           title="@(googleConfigured ? "المتابعة باستخدام Google" : "يتطلب إعداد Google OAuth")">
            <img src="~/images/brands/google.svg" alt="" />
            <strong>@(isLogin ? "الدخول باستخدام Google" : "ابدأ تجربة يومين باستخدام Google")</strong>
        </a>
        @if (!isLogin)
        {
            <p class="external-auth-legal-note">
                بالمتابعة أنت توافق على <a asp-controller="Home" asp-action="Terms" target="_blank" rel="noopener">الشروط</a>
                و<a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">الخصوصية</a>.
            </p>
        }
        <div class="external-auth-divider"><span>أو سجّل بالبريد الإلكتروني</span></div>
    </section>
}
