@model VehiclePermitSystemWeb.Models.ViewModels.Permits.PermitApproveViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var approveReturnUrl = Url.Action("Details", "Permits", new { id = Model.PermitNumber });
}

<div class="compact-form-shell">
    <div class="card-permit mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="mb-1">اعتماد التصريح</h1>
            </div>
            <a asp-action="Details" asp-route-id="@Model.PermitNumber" class="btn btn-outline-secondary">رجوع إلى
                التفاصيل</a>
            </div>
        </div>

        <div class="card-permit mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>رقم التصريح</strong>
                    <div class="permit-number-pill d-inline-flex mt-1">@Model.PermitNumber</div>
                </div>
                <div class="col-md-4">
                    <strong>الاسم</strong>
                    <div>@Model.DriverName</div>
                </div>
                <div class="col-md-4">
                    <strong>نوع التصريح</strong>
                    <div>@Model.PermitTypeDisplay</div>
                </div>
                <div class="col-md-4">
                    <strong>نوع الحركة الحالي</strong>
                    <div>@Model.ReturnRequirementDisplay</div>
                </div>
            </div>
        </div>

        <form asp-action="Approve" asp-route-returnUrl="@approveReturnUrl" method="post" class="card-permit">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PermitNumber" />

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">اعتماد مباشر</button>
                <a asp-action="Details" asp-route-id="@Model.PermitNumber" class="btn btn-secondary">إلغاء</a>
            </div>
        </form>
    </div>
