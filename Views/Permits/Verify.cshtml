@model VehiclePermitSystemWeb.Models.ViewModels.Permits.PermitVerificationViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "التحقق من التصريح";
    var hideSensitiveIdentityFields = OnlineEditionSettings.HideSensitiveIdentityFields(Configuration);
}

<div class="card-permit card-permit-compact mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1 class="mb-0">@Model.Title</h1>
        <span class="badge @Model.BadgeClass fs-6">@Model.StatusText</span>
    </div>

    <div
        class="app-inline-note @(Model.IsAuthorized ? "app-inline-note-success" : Model.IsExpired ? "app-inline-note-warning" : "app-inline-note-danger") mb-4">
        @Model.Message
    </div>

    @if (ViewData["PermitNotice"] is string permitNotice && !string.IsNullOrWhiteSpace(permitNotice))
    {
        <div class="app-inline-note app-inline-note-warning mb-4">
            @permitNotice
        </div>
    }

    @if (Model.Permit != null)
    {
        <div class="row g-3">
            <div class="col-md-6">
                <strong>رقم التصريح</strong>
                <div>@Model.Permit.PermitNumber</div>
            </div>
            <div class="col-md-6">
                <strong>@(Model.Permit.IsVisitorPermit ? "اسم الزائر" : "اسم المصرح له")</strong>
                <div>@Model.Permit.DriverName</div>
            </div>
            @if (!hideSensitiveIdentityFields)
            {
                <div class="col-md-6">
                    <strong>رقم الهوية</strong>
                    <div class="national-id-field">@Model.Permit.NationalId</div>
                </div>
            }
            <div class="col-md-6">
                <strong>@(Model.Permit.IsVisitorPermit ? "مكان الزيارة" : "موقع العمل")</strong>
                <div>@Model.Permit.LocationDisplay</div>
            </div>
            @if (!Model.Permit.IsVisitorPermit)
            {
                <div class="col-md-6">
                    <strong>مدير الموظف</strong>
                    <div>@Model.Permit.ManagerName</div>
                </div>
            }
            <div class="col-md-6">
                <strong>تاريخ التصريح</strong>
                <div class="date-text">@(Model.Permit.PermitDate.HasValue ?
                                                                HijriDateFormatter.Format(Model.Permit.PermitDate) : "غير محدد")</div>
                </div>
                <div class="col-md-6">
                    <strong>رقم الجوال</strong>
                    <div>@Model.Permit.EmployeePhone</div>
                </div>
                <div class="col-md-6">
                    <strong>نوع المركبة</strong>
                    <div>@Model.Permit.VehicleType</div>
                </div>
                <div class="col-md-6">
                    <strong>رقم اللوحة</strong>
                    <div>@Model.Permit.PlateNumberDisplay</div>
                </div>
                <div class="col-md-6">
                    <strong>الحالة الحالية</strong>
                    <div>@Model.Permit.ApprovalStatusDisplay</div>
                </div>
                <div class="col-12">
                    <strong>تاريخ الانتهاء</strong>
                    <div class="date-text">@(Model.Permit.IsVisitorPermit && !Model.Permit.ExpiresAt.HasValue ? "يحدد تلقائيا بعد دخول الزائر" : Model.Permit.ExpiresAt.HasValue ? HijriDateFormatter.Format(Model.Permit.ExpiresAt) :
                                                              "غير محدد")</div>
                    </div>
                </div>
            }
    else
            {
                <div class="text-muted-ar">لا توجد بيانات صالحة مرتبطة بهذا الرمز.</div>
            }
        </div>
