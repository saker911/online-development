@model VehiclePermitSystemWeb.Models.ViewModels.Permits.PermitVerificationViewModel

@{
    ViewData["Title"] = "التحقق من التصريح";
    var stateClass = Model.IsAuthorized ? "is-authorized" : Model.IsExpired ? "is-expired" : "is-denied";
    var expiryText = Model.ExpiresAt.HasValue
        ? HijriDateFormatter.Format(Model.ExpiresAt)
        : "حسب مدة الزيارة";
}

<section class="permit-verification-shell" aria-labelledby="permit-verification-title">
    <article class="permit-verification-card @stateClass">
        <header class="permit-verification-brand">
            <span class="permit-verification-mark" aria-hidden="true">@((Model.OrganizationName.FirstOrDefault() == default) ? "ت" : Model.OrganizationName.First())</span>
            <div>
                <span>@ProductIdentity.DisplayName</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.OrganizationName) ? "التحقق الرقمي" : Model.OrganizationName)</strong>
            </div>
        </header>

        <div class="permit-verification-state" aria-hidden="true">
            <span>@(Model.IsAuthorized ? "✓" : Model.IsExpired ? "!" : "×")</span>
        </div>

        <div class="permit-verification-heading">
            <span class="permit-verification-badge">@Model.StatusText</span>
            <h1 id="permit-verification-title">@Model.Title</h1>
            <p>@Model.Message</p>
        </div>

        @if (Model.IsValid)
        {
            <dl class="permit-verification-details">
                <div>
                    <dt>رمز التصريح</dt>
                    <dd dir="ltr">@Model.PermitNumber</dd>
                </div>
                <div>
                    <dt>نوع التصريح</dt>
                    <dd>@Model.PermitTypeDisplay</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.PlateNumberDisplay))
                {
                    <div>
                        <dt>رقم اللوحة</dt>
                        <dd>@Model.PlateNumberDisplay</dd>
                    </div>
                }
                <div>
                    <dt>الصلاحية</dt>
                    <dd class="date-text">@expiryText</dd>
                </div>
            </dl>

            @if (ViewData["PermitNotice"] is string permitNotice && !string.IsNullOrWhiteSpace(permitNotice))
            {
                <div class="permit-verification-notice">@permitNotice</div>
            }
        }
        else
        {
            <div class="permit-verification-empty">لا توجد بيانات تصريح صالحة مرتبطة بهذا الرمز.</div>
        }

        <footer class="permit-verification-footer">
            تُعرض بيانات التحقق الأساسية فقط حفاظًا على خصوصية حامل التصريح.
        </footer>
    </article>
</section>
