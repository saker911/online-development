@model VehiclePermitSystemWeb.Models.ViewModels.Tenants.TenantManagementViewModel
@using VehiclePermitSystemWeb.Models.Entities

@{
    ViewData["Title"] = "إدارة الجهات";
    var isEditMode = !string.IsNullOrWhiteSpace(Model.Editor.TenantId);
    var forceEditorOpen = isEditMode || !ViewData.ModelState.IsValid;

    string GetSubscriptionClass(string status) => status switch
    {
        TenantSubscriptionStatuses.PendingPayment => "is-pending",
        TenantSubscriptionStatuses.Trial => "is-trial",
        TenantSubscriptionStatuses.Active => "is-active",
        TenantSubscriptionStatuses.Suspended => "is-suspended",
        TenantSubscriptionStatuses.Expired => "is-expired",
        _ => "is-neutral",
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/tenants-pages.css" asp-append-version="true" />
}

<div class="tenants-page">
    <header class="tenants-header">
        <div class="tenants-header-copy">
            <span class="tenants-kicker">إدارة المنصة</span>
            <h1>إدارة الجهات</h1>
            <p>متابعة الاشتراكات والحسابات والاستخدام من مكان واحد.</p>
        </div>
        <button type="button" class="btn btn-primary" data-open-tenant-editor>
            إضافة جهة
        </button>
    </header>

    <div class="tenants-stat-strip" aria-label="ملخص الجهات">
        <div><span>إجمالي الجهات</span><strong>@Model.TotalTenants</strong></div>
        <div><span>الجهات النشطة</span><strong>@Model.ActiveTenants</strong></div>
        <div><span>غير المتاحة</span><strong>@Model.BlockedTenants</strong></div>
        <div><span>إجمالي الحسابات</span><strong>@Model.TotalUsers</strong></div>
    </div>

    <details class="tenant-editor" id="tenantEditor" data-force-open="@forceEditorOpen.ToString().ToLowerInvariant()">
        <summary>
            <span>
                <strong>@(isEditMode ? "تعديل الجهة" : "إضافة جهة جديدة")</strong>
                <small>@(isEditMode ? Model.Editor.Name : "بيانات الجهة والاشتراك والرابط المختصر")</small>
            </span>
            <span class="tenant-editor-chevron" aria-hidden="true">⌄</span>
        </summary>

        <form asp-action="@(isEditMode ? "Update" : "Create")"
              asp-route-id="@(isEditMode ? Model.Editor.TenantId : null)"
              method="post"
              class="tenant-editor-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>

            <div class="tenant-form-grid">
                <div class="tenant-field tenant-field-wide">
                    <label asp-for="Editor.Name"></label>
                    <input asp-for="Editor.Name" name="Name" class="form-control" />
                    <span asp-validation-for="Editor.Name" class="field-validation-error"></span>
                </div>
                <div class="tenant-field">
                    <label asp-for="Editor.TenantId"></label>
                    <input asp-for="Editor.TenantId" name="TenantId" class="form-control ltr-field" readonly="@isEditMode" />
                    <span asp-validation-for="Editor.TenantId" class="field-validation-error"></span>
                </div>
                <div class="tenant-field">
                    <label asp-for="Editor.Slug"></label>
                    <input asp-for="Editor.Slug" name="Slug" class="form-control ltr-field" />
                    <span asp-validation-for="Editor.Slug" class="field-validation-error"></span>
                </div>
                <div class="tenant-field">
                    <label asp-for="Editor.DepartmentName"></label>
                    <input asp-for="Editor.DepartmentName" name="DepartmentName" class="form-control" />
                    <span asp-validation-for="Editor.DepartmentName" class="field-validation-error"></span>
                </div>
                <div class="tenant-field">
                    <label asp-for="Editor.SubscriptionStatus"></label>
                    <select asp-for="Editor.SubscriptionStatus" name="SubscriptionStatus" class="form-select">
                        @foreach (var status in Model.Editor.SubscriptionStatusOptions)
                        {
                            <option value="@status">@TenantSubscriptionStatuses.GetDisplayName(status)</option>
                        }
                    </select>
                </div>
                <div class="tenant-field">
                    <label asp-for="Editor.PlanName"></label>
                    <input asp-for="Editor.PlanName" name="PlanName" class="form-control" />
                    <span asp-validation-for="Editor.PlanName" class="field-validation-error"></span>
                </div>
                <div class="tenant-field date-field-shell" data-date-field data-date-display-mode="hijri">
                    <label asp-for="Editor.TrialEndsAtUtc"></label>
                    <div class="date-input-shell">
                        <input asp-for="Editor.TrialEndsAtUtc"
                               asp-format="{0:yyyy-MM-dd}"
                               id="TrialEndsAtUtc"
                               name="TrialEndsAtUtc"
                               type="date"
                               value="@(Model.Editor.TrialEndsAtUtc?.ToString("yyyy-MM-dd"))"
                               class="form-control ltr-field hijri-source-input date-native-hidden"
                               lang="ar-SA"
                               data-hijri-source />
                        <div class="date-inline-preview date-inline-overlay"
                             data-hijri-preview-for="TrialEndsAtUtc"
                             data-empty-text="يوم/شهر/سنة">
                            @(Model.Editor.TrialEndsAtUtc.HasValue ? DateHelper.ToArabicHijri(Model.Editor.TrialEndsAtUtc.Value) : "يوم/شهر/سنة")
                        </div>
                        <label class="date-hijri-toggle" dir="rtl">
                            <span class="date-hijri-toggle-label">التاريخ الهجري</span>
                            <input type="checkbox" checked data-date-hijri-switch />
                            <span class="date-hijri-toggle-track"></span>
                        </label>
                    </div>
                </div>
                <div class="tenant-field date-field-shell" data-date-field data-date-display-mode="hijri">
                    <label asp-for="Editor.SubscriptionEndsAtUtc"></label>
                    <div class="date-input-shell">
                        <input asp-for="Editor.SubscriptionEndsAtUtc"
                               asp-format="{0:yyyy-MM-dd}"
                               id="SubscriptionEndsAtUtc"
                               name="SubscriptionEndsAtUtc"
                               type="date"
                               value="@(Model.Editor.SubscriptionEndsAtUtc?.ToString("yyyy-MM-dd"))"
                               class="form-control ltr-field hijri-source-input date-native-hidden"
                               lang="ar-SA"
                               data-hijri-source />
                        <div class="date-inline-preview date-inline-overlay"
                             data-hijri-preview-for="SubscriptionEndsAtUtc"
                             data-empty-text="يوم/شهر/سنة">
                            @(Model.Editor.SubscriptionEndsAtUtc.HasValue ? DateHelper.ToArabicHijri(Model.Editor.SubscriptionEndsAtUtc.Value) : "يوم/شهر/سنة")
                        </div>
                        <label class="date-hijri-toggle" dir="rtl">
                            <span class="date-hijri-toggle-label">التاريخ الهجري</span>
                            <input type="checkbox" checked data-date-hijri-switch />
                            <span class="date-hijri-toggle-track"></span>
                        </label>
                    </div>
                </div>
            </div>

            <fieldset class="tenant-services-editor" id="tenantServices">
                <legend>
                    <span>الخدمات المتاحة للجهة</span>
                    <small>تتحكم هذه الإعدادات في القوائم والمسارات والوصول المباشر.</small>
                </legend>
                <div class="tenant-services-grid">
                    <label class="tenant-service-option">
                        <input name="PermitsServiceEnabled" type="checkbox" value="true" checked="@Model.Editor.PermitsServiceEnabled" />
                        <input name="PermitsServiceEnabled" type="hidden" value="false" />
                        <span><strong>التصاريح</strong><small>طلبات واعتمادات وتصاريح الموظفين والمركبات.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="VisitsServiceEnabled" type="checkbox" value="true" checked="@Model.Editor.VisitsServiceEnabled" data-tenant-service="visits" />
                        <input name="VisitsServiceEnabled" type="hidden" value="false" />
                        <span><strong>الزيارات</strong><small>تسجيل الزوار والموافقات وسجل الدخول والخروج.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="SelfServiceEnabled" type="checkbox" value="true" checked="@Model.Editor.SelfServiceEnabled" data-tenant-service="self-service" />
                        <input name="SelfServiceEnabled" type="hidden" value="false" />
                        <span><strong>الخدمة الذاتية</strong><small>رابط عام يتيح للزائر إرسال طلبه ومتابعته.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="QueueServiceEnabled" type="checkbox" value="true" checked="@Model.Editor.QueueServiceEnabled" data-tenant-service="queue" />
                        <input name="QueueServiceEnabled" type="hidden" value="false" />
                        <span><strong>تنظيم الطابور <em>تجريبي</em></strong><small>أرقام انتظار ولوحات استدعاء ومتابعة الدور.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="GateServiceEnabled" type="checkbox" value="true" checked="@Model.Editor.GateServiceEnabled" />
                        <input name="GateServiceEnabled" type="hidden" value="false" />
                        <span><strong>البوابات والشاشات</strong><small>مسح QR ومركز البوابة وشاشات العرض المعتمدة.</small></span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="tenant-services-editor">
                <legend>
                    <span>الإشعارات والتنبيهات</span>
                    <small>إعداد مستقل لهذه الجهة ومستخدميها.</small>
                </legend>
                <div class="tenant-services-grid">
                    <label class="tenant-service-option">
                        <input name="NotificationCenterEnabled" type="checkbox" value="true" checked="@Model.Editor.NotificationCenterEnabled" />
                        <input name="NotificationCenterEnabled" type="hidden" value="false" />
                        <span><strong>مركز الإشعارات</strong><small>الجرس وقائمة الإشعارات المقروءة والجديدة.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="PermitNotificationsEnabled" type="checkbox" value="true" checked="@Model.Editor.PermitNotificationsEnabled" />
                        <input name="PermitNotificationsEnabled" type="hidden" value="false" />
                        <span><strong>التصاريح</strong><small>طلبات الاعتماد والحالات التشغيلية.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="VisitNotificationsEnabled" type="checkbox" value="true" checked="@Model.Editor.VisitNotificationsEnabled" />
                        <input name="VisitNotificationsEnabled" type="hidden" value="false" />
                        <span><strong>الزيارات</strong><small>الطلبات المعلقة والزيارات الموقوفة.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="SecurityAlertsEnabled" type="checkbox" value="true" checked="@Model.Editor.SecurityAlertsEnabled" />
                        <input name="SecurityAlertsEnabled" type="hidden" value="false" />
                        <span><strong>التنبيهات الأمنية</strong><small>الحالات التي تتطلب متابعة أمنية.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="FailedOperationAlertsEnabled" type="checkbox" value="true" checked="@Model.Editor.FailedOperationAlertsEnabled" />
                        <input name="FailedOperationAlertsEnabled" type="hidden" value="false" />
                        <span><strong>العمليات الفاشلة</strong><small>تنبيه المسؤول عند فشل إجراء مسجل.</small></span>
                    </label>
                    <label class="tenant-service-option">
                        <input name="UnauthorizedMovementAlertsEnabled" type="checkbox" value="true" checked="@Model.Editor.UnauthorizedMovementAlertsEnabled" />
                        <input name="UnauthorizedMovementAlertsEnabled" type="hidden" value="false" />
                        <span><strong>الحركة غير المصرح بها</strong><small>مخالفات الدخول والخروج عند البوابات.</small></span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="tenant-services-editor">
                <legend>
                    <span>الاحتفاظ بالبيانات</span>
                    <small>تنظيف آلي للسجلات القديمة دون المساس ببيانات التشغيل الفعالة.</small>
                </legend>
                <div class="tenant-form-grid">
                    <div class="tenant-field">
                        <label asp-for="Editor.NotificationRetentionDays"></label>
                        <input class="form-control" asp-for="Editor.NotificationRetentionDays" name="NotificationRetentionDays" min="7" max="730" />
                        <span asp-validation-for="Editor.NotificationRetentionDays" class="text-danger"></span>
                    </div>
                    <div class="tenant-field">
                        <label asp-for="Editor.EmailOutboxRetentionDays"></label>
                        <input class="form-control" asp-for="Editor.EmailOutboxRetentionDays" name="EmailOutboxRetentionDays" min="7" max="365" />
                        <span asp-validation-for="Editor.EmailOutboxRetentionDays" class="text-danger"></span>
                    </div>
                    <div class="tenant-field">
                        <label asp-for="Editor.AuditLogRetentionDays"></label>
                        <input class="form-control" asp-for="Editor.AuditLogRetentionDays" name="AuditLogRetentionDays" min="90" max="2555" />
                        <span asp-validation-for="Editor.AuditLogRetentionDays" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <div class="tenant-form-actions">
                @if (isEditMode)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                }
                <button type="submit" class="btn btn-primary">@(isEditMode ? "حفظ التعديل" : "إضافة الجهة")</button>
            </div>
        </form>
    </details>

    <section class="tenant-registry" aria-labelledby="tenantRegistryTitle">
        <div class="tenant-registry-head">
            <div>
                <span class="tenants-kicker">السجل</span>
                <h2 id="tenantRegistryTitle">الجهات المسجلة</h2>
            </div>
            <div class="tenant-registry-tools">
                <label class="tenant-search">
                    <span class="visually-hidden">بحث في الجهات</span>
                    <input id="tenantSearch" type="search" class="form-control" placeholder="بحث بالاسم أو المعرف" autocomplete="off" />
                </label>
                <label>
                    <span class="visually-hidden">تصفية حسب الحالة</span>
                    <select id="tenantStateFilter" class="form-select">
                        <option value="all">كل الحالات</option>
                        <option value="active">النشطة</option>
                        <option value="inactive">الموقوفة</option>
                    </select>
                </label>
                <span class="tenant-visible-count"><strong id="tenantVisibleCount">@Model.Tenants.Count</strong> جهة</span>
            </div>
        </div>

        <div class="tenant-table-wrap">
            <table class="tenant-table">
                <colgroup>
                    <col class="tenant-col-identity" />
                    <col class="tenant-col-subscription" />
                    <col class="tenant-col-usage" />
                    <col class="tenant-col-access" />
                    <col class="tenant-col-state" />
                    <col class="tenant-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>الجهة</th>
                        <th>الاشتراك</th>
                        <th>الاستخدام</th>
                        <th>الوصول</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in Model.Tenants)
                    {
                        var isDefault = string.Equals(tenant.TenantId, TenantDefaults.DefaultTenantId, StringComparison.OrdinalIgnoreCase);
                        var searchValue = $"{tenant.Name} {tenant.OrganizationName} {tenant.TenantId} {tenant.Slug}".ToLowerInvariant();
                        <tr data-tenant-row data-search="@searchValue" data-state="@(tenant.IsActive ? "active" : "inactive")">
                            <td data-label="الجهة">
                                <div class="tenant-identity">
                                    <strong>@tenant.Name</strong>
                                    <span>@(string.IsNullOrWhiteSpace(tenant.OrganizationName) ? "بدون اسم تشغيلي" : tenant.OrganizationName)</span>
                                    <code>@tenant.TenantId</code>
                                </div>
                            </td>
                            <td data-label="الاشتراك">
                                <div class="tenant-cell-stack">
                                    <span class="tenant-subscription @GetSubscriptionClass(tenant.SubscriptionStatus)">@tenant.SubscriptionStatusDisplayName</span>
                                    <strong class="tenant-plan">@tenant.PlanName</strong>
                                    <span class="tenant-services-count">@tenant.EnabledServiceCount من 5 خدمات مفعلة</span>
                                    @if (tenant.SubscriptionEndsAtUtc.HasValue)
                                    {
                                        <span class="tenant-date">حتى @tenant.SubscriptionEndsAtUtc.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                </div>
                            </td>
                            <td data-label="الاستخدام">
                                <div class="tenant-usage">
                                    <span><strong>@tenant.UserCount</strong> حساب</span>
                                    <span><strong>@tenant.PermitCount</strong> تصريح</span>
                                    <span><strong>@tenant.VisitCount</strong> زيارة</span>
                                </div>
                            </td>
                            <td data-label="الوصول">
                                <div class="tenant-cell-stack">
                                    <a asp-controller="Account"
                                       asp-action="TenantEntry"
                                       asp-route-tenant="@tenant.Slug"
                                       class="tenant-entry-link"
                                       target="_blank"
                                       rel="noopener">فتح صفحة الدخول</a>
                                    <code>/o/@tenant.Slug</code>
                                </div>
                            </td>
                            <td data-label="الحالة">
                                <div class="tenant-cell-stack">
                                    <span class="tenant-state @(tenant.IsActive ? "is-active" : "is-inactive")">
                                        @(tenant.IsActive ? "نشطة" : "موقوفة")
                                    </span>
                                    <small>@(tenant.IsActive ? "الحسابات متاحة" : "الحسابات محجوبة")</small>
                                </div>
                            </td>
                            <td data-label="الإجراءات">
                                <div class="tenant-actions">
                                    <a asp-action="Index" asp-route-edit="@tenant.TenantId" class="btn btn-outline-primary btn-sm">تعديل</a>
                                    @if (string.Equals(tenant.SubscriptionStatus, TenantSubscriptionStatuses.PendingPayment, StringComparison.Ordinal))
                                    {
                                        <form asp-action="ActivatePayment" asp-route-id="@tenant.TenantId" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm">تأكيد الدفع</button>
                                        </form>
                                    }
                                    @if (!isDefault)
                                    {
                                        <form asp-action="SetActive" asp-route-id="@tenant.TenantId" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="isActive" value="@(!tenant.IsActive)" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                @(tenant.IsActive ? "إيقاف" : "تفعيل")
                                            </button>
                                        </form>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                data-delete-tenant
                                                data-tenant-id="@tenant.TenantId"
                                                data-tenant-name="@tenant.Name"
                                                disabled="@tenant.IsActive"
                                                title="@(tenant.IsActive ? "أوقف الجهة قبل حذفها" : "حذف الجهة نهائياً")">
                                            حذف
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="tenant-empty-state" id="tenantEmptyState" hidden>لا توجد جهات مطابقة.</div>
        </div>

        <div class="tenant-pagination-shell" id="tenantPaginationShell" hidden>
            <span class="tenant-pagination-info" id="tenantPageInfo"></span>
            <div class="tenant-pagination" id="tenantPagination" aria-label="صفحات الجهات"></div>
            <div class="tenant-pagination-nav">
                <button type="button" class="tenant-page-button tenant-page-nav" id="tenantPagePrev"
                        aria-label="الصفحة السابقة" title="الصفحة السابقة">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <button type="button" class="tenant-page-button tenant-page-nav" id="tenantPageNext"
                        aria-label="الصفحة التالية" title="الصفحة التالية">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                </button>
            </div>
        </div>
    </section>
</div>

<dialog class="tenant-delete-dialog" id="tenantDeleteDialog">
    <form asp-action="Delete" method="post" id="tenantDeleteForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="deleteTenantId" />
        <div class="tenant-delete-head">
            <span>حذف نهائي</span>
            <button type="button" class="tenant-dialog-close" data-close-delete-dialog aria-label="إغلاق">×</button>
        </div>
        <h2>حذف <span id="deleteTenantName"></span>؟</h2>
        <p>سيتم حذف الحسابات والتصاريح والزيارات والإعدادات نهائياً.</p>
        <label for="deleteTenantConfirmation">اكتب اسم الجهة للتأكيد</label>
        <input type="text" class="form-control" name="confirmationName" id="deleteTenantConfirmation" autocomplete="off" />
        <div class="tenant-delete-actions">
            <button type="button" class="btn btn-outline-secondary" data-close-delete-dialog>إلغاء</button>
            <button type="submit" class="btn btn-danger" id="confirmTenantDelete" disabled>حذف نهائي</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(Context.Items["CspScriptNonce"])">
        (() => {
            const editor = document.getElementById('tenantEditor');
            if (editor?.dataset.forceOpen === 'true') editor.open = true;
            document.querySelector('[data-open-tenant-editor]')?.addEventListener('click', () => {
                if (!editor) return;
                editor.open = true;
                editor.scrollIntoView({ behavior: 'smooth', block: 'start' });
                window.setTimeout(() => editor.querySelector('input:not([readonly])')?.focus(), 350);
            });

            const visitsService = document.querySelector('[data-tenant-service="visits"]');
            const selfService = document.querySelector('[data-tenant-service="self-service"]');
            const queueService = document.querySelector('[data-tenant-service="queue"]');
            const syncServiceDependencies = () => {
                if (!visitsService?.checked) {
                    if (selfService) selfService.checked = false;
                    if (queueService) queueService.checked = false;
                }
                if (!selfService?.checked && queueService) queueService.checked = false;
                if (selfService) selfService.disabled = !visitsService?.checked;
                if (queueService) queueService.disabled = !visitsService?.checked || !selfService?.checked;
                selfService?.closest('.tenant-service-option')?.classList.toggle('is-disabled', selfService.disabled);
                queueService?.closest('.tenant-service-option')?.classList.toggle('is-disabled', queueService.disabled);
            };
            visitsService?.addEventListener('change', syncServiceDependencies);
            selfService?.addEventListener('change', syncServiceDependencies);
            syncServiceDependencies();

            const search = document.getElementById('tenantSearch');
            const stateFilter = document.getElementById('tenantStateFilter');
            const rows = Array.from(document.querySelectorAll('[data-tenant-row]'));
            const visibleCount = document.getElementById('tenantVisibleCount');
            const emptyState = document.getElementById('tenantEmptyState');
            const paginationShell = document.getElementById('tenantPaginationShell');
            const pagination = document.getElementById('tenantPagination');
            const pageInfo = document.getElementById('tenantPageInfo');
            const previousPage = document.getElementById('tenantPagePrev');
            const nextPage = document.getElementById('tenantPageNext');
            const pageSize = 10;
            let currentPage = 1;
            let currentTotalPages = 1;

            const createPageButton = (pageNumber) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = `tenant-page-button${pageNumber === currentPage ? ' is-active' : ''}`;
                button.textContent = String(pageNumber);
                button.setAttribute('aria-label', `الانتقال إلى الصفحة ${pageNumber}`);
                if (pageNumber === currentPage) button.setAttribute('aria-current', 'page');
                button.addEventListener('click', () => {
                    currentPage = pageNumber;
                    applyFilters(false);
                });
                return button;
            };

            const createEllipsis = () => {
                const ellipsis = document.createElement('span');
                ellipsis.className = 'tenant-pagination-ellipsis';
                ellipsis.textContent = '...';
                return ellipsis;
            };

            const renderPagination = (totalPages, totalMatches, startIndex, endIndex) => {
                if (!pagination || !paginationShell) return;
                pagination.innerHTML = '';

                if (pageInfo) {
                    pageInfo.textContent = totalMatches === 0
                        ? 'لا توجد نتائج مطابقة'
                        : `عرض ${startIndex + 1}-${Math.min(endIndex, totalMatches)} من ${totalMatches} • صفحة ${currentPage} من ${totalPages}`;
                }

                if (previousPage) previousPage.disabled = currentPage <= 1 || totalMatches === 0;
                if (nextPage) nextPage.disabled = currentPage >= totalPages || totalMatches === 0;

                if (totalPages <= 1) {
                    paginationShell.hidden = true;
                    return;
                }

                paginationShell.hidden = false;
                let firstPage = Math.max(1, currentPage - 2);
                let lastPage = Math.min(totalPages, firstPage + 4);
                firstPage = Math.max(1, lastPage - 4);

                if (firstPage > 1) {
                    pagination.appendChild(createPageButton(1));
                    if (firstPage > 2) pagination.appendChild(createEllipsis());
                }

                for (let pageNumber = firstPage; pageNumber <= lastPage; pageNumber += 1) {
                    pagination.appendChild(createPageButton(pageNumber));
                }

                if (lastPage < totalPages) {
                    if (lastPage < totalPages - 1) pagination.appendChild(createEllipsis());
                    pagination.appendChild(createPageButton(totalPages));
                }
            };

            const applyFilters = (resetPage = false) => {
                const query = (search?.value || '').trim().toLowerCase();
                const state = stateFilter?.value || 'all';
                const matchingRows = rows.filter((row) => {
                    const matchesSearch = !query || (row.dataset.search || '').includes(query);
                    const matchesState = state === 'all' || row.dataset.state === state;
                    return matchesSearch && matchesState;
                });
                const totalMatches = matchingRows.length;
                const totalPages = Math.max(1, Math.ceil(totalMatches / pageSize));
                currentTotalPages = totalPages;

                if (resetPage) currentPage = 1;
                currentPage = Math.min(currentPage, totalPages);

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;
                rows.forEach((row) => {
                    row.hidden = true;
                });
                matchingRows.forEach((row, index) => {
                    row.hidden = index < startIndex || index >= endIndex;
                });

                if (visibleCount) visibleCount.textContent = String(totalMatches);
                if (emptyState) emptyState.hidden = totalMatches !== 0;
                renderPagination(totalPages, totalMatches, startIndex, endIndex);
            };
            search?.addEventListener('input', () => applyFilters(true));
            stateFilter?.addEventListener('change', () => applyFilters(true));
            previousPage?.addEventListener('click', () => {
                if (currentPage <= 1) return;
                currentPage -= 1;
                applyFilters(false);
            });
            nextPage?.addEventListener('click', () => {
                if (currentPage >= currentTotalPages) return;
                currentPage += 1;
                applyFilters(false);
            });
            applyFilters(true);

            const dialog = document.getElementById('tenantDeleteDialog');
            const deleteId = document.getElementById('deleteTenantId');
            const deleteName = document.getElementById('deleteTenantName');
            const confirmation = document.getElementById('deleteTenantConfirmation');
            const confirmButton = document.getElementById('confirmTenantDelete');
            let expectedName = '';

            document.querySelectorAll('[data-delete-tenant]').forEach((button) => {
                button.addEventListener('click', () => {
                    expectedName = button.dataset.tenantName || '';
                    if (deleteId) deleteId.value = button.dataset.tenantId || '';
                    if (deleteName) deleteName.textContent = expectedName;
                    if (confirmation) confirmation.value = '';
                    if (confirmButton) confirmButton.disabled = true;
                    dialog?.showModal();
                    confirmation?.focus();
                });
            });
            confirmation?.addEventListener('input', () => {
                if (confirmButton) confirmButton.disabled = confirmation.value.trim() !== expectedName;
            });
            document.querySelectorAll('[data-close-delete-dialog]').forEach((button) => {
                button.addEventListener('click', () => dialog?.close());
            });
            dialog?.addEventListener('click', (event) => {
                if (event.target === dialog) dialog.close();
            });
        })();
    </script>
}
